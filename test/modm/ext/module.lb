def init(module):
    module.name = ":test:ext"
    module.description = "Tests for External Code"


def prepare(module, options):
    module.depends("modm:ext:stdc++")
    return True


def build(env):
    env.outbasepath = "modm-test/src/modm-test/ext"
    # Only Cortex-M uses newlib, the other targets have no or a native wchar_t
    is_cortex_m = env[":target"].get_driver("core")["type"].startswith("cortex-m")
    env.copy('.', ignore=env.ignore_files("wchar_test.*") if not is_cortex_m else None)
