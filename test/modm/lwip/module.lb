def init(module):
    module.name = ":test:lwip"
    module.description = "Tests for the lwIP Ethernet adapter"


def prepare(module, options):
    if options[":target"].identifier.platform != "hosted":
        return False

    module.depends(":communication:lwip_ethernet", ":mock:clock")
    return True


def build(env):
    env.outbasepath = "modm-test/src/modm-test/lwip"
    env.copy("lwip_ethernet_test.hpp")
    env.copy("lwip_ethernet_test.cpp")
