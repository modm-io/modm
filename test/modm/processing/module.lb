def init(module):
    module.name = ":test:processing"
    module.description = "Tests for Processing"


def prepare(module, options):
    module.depends(
        "modm:architecture",
        "modm:io",
        "modm:math:utils",
        "modm:math:filter",
        "modm:processing:fiber",
        "modm:processing:protothread",
        "modm:processing:resumable",
        "modm:processing:timer",
        "modm:processing:scheduler",
        ":mock:clock")
    return True


def build(env):
    env.outbasepath = "modm-test/src/modm-test/processing"
    is_hosted = env[":target"].identifier.platform == "hosted"
    env.copy("fiber", ignore=None if is_hosted else env.ignore_files("fiber_thread_test.*"))
    env.copy("scheduler")
    env.copy("timer")
    if not env.get("modm:processing:protothread:use_fiber", True):
        env.copy("protothread")
        env.copy("resumable")
