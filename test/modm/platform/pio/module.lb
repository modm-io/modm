from collections import defaultdict, OrderedDict


def init(module):
    module.name = ":test:platform:pio"
    module.description = "Tests for RP PIO"

def prepare(module, options):
    target = options[":target"]
    if target.identifier.platform != "rp":
        return False

    module.depends(":platform:pio")
    return True

def build(env):
   
    device = env[":target"]
    identifier = device.identifier
   
    env.outbasepath = "modm-test/src/modm-test/platform/pio"
    env.copy("platform_pio_test_rp.cpp")
