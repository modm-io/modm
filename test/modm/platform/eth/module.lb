def init(module):
    module.name = ":test:platform:eth"
    module.description = "Tests for common Ethernet DMA and PHY support"


def prepare(module, options):
    if not options[":target"].identifier.platform.startswith("hosted"):
        return False
    module.depends(
        "modm:driver:lan8720a",
        "modm:driver:lan8742a",
        "modm:platform:eth.common")
    return True


def build(env):
    env.outbasepath = "modm-test/src/modm-test/platform/eth"
    env.copy("eth_test.hpp")
    env.copy("eth_test.cpp")
