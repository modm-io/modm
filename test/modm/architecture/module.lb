class Fiber(Module):
    def init(self, module):
        module.name = "fiber"
        module.description = "Tests for Fiber Synchronization outside of Fibers"

    def prepare(self, module, options):
        module.depends("modm:architecture:fiber")
        return True

    def build(self, env):
        env.outbasepath = "modm-test/src/modm-test/architecture"
        env.copy("fiber")


def init(module):
    module.name = ":test:architecture"
    module.description = "Tests for Architecture Interfaces"


def prepare(module, options):
    module.add_submodule(Fiber())
    module.depends(
        ":mock:clock",
        "modm:architecture:accessor",
        "modm:architecture:atomic",
        "modm:architecture:can",
        "modm:architecture:clock",
        "modm:architecture:i2c",
        "modm:architecture:register",
        ":mock:io.device",
    )
    return True


def build(env):
    env.outbasepath = "modm-test/src/modm-test/architecture"
    env.copy('.', ignore=env.ignore_paths("*fiber/*"))

