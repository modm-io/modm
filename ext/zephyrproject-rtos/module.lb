def init(module):
    module.name = ":zephyr-heap"
    module.description = FileReader("module.md")

def prepare(module, options):
    module.depends(":architecture:assert")
    return options[":target"].has_driver("core:cortex-m*")

def build(env):
    env.collect(":build:path.include", "modm/ext")
    env.outbasepath = "modm/ext/zephyr-heap"
    env.copy("heap/LICENSE", "LICENSE")
    for header in ("heap.h", "sys_heap.h", "zephyr_port.h"):
        env.copy("heap/heap/" + header, header)
    # compiled through heap.c, which maps the assertions to modm
    env.copy("heap/heap/heap.c", "heap.c.inc")
    env.copy("heap.c")
