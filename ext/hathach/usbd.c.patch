+      uint8_t const *desc_bos = tud_descriptor_bos_cb();
+      TU_VERIFY(desc_bos != NULL);
 
       // Use offsetof to avoid pointer to the odd/misaligned address
-      uint16_t const total_len = tu_le16toh( tu_unaligned_read16((const void*) (desc_bos + offsetof(tusb_desc_bos_t, wTotalLength))) );
+      uint16_t const total_len = tu_le16toh( tu_unaligned_read16(desc_bos + offsetof(tusb_desc_bos_t, wTotalLength)) );
 
-      return tud_control_xfer(rhport, p_request, (void*) desc_bos, total_len);
+      return tud_control_xfer(rhport, p_request, (void*)(uintptr_t) desc_bos, total_len);
     }
     // break; // unreachable
 
     case TUSB_DESC_CONFIGURATION:
     case TUSB_DESC_OTHER_SPEED_CONFIG: {
-      uintptr_t desc_config;
+      uint8_t const *desc_config;
 
