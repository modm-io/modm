-        desc_config = (uintptr_t) tud_descriptor_configuration_cb(desc_index);
-        TU_ASSERT(desc_config != 0);
+        desc_config = tud_descriptor_configuration_cb(desc_index);
+        TU_ASSERT(desc_config != NULL);
       }else {
