def init(module):
    module.name = ":ext:libcanard"
    module.description = FileReader("libcanard.md")

def prepare(module, options):
    module.depends(
        ":architecture:assert",
        ":architecture:can",
        ":architecture:clock",
        ":ext:o1heap")
    # too large for AVR
    return not options[":target"].has_driver("core:avr*")

def build(env):
    env.collect(":build:path.include", "modm/ext/canard")
    env.outbasepath = "modm/ext/canard"
    env.copy("cyphal/libcanard/LICENSE", "LICENSE")
    env.copy("cyphal/libcanard/libcanard/canard.h", "canard.h")
    env.copy("cyphal/libcanard/lib/cavl2/cavl2.h", "cavl2.h")
    # compiled through canard.c, which maps the assertions to modm
    # newlib has no <stdbit.h> yet, which libcanard only needs for an optimization
    env.copy("cyphal/libcanard/libcanard/canard.c", "canard.c.inc", patch="libcanard_stdbit.patch")
    env.copy("canard.c")
    # modm::canard::Node connects libcanard to the modm CAN drivers
    env.copy("canard.hpp")
    # parameters of the DroneCAN and Cyphal nodes, with an optional ZMS storage
    env.copy("parameter.hpp")
    if env.has_module(":ext:zms"):
        env.copy("parameter_zms.hpp")
