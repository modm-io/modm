def init(module):
    module.name = ":ext:nunavut"
    module.description = FileReader("nunavut.md")

def prepare(module, options):
    module.add_set_option(
        PathOption(name="sources", absolute=True, empty_ok=True,
                   description="Root namespace folders of your own DSDL types."),
        default="")
    module.add_option(
        PathOption(name="path", default="generated/nunavut", absolute=True,
                   description="Path to the generated headers"))
    return True

def build(env):
    env.outbasepath = "modm/ext/dsdl"
    env.copy("cyphal/public_regulated_data_types/uavcan", "uavcan")
    env.copy("cyphal/public_regulated_data_types/reg", "reg")
    env.copy("cyphal/public_regulated_data_types/LICENSE", "LICENSE")
