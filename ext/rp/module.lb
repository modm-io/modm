import os

def init(module):
    module.name = ":ext:cmsis:device"

def prepare(module, options):
    device = options[":target"]
    if not device.identifier["platform"] == "rp":
        return False

    module.depends(":ext:cmsis:core")
    return True

def build(env):
    # The CMSIS header redefines the register base addresses of hardware/regs
    env.collect(":build:path.include.system", "modm/ext/cmsis_device")

    device = env[":target"]

    env.outbasepath = "modm/ext/cmsis_device"

    chip = "rp2040" if device.identifier.family == "20" else "rp2350"
    defines = []
    headers = [chip.upper() + ".h"]
    # The pico-sdk headers select the package by these defines
    env.collect(":build:cppdefines", "PICO_{}=1".format(chip.upper()))
    if chip == "rp2350":
        env.collect(":build:cppdefines", "PICO_RP2350A={}".format(int(device.identifier.package == "a")))

    env.copy("pico-sdk/" + chip, "")
    env.copy("address_mapped.h", "hardware/address_mapped.h")

    if env.has_module(":ext:tinyusb"):
        env.substitutions = {
            "with_debug": env.has_module(":debug"),
            "with_multicore": env.has_module(":platform:multicore"),
            "family": device.identifier.family,
        }
        env.copy("pico.h")
        env.template("pico.cpp.in", "pico.cpp")
        env.copy("irq.h", "hardware/irq.h")
        env.copy("timer.h", "hardware/timer.h")
        env.copy("resets.h", "hardware/resets.h")
        env.copy("sync.h", "hardware/sync.h")
        env.copy("critical_section.h", "pico/critical_section.h")

    env.substitutions = {
        "headers": headers,
        "defines": defines,
    }
    env.outbasepath = "modm/src/modm/platform"
    env.template("device.hpp.in")


