def init(module):
    module.name = ":o1heap"
    module.description = FileReader("module.md")

def prepare(module, options):
    module.depends(":architecture:assert")
    return options[":target"].has_driver("core:cortex-m*")

def build(env):
    env.collect(":build:path.include", "modm/ext")
    env.outbasepath = "modm/ext/o1heap"
    env.copy("o1heap/LICENSE", "LICENSE")
    env.copy("o1heap/o1heap/o1heap.h", "o1heap.h")
    # compiled through o1heap.c, which maps the assertions to modm
    env.copy("o1heap/o1heap/o1heap.c", "o1heap.c.inc")
    env.copy("o1heap.c")
