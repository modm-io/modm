def init(module):
    module.name = ":communication:xpcc:generator"
    module.description = """\
# XPCC Generator

Translates the XPCC XML declarations into C++ code. See the SCons build script
generator documentation for how the generated sources are integrated.

!!! warning "Deprecated"
    XPCC moved into the [modm-io/xpcc](https://github.com/modm-io/xpcc)
    repository and this module will be removed in the 2027q4 release!
    Add the xpcc repository to your project and use the `xpcc:generator` module
    instead, see its README for how to migrate. For new projects please use a
    modern CAN protocol like DroneCAN.
"""

def prepare(module, options):
    module.add_option(
        PathOption(name="source", default="", empty_ok=True, absolute=True,
                   description="Path to the XPCC source file"))
    module.add_option(
        StringOption(name="container", default="",
                     description="Name of the XPCC container to generate for"))
    module.add_option(
        PathOption(name="path", default="generated/xpcc", absolute=True,
                   description="Path to the XPCC generated folder"))
    module.add_option(
        StringOption(name="namespace", default="robot",
                     description="Namespace of the generated XPCC communications"))

    return True

def build(env):
    # DEPRECATED: 2027q4
    env.log.warning("The 'modm:communication:xpcc:generator' module is deprecated and will be removed in 2027q4! "
                    "XPCC moved to https://github.com/modm-io/xpcc, please add it to your "
                    "repositories and use the 'xpcc:generator' module instead.")
    env.outbasepath = "modm/tools/xpcc_generator"
    env.copy(".")
