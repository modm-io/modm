{
    "version": "0.2.0",
    "configurations": [
%% for config in configs
        {
            "name": "Debug ({{ config.profile | capitalize }}, {{ config.tool | capitalize }}, {{ partname }})",
            "cwd": "${workspaceFolder}",
            "executable": "{{ config.executable }}",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "device": "{{ partname }}",
            "runToEntryPoint": "main",
    %% if configs
            "preLaunchTask": "Build ({{ config.label }})",
    %% endif
    %% if arm_toolchain_path
            "armToolchainPath": "{{ arm_toolchain_path }}",
    %% endif
    %% if with_freertos
            "rtos": "FreeRTOS",
    %% endif
            "configFiles": [
    %% for cfg in openocd_cfg
                "{{ cfg }}"{{ "," if not loop.last }}
    %% endfor
            ]{{ "," if with_rtt }}
    %% if with_rtt
            "rttConfig": {
                "enabled": true,
                "address": "0x{{"%0x" % rtt_ram.start}}",
                "searchSize": {{ rtt_ram.size }},
                "searchId": "SEGGER RTT",
                "polling_interval": 1,
                "decoders": [
        %% for id in rtt_channels
                    {
                        "port": {{id}},
                        "type": "console"
                    }{{ "," if not loop.last }}
        %% endfor
                ]
            }
    %% endif
        }{{ "," if not loop.last }}
%% endfor
    ]
}
