{
    "version": "2.0.0",
    "tasks": [
%% for config in configs
        {
            "type": "shell",
            "label": "Build ({{ config.label }})",
            "detail": "{{ config.tool }} build profile={{ config.profile }}",
            "command": "{{ config.tool }} build profile={{ config.profile }}",
            "group": {"kind": "build", "isDefault": {{ "true" if loop.first else "false" }}},
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false
            },
            "problemMatcher": "$gcc"
        },
%% endfor
%% for config in configs
        {
            "type": "shell",
            "label": "Upload ({{ config.label }})",
            "detail": "{{ config.tool }} program profile={{ config.profile }}",
            "command": "{{ config.tool }} program profile={{ config.profile }}",
            "dependsOn": ["Build ({{ config.label }})"],
            "dependsOrder": "sequence",
            "group": "none",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false
            }
        },
%% endfor
%% for config in configs
        {
            "type": "shell",
            "label": "Clean ({{ config.label }})",
            "detail": "{{ config.tool }} {{ config.clean }} profile={{ config.profile }}",
            "command": "{{ config.tool }} {{ config.clean }} profile={{ config.profile }}",
            "group": "none",
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true,
                "showReuseMessage": false
            },
            "problemMatcher": "$gcc"
        }{{ "," if not loop.last }}
%% endfor
    ]
}
