def init(module):
    module.name = ":communication:lwip_ethernet"
    module.description = """
# lwIP Ethernet Adapter

Connects a Clause 22 PHY and an Ethernet MAC to one lwIP netif.
The adapter owns initialization order, link synchronization, frame transfer,
checksum fallback, and lwIP receive statistics.
"""

def prepare(module, options):
    module.depends(":architecture:ethernet", ":lwip", ":stdc++")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/communication/lwip_ethernet"
    env.copy("lwip_ethernet.hpp")
