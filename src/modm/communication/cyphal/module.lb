def init(module):
    module.name = ":communication:cyphal"
    module.description = FileReader("module.md")

def prepare(module, options):
    module.depends(":ext:libcanard", ":ext:nunavut")
    # too large for AVR
    return not options[":target"].has_driver("core:avr*")

def build(env):
    env.outbasepath = "modm/src/modm/communication"
    env.copy("../cyphal.hpp", "cyphal.hpp")
    env.copy("node.hpp", "cyphal/node.hpp")
