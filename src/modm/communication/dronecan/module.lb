# The data types of the services that modm::dronecan::Node implements
TYPES = [
    "uavcan.protocol.NodeStatus",
    "uavcan.protocol.GetNodeInfo",
    "uavcan.protocol.RestartNode",
    "uavcan.protocol.param.GetSet",
    "uavcan.protocol.param.ExecuteOpcode",
    "uavcan.protocol.dynamic_node_id.Allocation",
]

def init(module):
    module.name = ":communication:dronecan"
    module.description = FileReader("module.md")

def prepare(module, options):
    module.depends(":ext:libcanard", ":ext:dronecan", ":architecture:fiber")
    # too large for AVR
    return not options[":target"].has_driver("core:avr*")

def build(env):
    env.collect(":ext:dronecan:type", *TYPES)
    env.outbasepath = "modm/src/modm/communication"
    env.copy("../dronecan.hpp", "dronecan.hpp")
    env.copy("node.hpp", "dronecan/node.hpp")
    env.copy("client.hpp", "dronecan/client.hpp")
