def init(module):
    module.name = ":board:weact-g0b1cb"
    module.description = """
# WeAct Studio STM32G0B1CB Core Board

[Documentation](https://github.com/WeActStudio/WeActStudio.STM32G0B1CoreBoard)

Cheap and bread-board-friendly board for the STM32G0B1 series.

## Programming

Since the board has no St-Link programmer on the board,
you must use DFU (Device Firmware Update (via USB)) to program the board.
A DFU command is integrated into the `modm:build:scons` tool:

```
scons program-dfu
```
"""

def prepare(module, options):
    if not options[":target"].partname.startswith("stm32g0b1cbt"):
        return False

    module.depends(
        ":architecture:clock",
        ":platform:clock",
        ":platform:core",
        ":platform:gpio",
        ":platform:usb")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/board"
    env.substitutions = {
        "with_logger": False,
        "with_assert": env.has_module(":architecture:assert")
    }
    env.template("../board.cpp.in", "board.cpp")
    env.copy('.')

    env.outbasepath = "modm/openocd/modm/board/"
    env.template(repopath("tools/openocd/modm/stm32_swd.cfg.in"), "board.cfg",
                 substitutions={"target": "stm32g0x"})
    env.collect(":build:openocd.source", "modm/board/board.cfg")
