def init(module):
    module.name = ":board:nucleo-h7s3l8"
    module.description = """\
# NUCLEO-H7S3L8

[Nucleo kit for STM32H7S3L8](https://www.st.com/en/evaluation-tools/nucleo-h7s3l8.html)

The core is clocked at 600 MHz from the 24 MHz HSE crystal, the bus matrix at
300 MHz. The core is supplied by the LDO, configured in `init_ldo.cpp` before
the RAM is initialized: with the direct SMPS supply the board locks up after
the next power-on.

## TinyUSB

The USB Type-C connector is connected to the OTG_HS port with the internal HS
PHY, so you must configure TinyUSB to use the HS port:

```xml
<option name="modm:tinyusb:device:port">hs</option>
```
"""

def prepare(module, options):
    if not options[":target"].partname.startswith("stm32h7s3l8h"):
        return False

    module.depends(
        ":debug",
        ":architecture:clock",
        ":platform:core",
        ":platform:gpio",
        ":platform:i2c:1",
        ":platform:spi:1",
        ":platform:clock",
        ":platform:uart:3",
        ":platform:usb:hs")

    return True

def build(env):
    env.outbasepath = "modm/src/modm/board"
    env.substitutions = {
        "with_logger": True,
        "with_assert": env.has_module(":architecture:assert")
    }
    env.template("../board.cpp.in", "board.cpp")
    env.copy('.')
    env.copy("../init_ldo.cpp", "init_ldo.cpp")

    env.outbasepath = "modm/openocd/modm/board/"
    env.template(repopath("tools/openocd/modm/st_nucleo_swd.cfg.in"), "board.cfg",
                 substitutions={"target": "stm32h7rsx"})
    env.collect(":build:openocd.source", "modm/board/board.cfg")
