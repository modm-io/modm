def init(module):
    module.name = ":board:nucleo-u5a5zj-q"
    module.description = """\
# NUCLEO-U5A5ZJ-Q

[Nucleo kit for STM32U5A5ZJ-Q](https://www.st.com/en/evaluation-tools/nucleo-u5a5zj-q.html)
"""

def prepare(module, options):
    if not options[":target"].partname.startswith("stm32u5a5zjt6q"):
        return False

    module.depends(
        ":debug",
        ":architecture:clock",
        ":platform:core",
        ":platform:gpio",
        ":platform:i2c:1",
        ":platform:clock",
        ":platform:uart:1",
        ":platform:usb:hs")

    return True

def build(env):
    env.outbasepath = "modm/src/modm/board"
    env.substitutions = {
        "with_logger": True,
        "with_assert": env.has_module(":architecture:assert")
    }
    env.template("../board.cpp.in", "board.cpp")
    env.copy('.')
    env.copy("../nucleo144_arduino_u5.hpp", "nucleo144_arduino_u5.hpp")

    env.outbasepath = "modm/openocd/modm/board/"
    env.template(repopath("tools/openocd/modm/st_nucleo_swd.cfg.in"), "board.cfg",
                 substitutions={"target": "stm32u5x"})
    env.collect(":build:openocd.source", "modm/board/board.cfg")
