def init(module):
    module.name = ":board:weact-g030f6"
    module.description = """\
# WeAct Studio STM32G030F6 Core Board

[Documentation](https://github.com/WeActStudio/WeActStudio.STM32G0xxC0xxCoreBoard)

This board has no serial port and logs via RTT instead.
"""

def prepare(module, options):
    if not options[":target"].partname.startswith("stm32g030f6p"):
        return False

    module.depends(
        ":architecture:clock",
        ":debug",
        ":platform:clock",
        ":platform:core",
        ":platform:gpio",
        ":platform:rtt")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/board"
    env.substitutions = {
        "with_logger": True,
        "with_assert": env.has_module(":architecture:assert")
    }
    env.template("../board.cpp.in", "board.cpp")
    env.copy('.')

    env.outbasepath = "modm/openocd/modm/board/"
    env.template(repopath("tools/openocd/modm/stm32_swd.cfg.in"), "board.cfg",
                 substitutions={"target": "stm32g0x"})
    env.collect(":build:openocd.source", "modm/board/board.cfg")
