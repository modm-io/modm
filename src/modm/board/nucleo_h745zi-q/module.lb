def init(module):
    module.name = ":board:nucleo-h745zi-q"
    module.description = """
# NUCLEO-H745ZI-Q

[Nucleo kit for STM32H745ZI-Q](https://www.st.com/en/evaluation-tools/nucleo-h745zi-q.html)

The dual-core STM32H745 needs one project per core. This configuration builds
the Cortex-M7 project, the Cortex-M4 project overwrites the target:

```xml
<library>
  <extends>modm:nucleo-h745zi-q</extends>
  <options>
    <option name="modm:target">stm32h745zit6@m4</option>
  </options>
</library>
```

The Cortex-M7 configures the system clock in `Board::initialize()` and must
then call `modm::platform::dualcore::start()`, which lets the Cortex-M4
continue from its `Board::initialize()`. See `modm:platform:dualcore` for the
shared memory between both cores.

The board is wired for the direct SMPS supply, which does not allow the
voltage scale 0, so the Cortex-M7 runs at 400 MHz and the Cortex-M4 at 200 MHz.
Only the Cortex-M7 has a logger on the ST-LINK virtual COM port.
"""

def prepare(module, options):
    if not options[":target"].partname.startswith("stm32h745zit"):
        return False

    module.depends(
        ":architecture:clock",
        ":platform:core",
        ":platform:dualcore",
        ":platform:gpio",
        ":platform:clock")
    if options[":target"].identifier.core == "m7":
        module.depends(":debug", ":platform:uart:3")

    return True

def build(env):
    core = env[":target"].identifier.core
    env.outbasepath = "modm/src/modm/board"
    env.substitutions = {
        "core": core,
        "with_logger": core == "m7",
        "with_assert": env.has_module(":architecture:assert"),
    }
    env.template("../board.cpp.in", "board.cpp")
    env.template("board.hpp.in")
    if core == "m7":
        env.copy("init_smps.cpp")
    env.collect(":build:openocd.source", "board/st_nucleo_h745zi.cfg")
