def init(module):
    module.name = ":board:nucleo-c5a3zg"
    module.description = """\
# NUCLEO-C5A3ZG

[Nucleo kit for STM32C5A3ZG](https://www.st.com/en/evaluation-tools/nucleo-c5a3zg.html)

Default system clocking follows UM3616: the STM32C5A3ZG uses the on-board
48 MHz HSE crystal as reference for the 144 MHz PSI and the 32.768 kHz LSE
crystal. The board also exposes USB FS on a Type-C connector and an RMII
Ethernet PHY.
"""

def prepare(module, options):
    if not options[":target"].partname.startswith("stm32c5a3zgt"):
        return False

    module.depends(
        ":architecture:clock",
        ":debug",
        ":platform:clock",
        ":platform:core",
        ":platform:gpio",
        ":platform:i2c:1",
        ":platform:uart:2",
        ":platform:usb")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/board"
    env.substitutions = {
        "with_logger": True,
        "with_assert": env.has_module(":architecture:assert")
    }
    env.template("../board.cpp.in", "board.cpp")
    env.copy(".")

    env.outbasepath = "modm/openocd/modm/board/"
    env.template(repopath("tools/openocd/modm/st_nucleo_swd.cfg.in"), "board.cfg",
                 substitutions={"target": "stm32c5x"})
    env.collect(":build:openocd.source", "modm/board/board.cfg")
