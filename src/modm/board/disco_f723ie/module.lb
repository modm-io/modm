def init(module):
    module.name = ":board:disco-f723ie"
    module.description = """
# STM32F723E DISCOVERY

[Discovery kit for STM32F723E](https://www.st.com/en/evaluation-tools/32f723ediscovery.html)

## External Memory

The 512kB PSRAM on the FMC is configured before `main()` and added to the heap.
You can allocate from it with `new (modm::MemoryExternal) T` or place objects
into it with the `.data_psram`, `.bss_psram` or `.noinit_psram` sections. The
PSRAM is cached by the CPU, so clean or invalidate the D-cache when a DMA
accesses it.


## TinyUSB

This board has two USB ports: one with Full Speed support and another with true
High Speed support. By default, TinyUSB runs the device classes on the FS port,
however, you can reassign it to HS via this option:

```xml
<options>
  <option name="modm:ext:tinyusb:config">device.cdc,device.msc</option>
  <option name="modm:ext:tinyusb:device:port">hs</option>
</options>
```

Note that can use TinyUSB with both the device and host classes at the same time
if you assign them to different ports:

```xml
```xml
<options>
  <option name="modm:ext:tinyusb:config">device.cdc,device.msc</option>
  <option name="modm:ext:tinyusb:device:port">fs</option>
  <option name="modm:ext:tinyusb:host:port">hs</option>
</options>
```
"""

def prepare(module, options):
    if not options[":target"].partname.startswith("stm32f723iek"):
        return False

    module.depends(
        ":architecture:clock",
        ":debug",
        ":platform:clock",
        ":platform:core",
        ":platform:gpio",
        ":platform:uart:6",
        ":platform:usb:fs",
        ":platform:usb:hs")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/board"
    env.substitutions = {
        "with_logger": True,
        "with_assert": env.has_module(":architecture:assert")
    }
    env.template("../board.cpp.in", "board.cpp")
    env.copy('.')
    env.collect(":build:openocd.source", "board/stm32f7discovery.cfg")
    # Required for TinyUSB to enable the internal HS PHY
    env.collect(":build:cppdefines", "HSE_VALUE=25000000")

    env.collect(":platform:cortex-m:linkerscript.memory", linkerscript_memory)
    env.collect(":platform:cortex-m:linkerscript.sections", linkerscript_sections)
    env.collect(":platform:cortex-m:linkerscript.table_extern.zero", linkerscript_extern_zero)
    env.collect(":platform:cortex-m:linkerscript.table_extern.copy", linkerscript_extern_copy)
    env.collect(":platform:cortex-m:linkerscript.table_extern.heap", linkerscript_extern_heap)


# =============================================================================
# The 512kB PSRAM on FMC NE1
linkerscript_memory = """\
PSRAM (rwx) : ORIGIN = 0x60000000, LENGTH = 512K
"""

linkerscript_sections = """\
.data_psram :
{
    __data_psram_load = LOADADDR(.data_psram);
    __data_psram_start = .;
    *(.data_psram .data_psram.*)
    . = ALIGN(4);
    __data_psram_end = .;
} >PSRAM AT >FLASH

.bss_psram (NOLOAD) :
{
    __bss_psram_start = .;
    *(.bss_psram .bss_psram.*)
    . = ALIGN(4);
    __bss_psram_end = .;
} >PSRAM

.noinit_psram (NOLOAD) :
{
    __noinit_psram_start = .;
    *(.noinit_psram .noinit_psram.*)
    . = ALIGN(4);
    __noinit_psram_end = .;
} >PSRAM

.heap_psram (NOLOAD) :
{
    __heap_psram_start = .;
    *(.heap_psram .heap_psram.*)
    . = ORIGIN(PSRAM) + LENGTH(PSRAM);
    __heap_psram_end = .;
} >PSRAM
"""

linkerscript_extern_zero = """\
LONG(__bss_psram_start)
LONG(__bss_psram_end)
"""

linkerscript_extern_copy = """\
LONG(__data_psram_load)
LONG(__data_psram_start)
LONG(__data_psram_end)
"""

linkerscript_extern_heap = """\
LONG(0x801f)
LONG(__heap_psram_start)
LONG(__heap_psram_end)
"""

