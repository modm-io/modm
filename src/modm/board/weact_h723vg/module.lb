def init(module):
    module.name = ":board:weact-h723vg"
    module.description = """
# WeAct Studio MiniSTM32H723

[Documentation and hardware files](https://github.com/WeActStudio/WeActStudio.MiniSTM32H723)

STM32H723VGT6 development board with a 0.96 inch 160x80 ST7735 LCD panel.
The LCD uses SPI4 and reserves PE10 through PE14 while it is connected.
SDMMC, OctoSPI, camera and external-flash pins are not exposed as high-level
board drivers because this target has no corresponding verified modm support.


## Programming

The board has no onboard debug probe. Attach an external SWD probe to PA13,
PA14, NRST, 3V3 and GND, then select its OpenOCD interface in the project
configuration. The board also supports the STM32 ROM bootloader through BOOT0.


## Logging

RTT logging requires an external SWD probe:

```xml
<option name="modm:board:weact-h723vg:logger">RTT</option>
```

UART logging requires an external 3.3V USB-UART adapter on PA9/PA10:

```xml
<option name="modm:board:weact-h723vg:logger">UART</option>
```


## TinyUSB

The Type-C connector uses the H723 OTG HS controller with its internal FS PHY.
Configure TinyUSB for full speed:

```xml
<option name="modm:tinyusb:max-speed">full</option>
```


## LCD

The onboard ST7735 panel uses the HannStar profile at a conservative 8.59 MHz
SPI clock. Its backlight is active-low on PE10 and is kept off until explicitly
enabled with `Board::setDisplayBacklight(true)`.
"""

def prepare(module, options):
    if not options[":target"].partname.startswith("stm32h723vgt"):
        return False

    module.depends(
        ":debug",
        ":architecture:clock",
        ":platform:core",
        ":platform:gpio",
        ":platform:clock",
        ":platform:spi:4",
        ":platform:usb:hs",
        ":driver:st7735")

    values = {"Disabled": None, "RTT": ":platform:rtt", "UART": ":platform:uart:1"}
    module.add_option(
            EnumerationOption(name="logger", description="Logging mechanism",
                              enumeration=list(values.keys()), default="Disabled",
                              dependencies=lambda v: values[v]))

    return True


def build(env):
    env.outbasepath = "modm/src/modm/board"
    env.substitutions = {
        "with_logger": False if env["logger"] == "Disabled" else env["logger"],
        "with_assert": env.has_module(":architecture:assert"),
    }
    env.template("../board.cpp.in", "board.cpp")
    env.template("board.hpp.in")
    env.copy("startup.cpp")
    env.copy("board_display.cpp")

    env.outbasepath = "modm/openocd/modm/board/"
    env.template(repopath("tools/openocd/modm/stm32_swd.cfg.in"), "board.cfg",
                 substitutions={"target": "stm32h7x"})
    env.collect(":build:openocd.source", "modm/board/board.cfg")
