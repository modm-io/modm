def init(module):
    module.name = ":board:nucleo-g564re"
    module.description = """\
# NUCLEO-G564RE

[Nucleo kit for STM32G564RE](https://www.st.com/en/evaluation-tools/nucleo-g564re.html)

Default system clocking follows UM3659: the STM32G564RE uses the on-board
24 MHz HSE crystal and the 32.768 kHz LSE crystal. The board also exposes
USB FS on a Type-C connector and FDCAN1 with a transceiver.
"""

def prepare(module, options):
    if not options[":target"].partname.startswith("stm32g564ret"):
        return False

    module.depends(
        ":architecture:clock",
        ":debug",
        ":platform:clock",
        ":platform:core",
        ":platform:gpio",
        ":platform:i2c:1",
        ":platform:uart:2",
        ":platform:usb")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/board"
    env.substitutions = {
        "with_logger": True,
        "with_assert": env.has_module(":architecture:assert")
    }
    env.template("../board.cpp.in", "board.cpp")
    env.copy(".")

    env.outbasepath = "modm/openocd/modm/board/"
    env.template(repopath("tools/openocd/modm/st_nucleo_swd.cfg.in"), "board.cfg",
                 substitutions={"target": "stm32g5x"})
    env.collect(":build:openocd.source", "modm/board/board.cfg")
