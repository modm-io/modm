def init(module):
    module.name = ":board:disco-f429zi"
    module.description = """
# STM32F429IDISCOVERY

[Discovery kit for STM32F429](https://www.st.com/en/evaluation-tools/32f429idiscovery.html)

## Logging

The logger uses USART1, which is connected to the virtual COM port of the
STLINK/V2-B on the STM32F429I-DISC1 (MB1075E). On older boards you need to
close SB11 and SB15 and upgrade the STLINK/V2-B firmware! See Section 6.3
"Embedded ST-LINK/V2-B" of UM1670.

Alternatively, log via RTT, which works with any ST-LINK and needs no solder
bridges:

```xml
<option name="modm:board:disco-f429zi:with_rtt">yes</option>
```

Then log using:

```sh
scons log-rtt
```

## External Memory

The 8MB SDRAM on the FMC is configured before `main()` and added to the heap.
You can allocate from it with `new (modm::MemoryExternal) T` or place objects
into it with the `.data_sdram`, `.bss_sdram` or `.noinit_sdram` sections.


## TinyUSB

To use the USB port, you must configure TinyUSB to use the HS port in FS mode:

```xml
<option name="modm:ext:tinyusb:max-speed">full</option>
<!-- place either the device or host classes on the HS port -->
<option name="modm:ext:tinyusb:device:port">hs</option>
<option name="modm:ext:tinyusb:host:port">hs</option>
```
"""

def prepare(module, options):
    if not options[":target"].partname.startswith("stm32f429zit"):
        return False

    module.depends(
        ":debug",
        ":architecture:clock",
        ":driver:l3gd20",
        ":platform:clock",
        ":platform:core",
        ":platform:gpio",
        ":platform:spi:5",
        ":platform:uart:1",
        ":platform:usb:hs")

    module.add_option(
            BooleanOption(name="with_rtt", description="Log using RTT instead of USART1", default=False,
                          dependencies=lambda v: ":platform:rtt" if v else None))
    return True

def build(env):
    env.outbasepath = "modm/src/modm/board"
    env.substitutions = {
        "with_logger": True,
        "with_assert": env.has_module(":architecture:assert"),
        "with_rtt": env["with_rtt"],
    }
    env.template("../board.cpp.in", "board.cpp")
    env.template("board.hpp.in")
    env.copy('.', ignore=env.ignore_files("board.hpp.in"))
    env.collect(":build:openocd.source", "board/stm32f429discovery.cfg")

    env.collect(":platform:cortex-m:linkerscript.memory", linkerscript_memory)
    env.collect(":platform:cortex-m:linkerscript.sections", linkerscript_sections)
    env.collect(":platform:cortex-m:linkerscript.table_extern.zero", linkerscript_extern_zero)
    env.collect(":platform:cortex-m:linkerscript.table_extern.copy", linkerscript_extern_copy)
    env.collect(":platform:cortex-m:linkerscript.table_extern.heap", linkerscript_extern_heap)


# =============================================================================
linkerscript_memory = """\
SDRAM (rwx) : ORIGIN = 0xD0000000, LENGTH = 8M
"""

linkerscript_sections = """\
.data_sdram :
{
    __data_sdram_load = LOADADDR(.data_sdram);
    __data_sdram_start = .;
    *(.data_sdram .data_sdram.*)
    . = ALIGN(4);
    __data_sdram_end = .;
} >SDRAM AT >FLASH

.bss_sdram (NOLOAD) :
{
    __bss_sdram_start = .;
    *(.bss_sdram .bss_sdram.*)
    . = ALIGN(4);
    __bss_sdram_end = .;
} >SDRAM

.noinit_sdram (NOLOAD) :
{
    __noinit_sdram_start = .;
    *(.noinit_sdram .noinit_sdram.*)
    . = ALIGN(4);
    __noinit_sdram_end = .;
} >SDRAM

.heap_sdram (NOLOAD) :
{
    __heap_sdram_start = .;
    *(.heap_sdram .heap_sdram.*)
    . = ORIGIN(SDRAM) + LENGTH(SDRAM);
    __heap_sdram_end = .;
} >SDRAM
"""

linkerscript_extern_zero = """\
LONG(__bss_sdram_start)
LONG(__bss_sdram_end)
"""

linkerscript_extern_copy = """\
LONG(__data_sdram_load)
LONG(__data_sdram_start)
LONG(__data_sdram_end)
"""

linkerscript_extern_heap = """\
LONG(0x801f)
LONG(__heap_sdram_start)
LONG(__heap_sdram_end)
"""
