def init(module):
    module.name = ":board:rp-pico2"
    module.description = """
# Raspberry Pi Pico 2

RP2350A Official System Development Board with 4MiB flash.
See https://www.raspberrypi.com/products/raspberry-pi-pico-2


## Programming

### UF2

The RP2350 ships with a [UF2 bootloader in ROM](https://github.com/microsoft/uf2).

To upload your application, connect the RP2350 via USB while holding the
BOOTSEL button, convert the ELF to UF2 format by calling `scons uf2` or
`make uf2` and copy the generated `.uf2` file to the mounted virtual disk.


### PICOBOOT

With [`picotool`](https://github.com/raspberrypi/picotool) installed, call
`scons program-picoboot` or `make program-picoboot` to program, verify and start
your application on a device in BOOTSEL mode without using the virtual disk.


### OpenOCD

Connect a CMSIS-DAP probe, for example the Raspberry Pi Debug Probe, to the SWD
header and call `scons program` or `make program`. OpenOCD supports the RP2350
since v0.12.0+dev with `target/rp2350.cfg`.


## Logging

To log via RTT attach a debugger to the SWD port and select the RTT option:

```xml
<option name="modm:board:rp-pico2:logger">RTT</option>
```

Then log using:

```sh
scons log-rtt
```

To log via UART, attach a serial adapter to GPIO0 (TX, 115200 baud) and select
the UART option:

```xml
<option name="modm:board:rp-pico2:logger">UART</option>
```
"""

def prepare(module, options):
    if not options[":target"].partname.startswith("rp2350a"):
        return False

    module.depends(
        ":platform:clock.timer",
        ":platform:core",
        ":platform:gpio",
        ":platform:usb",
        ":platform:clockgen")

    values = {"Disabled": None, "RTT": [":platform:rtt", ":debug"], "UART": [":platform:uart:0", ":debug"]}
    module.add_option(
            EnumerationOption(name="logger", description="Logging mechanism",
                              enumeration=list(values.keys()), default="Disabled",
                              dependencies=lambda v: values[v]))
    return True

def build(env):
    env.outbasepath = "modm/src/modm/board"
    env.substitutions = {
        "with_logger": False if env["logger"] == "Disabled" else env["logger"],
        "with_assert": env.has_module(":architecture:assert"),
        "board" : "rp-pico2"
    }
    env.template("board.hpp.in", "board.hpp")
    env.template("../board.cpp.in", "board.cpp")
    env.collect(":build:openocd.source", "interface/cmsis-dap.cfg", "target/rp2350.cfg")
