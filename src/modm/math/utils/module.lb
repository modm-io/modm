def init(module):
    module.name = ":math:utils"
    module.description = "Utilities"

def prepare(module, options):
    module.depends(":architecture")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/math/utils"

    ignore = []
    if "avr" not in env[":target"].identifier["platform"]:
        ignore.append("*avr*")

    env.copy('.', ignore=env.ignore_paths(*ignore))
    env.copy("../utils.hpp")
