#ifndef MODM_IODEVICE_WRAPPER_HPP
#define MODM_IODEVICE_WRAPPER_HPP

#include <bit>
#include <stdint.h>
%% if with_fiber
#include <modm/architecture/interface/fiber.hpp>
%% endif
%#
#include "iodevice.hpp"

namespace modm
{

/// The preferred behavior when the IODevice buffer is full
/// @ingroup	modm_io
enum class
IOBuffer
{
	DiscardIfFull,
	BlockIfFull
};

%% if with_fiber
/// @cond
namespace detail
{
/// Keeps the lines of fibers apart without buffering them: the fiber that
/// writes a line owns it until its newline, but only blocks other fibers while
/// it waits for the full device. If it yields anywhere else in the middle of
/// its line (it sleeps, waits, or returned), the next fiber ends that line with
/// a newline and writes its own.
struct IODeviceLine
{
	fiber::id owner{fiber::invalid_id};
	bool busy{};

	void
	put(char c, auto &&write)
	{
		busy = true;
		this_fiber::poll([&]{ return write(uint8_t(c)); });
		busy = false;
	}

	void
	write(char c, auto &&write)
	{
		if (const auto me = this_fiber::get_id(); owner != me)
		{
			this_fiber::poll([&]{ return not busy; });
			const bool cut = (owner != fiber::invalid_id and c != '\n');
			owner = me;
			if (cut) put('\n', write);
		}
		put(c, write);
		if (c == '\n') owner = fiber::invalid_id;
	}

	void
	flush(auto &&finished)
	{
		this_fiber::poll([&]{ return not busy; });
		busy = true;
		this_fiber::poll(finished);
		busy = false;
	}
};
}
/// @endcond

%% endif
/**
 * @ingroup		modm_io
 * @tparam		Device		Peripheral which should be wrapped
 * @tparam		behavior	preferred behavior when the Device buffer is full
 */
template< class Device, IOBuffer behavior >
class IODeviceWrapper : public IODevice
{
%% if with_fiber
	static inline detail::IODeviceLine line;
%% endif
public:
	IODeviceWrapper() = default;
	using IODevice::write;

	void
	write(char c) override
	{
		if constexpr (behavior == IOBuffer::BlockIfFull)
%% if with_fiber
			line.write(c, [](uint8_t byte) { return Device::write(byte); });
%% else
			while (not Device::write(uint8_t(c))) ;
%% endif
		else Device::write(uint8_t(c));
	}

	void
	flush() override
	{
%% if with_fiber
		line.flush([&]{ return Device::isWriteFinished(); });
%% else
		Device::flushWriteBuffer();
%% endif
	}

	bool
	read(char& c) override
	{
		uint8_t value = 0;
		const bool success = Device::read(value);
		if (success) { c = std::bit_cast<char>(value); }
		return success;
	}
};

/// @ingroup modm_io
template< class Device, IOBuffer behavior >
class IODeviceObjectWrapper : public IODevice
{
%% if with_fiber
	detail::IODeviceLine line;
%% endif
	Device &device;
public:
	constexpr IODeviceObjectWrapper(Device& device) : device{device} {}
	using IODevice::write;

	void
	write(char c) override
	{
		if constexpr (behavior == IOBuffer::BlockIfFull)
%% if with_fiber
			line.write(c, [&](uint8_t byte) { return device.write(byte); });
%% else
			while (not device.write(uint8_t(c))) ;
%% endif
		else device.write(uint8_t(c));
	}

	void
	flush() override
	{
%% if with_fiber
		line.flush([&]{ return device.isWriteFinished(); });
%% else
		device.flushWriteBuffer();
%% endif
	}

	bool
	read(char& c) override
	{
		uint8_t value = 0;
		const bool success = device.read(value);
		if (success) { c = std::bit_cast<char>(value); }
		return success;
	}
};

}

#endif // MODM_IODEVICE_WRAPPER_HPP
