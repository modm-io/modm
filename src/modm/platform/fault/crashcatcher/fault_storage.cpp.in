#include "fault_storage.hpp"
#include <modm/architecture/utils.hpp>
#include <modm/platform/core/hardware_init.hpp>
#include <modm/platform/device.hpp>

struct table_pool_t
{
	uint32_t traits;
	uint8_t *const start;
	uint8_t *const end;
} modm_packed;

extern "C" const table_pool_t __table_heap_start[];
extern "C" const table_pool_t __table_heap_end[];

static constexpr uint32_t magic_start = 0xBAADC0DE;
static constexpr uint32_t magic_end = 0xC0FFEEEE;
static modm_section(".noinit") uint32_t marker_start;
static modm_section(".noinit") const uint8_t* marker_end_ptr;
static const uint8_t* report_end{0};
static bool storage_full{false};
extern "C" uint32_t g_crashCatcherStack[];

%% if has_ram_ecc
// Writes back memory in aligned 64-bit words. The SRAM ECC controller caches
// partial writes until the word is complete, and a reset discards this cache,
// so the last incomplete word of the report would be lost.
static void
writeback(const void* begin, const void* end)
{
	auto pos = reinterpret_cast<volatile uint64_t*>(uintptr_t(begin) & ~7ul);
	for (; pos < reinterpret_cast<const volatile uint64_t*>(end); pos++) *pos = *pos;
}
%% endif

static void
writeback_markers()
{
%% if has_ram_ecc
	writeback(&marker_start, &marker_start + 1);
	writeback(&marker_end_ptr, &marker_end_ptr + 1);
%% endif
#if defined(__DCACHE_PRESENT) && __DCACHE_PRESENT
	// The report may still be in the D-Cache, which a reset discards
	if (SCB->CCR & SCB_CCR_DC_Msk) SCB_CleanDCache();
#endif
}

namespace modm::platform
{

const uint8_t *fault_storage_heap_start{nullptr};

size_t
FaultStorage::openRead()
{
	report_end = __table_heap_start->start;
	// Check for start marker
	if (marker_start == magic_start and marker_end_ptr)
	{
		// Check if pointer is in any heap and sum up total size
		size_t size{0};
		for (auto t = __table_heap_start; t < __table_heap_end; t++)
		{
			if (t->start <= marker_end_ptr and marker_end_ptr < t->end)
			{
				if (*reinterpret_cast<const uint32_t*>(marker_end_ptr) == magic_end)
				{
					report_end = marker_end_ptr;
					size += marker_end_ptr - t->start;
					ptrdiff_t end = ptrdiff_t(marker_end_ptr + sizeof(magic_end));
					// Align end pointer to nearest 32-bits
					end = (end + 3) & ~3;
					fault_storage_heap_start = reinterpret_cast<const uint8_t*>(end);
					return size;
				}
				else break;
			}
			size += t->end - t->start;
		}
	}
	closeRead();
	return 0;
}

void
FaultStorage::closeRead()
{
	marker_start = 0;
	marker_end_ptr = nullptr;
	writeback_markers();
}

void
FaultStorage::openWrite()
{
	current = begin();
	storage_full = false;
	marker_start = magic_start;
	marker_end_ptr = nullptr;
}

bool
FaultStorage::write(const void* vdata, size_t element_size, size_t elements)
{
	const uint8_t *data = reinterpret_cast<const uint8_t *>(vdata);
	while(elements--)
	{
		uint32_t value;
		switch(element_size)
		{
			case 1:
				asm volatile("ldrb %0, [%1]" : "=r" (value) : "r" (data));
				break;
			case 2:
				asm volatile("ldrh %0, [%1]" : "=r" (value) : "r" (data));
				break;
			case 4:
				asm volatile("ldr %0, [%1]" : "=r" (value) : "r" (data));
				break;
			default:
				return false;
		}
		data += element_size;
		if (not write(reinterpret_cast<const uint8_t *>(&value), element_size))
			return false;
	}
	return true;
}

bool
FaultStorage::write(const uint8_t *data, size_t size)
{
	while(size--)
	{
		if (storage_full) return false;
		*const_cast<uint8_t*>(current.pos) = *data++;
		const auto previous = current.pos;
		current++;
		// The report is truncated and discarded when all heaps are full
		storage_full = (current.pos == previous);
	}
	return true;
}

void
FaultStorage::closeWrite()
{
	// The end marker must fit contiguously into the last heap, but not into the
	// CrashCatcher stack, which is still in use. If it does not fit, the report
	// is truncated and the last word is dropped to make room for it, so that a
	// truncated report can still be read back.
	const auto table = static_cast<const table_pool_t*>(current.table);
	uintptr_t end = uintptr_t(table->end);
	if (uintptr_t(table->start) <= uintptr_t(g_crashCatcherStack) and
		uintptr_t(g_crashCatcherStack) < end)
	{
		end = uintptr_t(g_crashCatcherStack);
	}
	auto pos = const_cast<uint8_t*>(current.pos) + (storage_full ? 1 : 0);
	if (uintptr_t(pos) + sizeof(magic_end) > end)
		pos = reinterpret_cast<uint8_t*>(end - sizeof(magic_end));
	if (pos < table->start) pos = table->start;
	current = Iterator(table, pos);
	marker_end_ptr = pos;
	storage_full = false;
	write(&magic_end, sizeof(magic_end));
%% if has_ram_ecc
	// Write back the report up to the CrashCatcher stack, which is in use
	const auto stack = reinterpret_cast<const uint8_t*>(g_crashCatcherStack);
	const auto report_end = marker_end_ptr + sizeof(magic_end);
	for (auto t = __table_heap_start; t < __table_heap_end; t++)
	{
		const bool last = t->start <= marker_end_ptr and marker_end_ptr < t->end;
		auto end = last ? report_end : t->end;
		if (t->start <= stack and stack < end) end = stack;
		writeback(t->start, end);
		if (last) break;
	}
%% endif
	writeback_markers();
}

FaultStorage::Iterator
FaultStorage::begin()
{
	return Iterator((const void*)__table_heap_start, __table_heap_start->start);
}

FaultStorage::Iterator
FaultStorage::end()
{
	return Iterator((const void*)__table_heap_start, report_end);
}

// ========= Iterator =========

FaultStorage::Iterator::Iterator(const void *table, const uint8_t* pos):
	table(table), pos(pos)
{}

uint8_t
FaultStorage::Iterator::operator*() const
{
	return *pos;
}

FaultStorage::Iterator&
FaultStorage::Iterator::operator++()
{
	auto t = (const table_pool_t *)table;
	if ((pos + 1) >= t->end or (pos + 1) == reinterpret_cast<const uint8_t*>(g_crashCatcherStack)) {
		if (t + 1 < __table_heap_end) {
			t++;
			pos = t->start;
			table = (const void*)t;
		}
		return *this;
	}
	pos++;
	return *this;
}

FaultStorage::Iterator
FaultStorage::Iterator::operator++(int)
{
	Iterator it{table, pos};
	++*this;
	return it;
}

bool
FaultStorage::Iterator::operator==(const Iterator& other) const
{
	return pos == other.pos;
}

bool
FaultStorage::Iterator::operator!=(const Iterator& other) const
{
	return pos != other.pos;
}

}

MODM_HARDWARE_INIT_NAME(fault_open_read, modm::platform::FaultStorage::openRead);
