#include "i2c_master_{{ id }}.hpp"
#include <modm/architecture/interface/interrupt.hpp>

MODM_ISR(I2C{{ id }}_EV)
{
	modm::platform::I2cMaster{{ id }}::irq();
}

MODM_ISR(I2C{{ id }}_ER)
{
	modm::platform::I2cMaster{{ id }}::irq();
}
