#pragma once

#include <modm/architecture/interface/i2c_master.hpp>
#include <modm/platform/gpio/connector.hpp>
#include <modm/architecture/interface/delay.hpp>
#include <modm/platform/clock/rcc.hpp>
#include "i2c_master_base.hpp"
#include <modm/math/algorithm/prescaler.hpp>
#include <modm/math/utils/cmath.hpp>

namespace modm::platform
{

/**
 * I2cMaster implementation of I2C{{ id }} module.
 *
 * Interrupts must be enabled.
 *
 * @ingroup		modm_platform_i2c modm_platform_i2c_{{id}}
 */
class I2cMaster{{ id }} : public ::modm::I2cMaster
{
public:
	/// The driver object of this instance
	static inline constinit I2cMasterBase instance{I2C{{ id }}_BASE};

public:
	template<class... Signals>
	static void
	connect(PullUps pullups = PullUps::External, ResetDevices reset = ResetDevices::Standard)
	{
		using Connector = GpioConnector<Peripheral::I2c{{ id }}, Signals...>;
		using Scl = typename Connector::template GetSignal<Gpio::Signal::Scl>;
		using Sda = typename Connector::template GetSignal<Gpio::Signal::Sda>;
		static_assert(sizeof...(Signals) == 2 and
					  Connector::template IsValid<Scl> and Connector::template IsValid<Sda>,
					  "I2cMaster{{id}}::connect() requires one Scl and one Sda signal!");
		const Gpio::InputType input =
			(pullups == PullUps::Internal) ? Gpio::InputType::PullUp : Gpio::InputType::Floating;

		Connector::disconnect();
		Scl::configure(input);
		Sda::configure(input);
		Scl::setOutput(Gpio::OutputType::OpenDrain);
		Sda::setOutput(Gpio::OutputType::OpenDrain);
		if (reset != ResetDevices::NoReset) resetDevices<Scl, Sda>(uint32_t(reset));
		Connector::connect();
		// reset() clears the bus with the same signals
		busReset = reset;
		instance.recoverBus = (reset != ResetDevices::NoReset) ? &clearBus<Signals...> : nullptr;
	}

	/// Sets up the peripheral for controller operation at `baudrate` (standard or fast mode).
	template<class SystemClock, baudrate_t baudrate=kBd(100), percent_t tolerance=pct(5)>
	static void
	initialize(uint8_t isrPriority = 10u)
	{
		// calculate the expected clock ratio
		constexpr uint8_t scalar = (baudrate <= 100'000) ? 2 : ((baudrate <= 300'000) ? 3 : 25);
		constexpr uint16_t range_begin = (scalar == 2) ? 4 : 1;

		constexpr auto result = Prescaler::from_linear(
				SystemClock::I2c{{ id }} / scalar, baudrate, range_begin, 4095);
		assertBaudrateInTolerance< result.frequency, baudrate, tolerance >();

		// the final prescaler value is augmented with the F/S and DUTY bit.
		constexpr uint32_t prescaler = result.prescaler |
				((scalar >=  3) ? (1 << 15) : 0) |
				((scalar == 25) ? (1 << 14) : 0);

		// peripheral frequency clock
		constexpr uint8_t freq = SystemClock::I2c{{ id }} / 1'000'000;

		// maximum rise time: assuming its linear:
		// 1000ns @ 100kHz and 300ns @ 400kHz
		//   => y = x * m + b, with m = -2.3333ns/kHz, b = 1'233.3333ns
		constexpr float max_rise_time = -2.333333f * (float(baudrate) / 1'000.f) + 1'233.333333f;
		// calculate trise
		constexpr float trise_raw = max_rise_time < 0 ? 0 : modm::floor(max_rise_time / (1'000.f / freq));
		constexpr uint8_t trise = trise_raw > 62 ? 63 : (trise_raw + 1);

		Rcc::enable<Peripheral::I2c{{ id }}>();
		instance.configure(freq, trise, prescaler);
		NVIC_SetPriority(I2C{{ id }}_ER_IRQn, isrPriority);
		NVIC_EnableIRQ(I2C{{ id }}_ER_IRQn);
		NVIC_SetPriority(I2C{{ id }}_EV_IRQn, isrPriority);
		NVIC_EnableIRQ(I2C{{ id }}_EV_IRQn);
	}

	static bool
	start(I2cTransaction *transaction, ConfigurationHandler handler = nullptr)
	{ return instance.start(transaction, handler); }

	static Error
	getErrorState()
	{ return instance.getErrorState(); }

	/// Detaches all transactions, resets the peripheral and clears the bus if a
	/// device holds SDA low, unless connect() was called with `ResetDevices::NoReset`.
	/// @warning Must not be called from an interrupt.
	static void
	reset()
	{ instance.reset(); }

	/// The interrupt handler, called by the vector(s) of this instance.
	static void
	irq()
	{ instance.isr(); }

private:
	/// Clears the bus, see resetDevices(). Busy waits: the driver also calls it from
	/// the interrupt when the bus is still busy at a START after a peripheral reset.
	template<class... Signals>
	static void
	clearBus(bool afterRead)
	{
		using Connector = GpioConnector<Peripheral::I2c{{ id }}, Signals...>;
		using Scl = typename Connector::template GetSignal<Gpio::Signal::Scl>;
		using Sda = typename Connector::template GetSignal<Gpio::Signal::Sda>;
		// GPIO open-drain outputs, released first: Connector::disconnect() would also
		// remove the internal pull-ups of connect(PullUps::Internal), and the bus floats low
		Scl::set();
		Sda::set();
		Scl::setOutput(Gpio::OutputType::OpenDrain);
		Sda::setOutput(Gpio::OutputType::OpenDrain);
		const uint32_t us = 500'000ul / uint32_t(busReset);
		I2c::clearBus<Scl, Sda>([us] { modm::delay_us(us); }, afterRead);
		Connector::connect();
	}

	static inline ResetDevices busReset{ResetDevices::NoReset};
};

} // namespace modm::platform
