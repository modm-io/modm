#ifndef MODM_SOFTWARE_BITBANG_I2C_HPP
#define MODM_SOFTWARE_BITBANG_I2C_HPP

#include <chrono>
#include <modm/architecture/interface/delay.hpp>
#include <modm/architecture/interface/gpio.hpp>
#include <modm/architecture/interface/i2c_master.hpp>
#include <modm/platform/gpio/connector.hpp>
%% if target.platform in ["avr", "rp"]
#include <modm/platform/gpio/open_drain.hpp>
%% endif

namespace modm
{

namespace platform
{

/**
 * Software emulation of a I2C master implementation
 *
 * @ingroup	modm_platform_i2c_bitbang
 * @author	Niklas Hauser
 * @see		gpio
 */
template< class Scl,
		  class Sda >
class BitBangI2cMaster : public modm::I2cMaster
{
%% if target.platform in ["avr", "rp"]
	using SCL = platform::GpioOpenDrain<Scl>;
	using SDA = platform::GpioOpenDrain<Sda>;
%% else
	using SCL = Scl;
	using SDA = Sda;
%% endif

public:
	template< class... Signals >
	static void
	connect(PullUps pullups = PullUps::External, ResetDevices reset = ResetDevices::Standard);

	/// Initializes the hardware, with the baudrate limited to about 250kbps.
	template< class SystemClock, baudrate_t baudrate=kHz(100), percent_t tolerance=pct(5) >
	static void
	initialize();

public:
	static bool
	start(I2cTransaction *transaction, ConfigurationHandler handler = nullptr);

	static Error
	getErrorState()
	{ return errorState; }

	/// Aborts the transaction and clears the bus if a device holds SDA or SCL low
	static inline void
	reset();

	/// Sets how long a device may stretch the clock, by default 100 ms.
	static void
	setStretchTimeout(std::chrono::milliseconds timeout)
	{ stretchTimeout = timeout; }

	/// Sets the timeout of the next transaction, forwarded by I2cDevice.
	/// A device may stretch the clock for half of the transaction timeout.
	static void
	setTransactionTimeout(std::chrono::milliseconds timeout)
	{
		if (timeout.count()) stretchTimeout = timeout / 2;
	}

public:
	// The steps of a transfer for MODM_I2C_TRACE, one per byte
	enum class
	State : uint8_t { Idle, Address, Write, Read };
	/// The bus event that ended a step, or a pseudo flag of a software step (the same
	/// values as the STM32 drivers)
	enum
	Flag : uint8_t
	{
		ACKED = 0,		///< the byte was acknowledged (by the target, or by us in a read)
		NACKED = 1,		///< the byte was not acknowledged
		LOST = 2,		///< another controller drove a bit to 0: lost arbitration
		STRETCH = 3,	///< a target stretched the clock for longer than the timeout
		GLITCH = 4,		///< SDA changed or SCL fell while SCL was high
		END = 5,		///< the transfer ends here, no bus event
		START = 16, DEADLINE = 18, BUSY_AT_START = 19, FAILURE = modm::I2c::TraceFailure
	};
	enum class
	Action : uint8_t { Start, Restart, Address, Write, Read, Stop, Refuse, Abort };

	/// The instance argument of MODM_I2C_TRACE for this controller.
	static uintptr_t
	traceInstance()
	{ return reinterpret_cast<uintptr_t>(&transactionObject); }

	/// The names of the states, flags and actions, for example to print a trace.
	static constexpr const char *
	stateName(uint8_t state)
	{
		constexpr const char *names[] = {"Idle", "Address", "Write", "Read"};
		return (state < sizeof(names) / sizeof(names[0])) ? names[state] : "?";
	}
	static constexpr const char *
	flagName(uint8_t flag)
	{
		switch (flag)
		{
			case ACKED: return "ACK";
			case NACKED: return "NACK";
			case LOST: return "LOST";
			case STRETCH: return "STRETCH";
			case GLITCH: return "GLITCH";
			case END: return "END";
			case START: return "START";
			case DEADLINE: return "DEADLINE";
			case BUSY_AT_START: return "BUSY_AT_START";
			case FAILURE: return "FAILURE";
			default: return "?";
		}
	}
	static constexpr const char *
	actionName(uint8_t action)
	{
		constexpr const char *names[] = {"Start", "Restart", "Address", "Write", "Read", "Stop", "Refuse", "Abort"};
		return (action < sizeof(names) / sizeof(names[0])) ? names[action] : "?";
	}

private:
	/// One step for MODM_I2C_TRACE
	static void
	step([[maybe_unused]] uint8_t flag, [[maybe_unused]] Action action, State after)
	{
#ifdef MODM_I2C_TRACE
		::MODM_I2C_TRACE(traceInstance(), uint8_t(state), flag, uint8_t(action), uint8_t(after));
#endif
		state = after;
	}

	/// Clears the bus with resetDevices() if enabled in connect()
	/// @return	`true` if both lines are high afterwards
	static inline bool
	clearBus();

	/// runs the attached transaction until its STOP or an error
	static inline void
	run();

	/// detaches the transaction, after the bus was released
	static inline void
	finish(Error error);

	/// releases the bus with a STOP if possible, then finishes with the error
	static inline void
	error(Error error);

	// bus condition operations
	/// generate a start or restart condition
	/// @return	`true` if success, `false` if bus in unknown condition
	static inline bool
	startCondition();

	/// generate a stop condition
	/// @return	`true` if success, `false` if bus in unknown condition
	static inline bool
	stopCondition();

	/// release the clock and wait for any slaves to release it too, first
	/// busy waiting for about 1 ms, then yielding until the stretch timeout
	/// @return	`true` if success, `false` if slave stretched the clock for too long
	static inline bool
	sclSetAndWait();

	// byte operations
	/// write one byte to the bus
	/// @return	`true` if success, `false` if arbitation, too much clock stretching or NACK received
	static inline bool
	write(uint8_t data, State next = State::Write);

	/// read one byte from the bus
	/// @param	ack	acknowledge bit of read operation, `ACK` or `NACK`
	/// @return	`true` if success, `false` if arbitation occured
	static inline bool
	read(uint8_t &data, bool ack);

	/// write one bit to the bus
	/// @return	ArbitrationLost if another controller drives a 0, BusCondition if a target
	///			stretches the clock for too long
	static inline Error
	writeBit(bool bit);

	// bit operations
	/// read one bit from the bus
	/// @return	BusCondition if SDA changed while SCL was high, or a target stretches the
	///			clock for too long
	static inline Error
	readBit(uint8_t &data);

	// timings
	/// busy waits a **half** clock cycle
	static void
	delay2()
	{ modm::delay_ns(delayTime*2); }

	// timings
	/// busy waits **quarter** clock cycle
	static void
	delay4()
	{ modm::delay_ns(delayTime); }

	enum
	{
		ACK = true,
		NACK = false,
	};

	// calculate the delay in microseconds needed to achieve the
	// requested I2C frequency
	static uint16_t delayTime;

	/// a fiber runs a transaction in start(), even while it waits for clock stretching
	static inline bool running{false};
	/// reset() ended the running transaction: its fiber leaves the bus alone
	static inline bool aborted{false};
	/// a NACK now is an address NACK
	static inline bool addressPhase{false};
	static inline State state{State::Idle};
	static inline uint8_t bitFlag{GLITCH};	///< what ended the last failed bit, for the trace

	/// A FAILURE step for MODM_I2C_TRACE, unless the error is a NACK
	static void
	failure([[maybe_unused]] Error error)
	{
#ifdef MODM_I2C_TRACE
		if (error != Error::NoError and error != Error::AddressNack and error != Error::DataNack)
			::MODM_I2C_TRACE(traceInstance(), 0xff, FAILURE, uint8_t(error), 0xff);
#endif
	}
	static modm::I2cTransaction *transactionObject;
	static Error errorState;
	static modm::I2c::ConfigurationHandler configuration;
	static inline ResetDevices busReset{ResetDevices::NoReset};
	static inline std::chrono::milliseconds stretchTimeout{100};

	static modm::I2cTransaction::Starting starting;
	static modm::I2cTransaction::Writing writing;
	static modm::I2cTransaction::Reading reading;
};

} // namespace platform

} // namespace modm

#include "bitbang_i2c_master_impl.hpp"

#endif // MODM_SOFTWARE_BITBANG_I2C_HPP
