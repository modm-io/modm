#include "flash.hpp"
#include <modm/architecture/interface/atomic_lock.hpp>
#include <algorithm>
#include <cstring>
#include <modm/architecture/utils.hpp>
#include <modm/architecture/interface/fiber.hpp>

extern "C" const uint8_t __rom_start[], __rom_end[];

%% if tick
extern "C" void SysTick_Handler();
%% endif

%% set a = "A" if bank2 else ""
namespace
{

using Flash = modm::platform::Flash;

/// @return true if the program image is outside of [start, end), so that other
///         fibers can run from flash during an operation in this range
bool
outsideImage(uintptr_t start, uintptr_t end)
{
	return uintptr_t(__rom_end) <= start or end <= uintptr_t(__rom_start);
}

constexpr uint32_t Errors = FLASH_{{a}}ISR_WRPERRF | FLASH_{{a}}ISR_PGSERRF | FLASH_{{a}}ISR_STRBERRF | FLASH_{{a}}ISR_INCERRF;
constexpr uint32_t Busy = FLASH_{{a}}SR_BUSY | FLASH_{{a}}SR_QW | FLASH_{{a}}SR_WBNE;

constexpr uint32_t Operation = FLASH_{{a}}CR_PG | FLASH_{{a}}CR_SER | FLASH_{{a}}CR_SSN_Msk;
/// Not a CR bit: the operation is on a bank the program does not run from, so
/// interrupts are not masked and other fibers run meanwhile
constexpr uint32_t Other = 1ul << 31;
static_assert(not (Operation & Other));

/// The registers of a bank, those of the H7P bank B are 0x100 behind bank A
struct Bank
{
	volatile uint32_t *const regs;
	modm_always_inline explicit Bank(bool b) : regs(reinterpret_cast<volatile uint32_t *>(FLASH) + (b ? 0x40 : 0)) {}
	modm_always_inline volatile uint32_t &KEYR() const { return regs[1]; }
	modm_always_inline volatile uint32_t &CR() const { return regs[4]; }
	modm_always_inline volatile uint32_t &SR() const { return regs[5]; }
	modm_always_inline volatile uint32_t &ISR() const { return regs[9]; }
	modm_always_inline volatile uint32_t &ICR() const { return regs[10]; }
};
static_assert(offsetof(FLASH_TypeDef, {{a}}KEYR) == 0x04 and offsetof(FLASH_TypeDef, {{a}}ICR) == 0x28);
%% if bank2
static_assert(offsetof(FLASH_TypeDef, BKEYR) == 0x104 and offsetof(FLASH_TypeDef, BICR) == 0x128);
%% endif

/// @return the bank of the absolute address addr
Bank
bankOf(uintptr_t addr)
{
	return Bank(Flash::Bank2Addr != Flash::OriginAddr and addr >= Flash::Bank2Addr);
}

/// @return Other if the program image is outside of the bank of addr
uint32_t
otherOf(uintptr_t addr)
{
	const uintptr_t start = (addr >= Flash::Bank2Addr) ? Flash::Bank2Addr : Flash::OriginAddr;
	return outsideImage(start, start + Flash::SectorsPerBank * Flash::SectorSize) ? Other : 0;
}

%% if basepri
/// Interrupts with handlers in flash stall during an operation on the bank of
/// the program and block all other interrupts, so only priority 0 interrupts,
/// whose vectors and handlers must be in RAM, may run.
struct Mask : modm::atomic::LockPriority
{
	modm_always_inline Mask() : LockPriority(1) {}
};
%% else
/// Interrupts with handlers in flash stall during an operation on the bank of
/// the program and block all other interrupts, so no interrupt may run.
using Mask = modm::atomic::Lock;
%% endif

%% if tick
/// Calls the SysTick handler in RAM, since no interrupt may run
modm_always_inline void
tick()
{
	if ((SysTick->CTRL & SysTick_CTRL_TICKINT_Msk) and (SCB->ICSR & SCB_ICSR_PENDSTSET_Msk))
	{
		SCB->ICSR = SCB_ICSR_PENDSTCLR_Msk;
		SysTick_Handler();
	}
}
%% endif


/// Sets the operation in CR, writes [words, end) back-to-back to dst or starts
/// an erase without words, and waits until the operation finished.
/// @return error flags, zero on success
template< bool other >
modm_always_inline uint32_t
operate(const Bank bank, volatile uint32_t *dst, const uint32_t *words, const uint32_t *end,
		uint32_t cr, [[maybe_unused]] uint32_t typical)
{
	while (bank.SR() & Busy) ;
	bank.ICR() = Errors | FLASH_{{a}}ICR_EOPF;
	bank.CR() = (bank.CR() & ~Operation) | (cr & Operation);
	if (words != end)
	{
		modm::atomic::Lock lock;
		do *dst++ = *words++;
		while (words != end);
	}
	else bank.CR() |= FLASH_{{a}}CR_START;
	__DSB();
	// Other fibers run from flash meanwhile, while the operation takes the
	// typical time, and until it finished
	if constexpr (other)
	{
%% if clock
		modm::this_fiber::sleep_for(std::chrono::microseconds(typical));
%% endif
		modm::this_fiber::poll([&] { return not (bank.SR() & Busy); });
	}
	else while (bank.SR() & Busy) {{ "tick();" if tick else ";" }}
	const uint32_t err = bank.ISR() & Errors;
	bank.ICR() = Errors | FLASH_{{a}}ICR_EOPF;
	bank.CR() &= ~Operation;
	return err;
}

/// The only code that runs while the bank of the program is busy, therefore in
/// RAM with interrupts masked
modm_ramcode uint32_t
runMasked(const Bank bank, volatile uint32_t *dst, const uint32_t *words, const uint32_t *end,
		  uint32_t cr, uint32_t typical)
{
	const Mask mask;
	return operate<false>(bank, dst, words, end, cr, typical);
}

uint32_t
run(uintptr_t addr, volatile uint32_t *dst, const uint32_t *words, const uint32_t *end,
	uint32_t cr, uint32_t typical)
{
	const Bank bank = bankOf(addr);
	// The other bank does not stall the program, so the operation runs from flash
	// without masking interrupts
	if (otherOf(addr)) return operate<true>(bank, dst, words, end, cr, typical);
	return runMasked(bank, dst, words, end, cr, typical);
}


/// @return true if [addr, addr + size) reads as erased without any ECC error
bool
targetErased(uintptr_t addr, size_t size)
{
	uint8_t chunk[64];
	for (size_t offset{0}; offset < size; offset += sizeof(chunk))
	{
		const size_t length = std::min(sizeof(chunk), size - offset);
		const Bank bank = bankOf(addr + offset);
		bank.ICR() = FLASH_{{a}}ICR_SNECCERRF;
		if (Flash::read(addr + offset, chunk, length)) return false;
		// A partially programmed word may be "corrected" to erased
		if (bank.ISR() & FLASH_{{a}}ISR_SNECCERRF) return false;
		for (size_t ii{0}; ii < length; ii++)
			if (chunk[ii] != Flash::ErasedValue) return false;
	}
	return true;
}

/// @return true if all bytes have the erased value. Programming them does not
/// change the content, but on the L4 and U5 controllers a unit programmed with
/// all ones fails to program again, although it still reads as erased.
bool
isErased(const uint8_t *data, size_t size)
{
	for (; size; size--)
		if (*data++ != modm::platform::Flash::ErasedValue) return false;
	return true;
}

} // namespace

namespace modm::platform
{

bool
Flash::unlock()
{
%% for b in ([False, True] if bank2 else [False])
	if (const Bank bank({{ "true" if b else "false" }}); bank.CR() & FLASH_{{a}}CR_LOCK)
	{
		bank.KEYR() = 0x45670123;
		bank.KEYR() = 0xCDEF89AB;
	}
%% endfor
	return not isLocked();
}

uint32_t
Flash::erase(uint16_t sector)
{
	uint8_t *const addr = getAddr(sector);
	// The sectors of the second bank are numbered from zero again
	if (sector >= SectorsPerBank) sector -= SectorsPerBank;
	const uint32_t err = run(uintptr_t(addr), nullptr, nullptr, nullptr, FLASH_{{a}}CR_SER |
			((uint32_t(sector) << FLASH_{{a}}CR_SSN_Pos) & FLASH_{{a}}CR_SSN_Msk), {{ t_erase }});
	SCB_InvalidateDCache_by_Addr(addr, SectorSize);
	return err;
}

uint32_t
Flash::program(uintptr_t addr, MaxWordType data)
{
	const uint32_t err = run(addr, reinterpret_cast<volatile uint32_t *>(addr), data.data, data.data + 4,
							 FLASH_{{a}}CR_PG, {{ t_prog }});
	SCB_InvalidateDCache_by_Addr(reinterpret_cast<void *>(addr), sizeof(MaxWordType));
	return err;
}

uint32_t
Flash::program(uintptr_t addr, const void *data, size_t size)
{
	if ((addr | size) & (WriteSize - 1)) return uint32_t(-1);
	// A word damaged by a reset during programming never reads back correctly
	if (not targetErased(addr, size)) return uint32_t(-1);
	const uint8_t *src = static_cast<const uint8_t *>(data);
	while (size)
	{
		size_t step;
		uint32_t error;
		{
			MaxWordType word;
			std::memcpy(&word, src, sizeof(word));
			error = isErased(src, sizeof(word)) ? 0 : program(addr, word);
			step = sizeof(word);
		}
		if (error) return error;
		modm::this_fiber::yield();
		addr += step;
		src += step;
		size -= step;
	}
	return 0;
}

uint32_t
Flash::read(uintptr_t addr, void *buffer, size_t size)
{
	// A double ECC error raises a bus error, which is ignored at the priority of FAULTMASK
%% for b in ([False, True] if bank2 else [False])
	Bank({{ "true" if b else "false" }}).ICR() = FLASH_{{a}}ICR_DBECCERRF;
%% endfor
	const uint32_t faultmask = __get_FAULTMASK();
	const uint32_t ccr = SCB->CCR;
	__set_FAULTMASK(1);
	SCB->CCR = ccr | SCB_CCR_BFHFNMIGN_Msk;
	__DSB();
	__ISB();
	std::memcpy(buffer, reinterpret_cast<const void *>(addr), size);
	__DSB();
	SCB->CCR = ccr;
	__ISB();
	__set_FAULTMASK(faultmask);
	uint32_t error{0};
%% for b in ([False, True] if bank2 else [False])
	if (const Bank bank({{ "true" if b else "false" }}); bank.ISR() & FLASH_{{a}}ISR_DBECCERRF)
	{
		error |= FLASH_{{a}}ISR_DBECCERRF;
		bank.ICR() = FLASH_{{a}}ICR_DBECCERRF;
	}
%% endfor
	return error;
}

} // namespace modm::platform
