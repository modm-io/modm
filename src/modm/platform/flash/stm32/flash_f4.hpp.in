#pragma once
#include "../device.hpp"
#include <cstddef>
#include <cstdint>

namespace modm::platform
{

/// Flash controller of the STM32F2, STM32F4 and STM32F7.
///
/// The sectors are numbered continuously over both banks, the hardware sector
/// number of the second bank is computed internally.
/// @ingroup modm_platform_flash
class Flash
{
public:
	static constexpr uintptr_t OriginAddr{ 0x{{ "%0x" | format(start) }} };
	static constexpr size_t Size{ 0x{{ "%0x" | format(size) }} };
	/// Smallest page or sector of all flash organizations
	static constexpr size_t MinPageSize{ {{ min_page }} };
	/// Largest page or sector of all flash organizations
	static constexpr size_t MaxPageSize{ {{ max_page }} };
	static inline uint8_t *const Origin{(uint8_t*)OriginAddr};
	/// Value of every byte after erasing
	static constexpr uint8_t ErasedValue{ 0xff };
	using MaxWordType = uint32_t;
	/// Smallest unit that can be programmed in bytes (8-bit parallelism)
	static constexpr size_t WriteSize{ 1 };
%% if has_dcache
	/// Read-only alias of the flash on the ITCM interface
	static constexpr uintptr_t ItcmAddr{ 0x0020'0000 };
%% endif

	/// Program and erase parallelism, which depends on the supply voltage
	enum class
	WordSize : uint32_t
	{
		B8 = 0,
		B16 = FLASH_CR_PSIZE_0,
		B32 = FLASH_CR_PSIZE_1,
	};

	/// @return true if the device runs in dual-bank mode
	static bool
	isDualBank()
	{
%% if dual_option
		return {{ dual_option }};
%% else
		return false;
%% endif
	}

public:
	static void
	enable() {}

	static void
	disable() {}

	static bool
	isLocked()
	{ return FLASH->CR & FLASH_CR_LOCK; }

	static bool
	isBusy()
	{ return FLASH->SR & FLASH_SR_BSY; }

	static bool
	unlock();

	static void
	lock()
	{ FLASH->CR |= FLASH_CR_LOCK; }

	static uint16_t
	getSector(uint8_t *ptr)
	{
%% if has_dcache
		// Code and constants are linked to the read-only ITCM alias
		if (uintptr_t(ptr) < OriginAddr) return getSector(uintptr_t(ptr) - ItcmAddr + OriginAddr);
%% endif
		return getSector(uintptr_t(ptr));
	}

	/// @return the page or sector of the absolute address addr
	static uint16_t
	getSector(uintptr_t addr);

	static uint16_t
	getPage(uint8_t *ptr)
	{ return getSector(ptr); }

	static uint16_t
	getPage(uintptr_t addr)
	{ return getSector(addr); }

	static uint8_t*
	getAddr(uint16_t sector)
	{ return Origin + getOffset(sector); }

	static uint32_t
	getOffset(uint16_t sector);

	static size_t
	getSize(uint16_t sector);

	/// @return error flags, zero on success
	static uint32_t
	erase(uint16_t sector, WordSize size = WordSize::B32);

	static uint32_t
	program(uintptr_t addr, uint8_t data)
	{ return program(addr, data, WordSize::B8); }

	static uint32_t
	program(uintptr_t addr, uint16_t data)
	{ return program(addr, data, WordSize::B16); }

	/// @return error flags, zero on success
	static uint32_t
	program(uintptr_t addr, MaxWordType data, WordSize size = WordSize::B32);

	/// Programs size bytes of erased flash at addr with data.
	/// addr and size must be multiples of WriteSize. On flash with ECC the
	/// target must read as erased without ECC error, so that a word damaged
	/// by a reset during programming returns an error instead of faulting.
	/// @return error flags, zero on success, all bits set if misaligned or
	///         the target is not erased
	static uint32_t
	program(uintptr_t addr, const void *data, size_t size);

	/// Copies size bytes from the flash at addr into buffer without faulting on
	/// a flash word with a double ECC error, e.g. after a reset during programming.
	/// @return error flags, zero on success
	static uint32_t
	read(uintptr_t addr, void *buffer, size_t size);
};

} // namespace modm::platform
