#include "flash.hpp"
#include <modm/architecture/interface/atomic_lock.hpp>
#include <cstring>
#include <modm/architecture/utils.hpp>
#include <modm/architecture/interface/fiber.hpp>

extern "C" const uint8_t __rom_start[], __rom_end[];


%% if tick
extern "C" void SysTick_Handler();
%% endif

namespace
{

/// @return true if the program image is outside of [start, end), so that other
///         fibers can run from flash during an operation in this range
bool
outsideImage(uintptr_t start, uintptr_t end)
{
	uintptr_t rom_start = uintptr_t(__rom_start), rom_end = uintptr_t(__rom_end);
%% if has_dcache
	// Code and constants are linked to the read-only ITCM alias
	using Flash = modm::platform::Flash;
	if (rom_start < Flash::OriginAddr)
	{
		rom_start += Flash::OriginAddr - Flash::ItcmAddr;
		rom_end += Flash::OriginAddr - Flash::ItcmAddr;
	}
%% endif
	return rom_end <= start or end <= rom_start;
}

#ifdef FLASH_SR_PGSERR
constexpr uint32_t Errors = FLASH_SR_PGSERR |
#else
constexpr uint32_t Errors = FLASH_SR_ERSERR |
#endif
#ifdef FLASH_SR_OPERR
		FLASH_SR_OPERR |
#endif
		FLASH_SR_PGPERR | FLASH_SR_PGAERR | FLASH_SR_WRPERR;

struct Layout
{
	const uint8_t *shifts;
	uint8_t count;
	uint8_t banks;
};

%% if single
constexpr uint8_t Single[] = { {{ single | join(", ") }} };
%% endif
%% if dual
constexpr uint8_t Dual[] = { {{ dual | join(", ") }} };
%% endif

Layout
layout()
{
%% if dual and single
	if (modm::platform::Flash::isDualBank()) return {Dual, sizeof(Dual), 2};
	return {Single, sizeof(Single), 1};
%% elif dual
	return {Dual, sizeof(Dual), 2};
%% else
	return {Single, sizeof(Single), 1};
%% endif
}

/// Invalidates the caches of the flash interface, which may hold erased data
void
flushCaches([[maybe_unused]] uintptr_t addr, [[maybe_unused]] size_t size)
{
#if defined(FLASH_ACR_DCRST)
	const uint32_t acr = FLASH->ACR;
	// The caches must be disabled to reset them
	FLASH->ACR = acr & ~(FLASH_ACR_DCEN | FLASH_ACR_ICEN);
	FLASH->ACR = (acr & ~(FLASH_ACR_DCEN | FLASH_ACR_ICEN)) | FLASH_ACR_DCRST | FLASH_ACR_ICRST;
	FLASH->ACR = acr & ~(FLASH_ACR_DCRST | FLASH_ACR_ICRST);
#elif defined(FLASH_ACR_ARTRST)
	const uint32_t acr = FLASH->ACR;
	FLASH->ACR = acr & ~FLASH_ACR_ARTEN;
	FLASH->ACR = (acr & ~FLASH_ACR_ARTEN) | FLASH_ACR_ARTRST;
	FLASH->ACR = acr & ~FLASH_ACR_ARTRST;
#endif
%% if has_dcache
	SCB_InvalidateDCache_by_Addr(reinterpret_cast<void*>(addr), size);
%% endif
}

constexpr uint32_t Operation = FLASH_CR_PG | FLASH_CR_SER | FLASH_CR_SNB_Msk | FLASH_CR_PSIZE_Msk;
/// Not a CR bit: the operation is on the bank the program does not run from, so
/// interrupts are not masked and other fibers run during an erase
constexpr uint32_t Other = 1ul << 30;
static_assert(not (Operation & Other));

%% if basepri
/// Interrupts with handlers in flash stall during an operation on the bank of
/// the program and block all other interrupts, so only priority 0 interrupts,
/// whose vectors and handlers must be in RAM, may run.
struct Mask : modm::atomic::LockPriority
{
	modm_always_inline Mask() : LockPriority(1) {}
};
%% else
/// Interrupts with handlers in flash stall during an operation on the bank of
/// the program and block all other interrupts, so no interrupt may run.
using Mask = modm::atomic::Lock;
%% endif

%% if tick
/// Calls the SysTick handler in RAM, since no interrupt may run
modm_always_inline void
tick()
{
	if ((SysTick->CTRL & SysTick_CTRL_TICKINT_Msk) and (SCB->ICSR & SCB_ICSR_PENDSTSET_Msk))
	{
		SCB->ICSR = SCB_ICSR_PENDSTCLR_Msk;
		SysTick_Handler();
	}
}
%% endif


/// Sets the operation in CR, writes data to addr with the size of PSIZE or
/// starts an erase, and waits until the operation finished.
/// @return error flags, zero on success
template< bool other >
modm_always_inline uint32_t
operate(uintptr_t addr, uint32_t data, uint32_t cr, [[maybe_unused]] uint32_t typical)
{
	while (FLASH->SR & FLASH_SR_BSY) ;
	FLASH->SR = Errors | FLASH_SR_EOP;
	FLASH->CR = cr & Operation;
	if (cr & FLASH_CR_PG)
	{
		switch (cr & FLASH_CR_PSIZE_Msk)
		{
			case 0: *(volatile uint8_t *) addr = data; break;
			case FLASH_CR_PSIZE_0: *(volatile uint16_t *) addr = data; break;
			default: *(volatile uint32_t *) addr = data; break;
		}
	}
	else FLASH->CR |= FLASH_CR_STRT;
	__DSB();
%% if dual
	// Other fibers run from flash meanwhile, while the operation takes the
	// typical time, and until it finished
	if constexpr (other)
	{
%% if clock
		modm::this_fiber::sleep_for(std::chrono::microseconds(typical));
%% endif
		modm::this_fiber::poll([&] { return not (FLASH->SR & FLASH_SR_BSY); });
	}
	else
%% endif
	while (FLASH->SR & FLASH_SR_BSY) {{ "tick();" if tick else ";" }}
	const uint32_t err = FLASH->SR & Errors;
	FLASH->SR = Errors | FLASH_SR_EOP;
	FLASH->CR = 0;
	return err;
}

/// The only code that runs while the bank of the program is busy, therefore in
/// RAM with interrupts masked
modm_ramcode uint32_t
runMasked(uintptr_t addr, uint32_t data, uint32_t cr, uint32_t typical)
{
	const Mask mask;
	return operate<false>(addr, data, cr, typical);
}

uint32_t
run(uintptr_t addr, uint32_t data, uint32_t cr, uint32_t typical)
{
%% if dual
	// The other bank does not stall the program, so the operation runs from flash
	// without masking interrupts
	if (cr & Other) return operate<true>(addr, data, cr, typical);
%% endif
	return runMasked(addr, data, cr, typical);
}

/// @return true if all bytes have the erased value. Programming them does not
/// change the content, but on the L4 and U5 controllers a unit programmed with
/// all ones fails to program again, although it still reads as erased.
bool
isErased(const uint8_t *data, size_t size)
{
	for (; size; size--)
		if (*data++ != modm::platform::Flash::ErasedValue) return false;
	return true;
}

} // namespace

namespace modm::platform
{

bool
Flash::unlock()
{
	if (isLocked())
	{
		FLASH->KEYR = 0x45670123;
		FLASH->KEYR = 0xCDEF89AB;
	}
	return not isLocked();
}

uint16_t
Flash::getSector(uintptr_t addr)
{
	uintptr_t offset = addr - OriginAddr;
	const Layout l = layout();
	uint16_t index{0};
	for (uint8_t bank{0}; bank < l.banks; bank++)
	{
		for (uint8_t ii{0}; ii < l.count; ii++, index++)
		{
			const size_t size = 1ul << l.shifts[ii];
			if (offset < size) return index;
			offset -= size;
		}
	}
	return index;
}

uint32_t
Flash::getOffset(uint16_t sector)
{
	const Layout l = layout();
	uint32_t offset{0};
	for (uint16_t ii{0}; ii < sector; ii++)
		offset += 1ul << l.shifts[ii % l.count];
	return offset;
}

size_t
Flash::getSize(uint16_t sector)
{
	const Layout l = layout();
	return 1ul << l.shifts[sector % l.count];
}

uint32_t
Flash::erase(uint16_t sector, WordSize size)
{
	const Layout l = layout();
	// The sectors of the second bank are numbered from 16 onwards
	const uint32_t snb = (sector / l.count) * 16 + (sector % l.count);
	uint32_t cr = FLASH_CR_SER | uint32_t(size) | ((snb << FLASH_CR_SNB_Pos) & FLASH_CR_SNB_Msk);
	if (l.banks == 2)
	{
		const uintptr_t bank = OriginAddr + (sector / l.count) * (Size / 2);
		if (outsideImage(bank, bank + Size / 2)) cr |= Other;
	}
	// About 250ms for 16kB, 550ms for 64kB and 1s for 128kB sectors
	const uint32_t err = run(0, 0, cr, 200'000 + (getSize(sector) >> 10) * 6'250);
	flushCaches(OriginAddr + getOffset(sector), getSize(sector));
	return err;
}

uint32_t
Flash::program(uintptr_t addr, MaxWordType data, WordSize size)
{
	uint32_t cr = FLASH_CR_PG | uint32_t(size);
	if (const Layout l = layout(); l.banks == 2)
	{
		const uintptr_t bank = addr - OriginAddr < Size / 2 ? OriginAddr : OriginAddr + Size / 2;
		if (outsideImage(bank, bank + Size / 2)) cr |= Other;
	}
	const uint32_t err = run(addr, data, cr, {{ t_prog }});
%% if has_dcache
	SCB_InvalidateDCache_by_Addr(reinterpret_cast<void*>(addr), 4);
%% endif
	return err;
}

uint32_t
Flash::program(uintptr_t addr, const void *data, size_t size)
{
	if ((addr | size) & (WriteSize - 1)) return uint32_t(-1);
	const uint8_t *src = static_cast<const uint8_t *>(data);
	while (size)
	{
		size_t step;
		uint32_t error;
		// 32-bit parallelism is four times faster than bytes
		if (not (addr & 3) and size >= 4)
		{
			uint32_t word;
			std::memcpy(&word, src, 4);
			error = isErased(src, 4) ? 0 : program(addr, word, WordSize::B32);
			step = 4;
		}
		else
		{
			error = isErased(src, 1) ? 0 : program(addr, *src, WordSize::B8);
			step = 1;
		}
		if (error) return error;
		modm::this_fiber::yield();
		addr += step;
		src += step;
		size -= step;
	}
	return 0;
}

uint32_t
Flash::read(uintptr_t addr, void *buffer, size_t size)
{
	// This flash has no ECC
	std::memcpy(buffer, reinterpret_cast<const void *>(addr), size);
	return 0;
}

} // namespace modm::platform
