def init(module):
    module.name = ":platform:sysboot"
    module.description = FileReader("module.md")

def prepare(module, options):
    # Only devices that can jump into their bootloader have an entry address
    if "entry" not in (options[":target"].get_driver("sysboot:stm32") or {}):
        return False
    module.depends(":cmsis:device", ":platform:core")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/platform/sysboot"
    target = env[":target"].identifier
    core = env[":target"].get_driver("core")["type"]
    sysboot = env[":target"].get_driver("sysboot:stm32")
    remap = None
    if target.family in ["c0", "f0", "f3", "g0", "l0", "u0"]: remap = "CFGR1"
    if target.family in ["f2", "f4", "g4", "l1", "l4", "wb", "wl"]: remap = "MEMRMP"
    env.substitutions = {
        "target": target,
        "core": core,
        "address": int(sysboot["entry"], 16),
        "id_address": int(sysboot["id-address"], 16) if "id-address" in sysboot else None,
        "remap": remap,
        # Boot_V3_2 cannot start every application with Go (AN2606 §4.10)
        "reset_on_exit": target.family == "h5",
        "with_msplim": sum(c.isnumeric() for c in core) == 2,
        "enable_icache": env.get(":platform:cortex-m:enable_icache", False),
        "enable_dcache": env.get(":platform:cortex-m:enable_dcache", False),
        "enable_stm32_icache": env.get(":platform:core:enable_icache", False),
    }
    env.copy("bootloader.hpp")
    env.template("bootloader.cpp.in")
