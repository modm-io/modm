%% if id == ""
#include "can.hpp"
%% else
#include "can_{{ id }}.hpp"
%% endif

// ----------------------------------------------------------------------------
// CAN bit timing register (CAN_BTR)
#define CAN_BTR_SJW_POS		24
#define CAN_BTR_TS2_POS		20
#define CAN_BTR_TS1_POS		16

// ----------------------------------------------------------------------------
%% if options["buffer.tx"] > 0
static modm::platform::CanTxQueue<{{ options["buffer.tx"] }}> txQueue;
static void sendQueuedMessages();
%% endif

struct RxMessage {
    modm::can::Message message;
    uint8_t filter_id;
};
%% if options["buffer.rx"] > 0
static modm::atomic::Queue<RxMessage, {{ options["buffer.rx"] }}> rxQueue;
%% endif


// ----------------------------------------------------------------------------
bool
modm::platform::Can{{ id }}::initializeWithPrescaler(
		uint16_t prescaler, uint8_t bs1, uint8_t bs2,
		uint32_t interruptPriority, Mode startupMode, bool overwriteOnOverrun)
{
%% macro enable_reset(instance)
	Rcc::enable<Peripheral::Can{{ instance }}>();
%% endmacro
%% if type == "Slave"
	// enable and reset master if disabled
	if (not Rcc::isEnabled<Peripheral::Can{{ other_instance }}>()) {
	{{ enable_reset(other_instance) | lbuild.indent(4) }}
	}
%% endif
%% if type == "Master"
	// skip enable and reset if device has already been enabled by slave
	if (not Rcc::isEnabled<Peripheral::Can{{ own_instance }}>()) {
	{{ enable_reset(own_instance) | lbuild.indent(4) }}
	}
%% else
	{{ enable_reset(id) }}
%% endif

	// CAN Master Reset
	// FMP bits and CAN_MCR register are initialized to the reset values
	{{ reg }}->MCR |= CAN_MCR_RESET;
	while ({{ reg }}->MCR & CAN_MCR_RESET)
		;

	// Bus off is left automatically by the hardware after 128 occurrences
	// of 11 recessive bits. The mailboxes are sent in the order of request
	// (TXFP), since in priority mode the mailboxes of frames with the same
	// identifier are sent in the order of their number, which could reorder
	// them. The software queue is sorted by priority instead.
	// Without overwrite (RFLM) a full receive FIFO discards the next frame.
	// Request the initialization mode in the same write that leaves the sleep
	// mode, since leaving it alone would start the normal mode with the reset
	// bit timing after 11 recessive bits.
	{{ reg }}->MCR = ({{ reg }}->MCR & ~CAN_MCR_SLEEP) | CAN_MCR_INRQ | CAN_MCR_ABOM | CAN_MCR_TXFP |
			(overwriteOnOverrun ? 0 : CAN_MCR_RFLM);
	int deadlockPreventer = 50'000; // max ~50ms, two frames at 10 kbit/s
	while ((({{ reg }}->MSR & (CAN_MSR_INAK | CAN_MSR_SLAK)) != CAN_MSR_INAK) and (deadlockPreventer-- > 0)) {
		modm::delay_us(1);
		// Wait until the initialization mode is entered.
		// The CAN hardware waits until the current CAN activity (transmission
		// or reception) is completed before entering the initialization mode.
	}
	if (deadlockPreventer < 0)
		return false;

	// Enable Interrupts:
	// FIFO1 Overrun, FIFO0 Overrun
	{{ reg }}->IER = CAN_IER_FOVIE1 | CAN_IER_FOVIE0;

%% if options["buffer.tx"] > 0
	{{ reg }}->IER |= CAN_IER_TMEIE;
%% endif

%% if target["family"] == "f0"
	// Set vector priority
	NVIC_SetPriority(CEC_CAN_IRQn, interruptPriority);

	// Register Interrupts at the NVIC
	NVIC_EnableIRQ(CEC_CAN_IRQn);
%% else
	// Set vector priority
	NVIC_SetPriority({{ irqs.rx0 }}_IRQn, interruptPriority);
	NVIC_SetPriority({{ irqs.rx1 }}_IRQn, interruptPriority);

	// Register Interrupts at the NVIC
	NVIC_EnableIRQ({{ irqs.rx0 }}_IRQn);
	NVIC_EnableIRQ({{ irqs.rx1 }}_IRQn);

	%% if options["buffer.tx"] > 0
	NVIC_SetPriority({{ irqs.tx }}_IRQn, interruptPriority);
	NVIC_EnableIRQ({{ irqs.tx }}_IRQn);
	%% endif
%% endif



%% if options["buffer.rx"] > 0
	{{ reg }}->IER |= CAN_IER_FMPIE1 | CAN_IER_FMPIE0;
%% endif

	{{ reg }}->BTR =
			  ((1 - 1) << CAN_BTR_SJW_POS) |		// SJW (1 to 4 possible)
			((bs2 - 1) << CAN_BTR_TS2_POS) |		// BS2 Samplepoint
			((bs1 - 1) << CAN_BTR_TS1_POS) |		// BS1 Samplepoint
			static_cast<uint32_t>(startupMode) |
			(prescaler - 1);

	// Request leave initialization
	{{ reg }}->MCR &= ~(uint32_t)CAN_MCR_INRQ;
	deadlockPreventer = 50'000; // max ~50ms, two frames at 10 kbit/s
	while ((({{ reg }}->MSR & CAN_MSR_INAK) == CAN_MSR_INAK) and (deadlockPreventer-- > 0))  {
		// wait for the normal mode, which needs 11 recessive bits on the bus
		modm::delay_us(1);
	}
%% if options["buffer.tx"] > 0
	{
		// The master reset emptied the mailboxes
		modm::atomic::Lock lock;
		sendQueuedMessages();
	}
%% endif
	return deadlockPreventer >= 0;
}

// ----------------------------------------------------------------------------
// Configure the mailbox to send a CAN message.
// Low level function called by sendMessage and by Tx Interrupt.
static void
sendMailbox(const modm::can::Message& message, uint32_t mailboxId)
{
	CAN_TxMailBox_TypeDef* mailbox = &{{ reg }}->sTxMailBox[mailboxId];

	if (message.isExtended()) {
		mailbox->TIR = message.identifier << 3 | CAN_TI0R_IDE;
	}
	else {
		mailbox->TIR = message.identifier << 21;
	}

	if (message.isRemoteTransmitRequest()) {
		mailbox->TIR |= CAN_TI0R_RTR;
	}

	// Set up the DLC
	mailbox->TDTR = message.getDataLengthCode();

	// Set up the data field (copy the 8x8-bits into two 32-bit registers)
	const uint8_t * modm_may_alias data = message.data;
	mailbox->TDLR = reinterpret_cast<const uint32_t *>(data)[0];
	mailbox->TDHR = reinterpret_cast<const uint32_t *>(data)[1];

	// Request transmission
	mailbox->TIR |= CAN_TI0R_TXRQ;
}

// ----------------------------------------------------------------------------
// Low level function to receive a message from mailbox.
// Called by Rx Interrupt or by getMessage.
static void
readMailbox(modm::can::Message& message, uint32_t mailboxId, uint8_t* filter_id)
{
	CAN_FIFOMailBox_TypeDef* mailbox = &{{ reg }}->sFIFOMailBox[mailboxId];

	uint32_t rir = mailbox->RIR;
	if (rir & CAN_RI0R_IDE) {
		message.identifier = rir >> 3;
		message.setExtended();
	}
	else {
		message.identifier = rir >> 21;
		message.setExtended(false);
	}
	message.setRemoteTransmitRequest(rir & CAN_RI0R_RTR);
	// Classic CAN frames with a DLC above 8 carry 8 data bytes
	message.setDataLengthCode(std::min<uint32_t>(mailbox->RDTR & CAN_TDT1R_DLC, 8));
	message.setFlexibleData(false);
	message.setBitRateSwitching(false);
	if(filter_id != nullptr)
        (*filter_id) = (mailbox->RDTR & CAN_RDT1R_FMI) >> CAN_RDT1R_FMI_Pos;

	uint8_t * modm_may_alias data = message.data;
	reinterpret_cast<uint32_t *>(data)[0] = mailbox->RDLR;
	reinterpret_cast<uint32_t *>(data)[1] = mailbox->RDHR;
}

// ----------------------------------------------------------------------------
static bool
hasEmptyMailbox()
{
	return {{ reg }}->TSR & (CAN_TSR_TME0 | CAN_TSR_TME1 | CAN_TSR_TME2);
}

%% if options["buffer.tx"] > 0
// Moves frames from the software queue into the empty mailboxes.
// Must be called with interrupts disabled.
static void
sendQueuedMessages()
{
	while (txQueue.isNotEmpty() and hasEmptyMailbox()) {
		sendMailbox(txQueue.get(), ({{ reg }}->TSR & CAN_TSR_CODE) >> CAN_TSR_CODE_Pos);
		txQueue.pop();
	}
}
%% endif

// ----------------------------------------------------------------------------
/* Transmit Interrupt
 *
 * Generated when Transmit Mailbox 0..2 becomes empty.
 */
%% if combined_isr
void MODM_ISR_NAME({{ irqs.tx }})()
%% else
MODM_ISR({{ irqs.tx }})
%% endif
{
%% if options["buffer.tx"] > 0
	// acknowledge all completed requests, then fill all empty mailboxes
	{{ reg }}->TSR = CAN_TSR_RQCP0 | CAN_TSR_RQCP1 | CAN_TSR_RQCP2;
	// sendMessage() may be called from a higher priority interrupt
	modm::atomic::Lock lock;
	sendQueuedMessages();
%% endif
}

// ----------------------------------------------------------------------------
/* FIFO0 Interrupt
 *
 * Generated on a new received message, FIFO0 full condition and Overrun
 * Condition.
 */
%% if combined_isr
void MODM_ISR_NAME({{ irqs.rx0 }})()
%% else
MODM_ISR({{ irqs.rx0 }})
%% endif
{
	if (not modm_assert_continue_ignore(not ({{ reg }}->RF0R & CAN_RF0R_FOVR0),
			"can.rx.hw0", "CAN receive hardware buffer overflowed!", {{ 0 if id == '' else id }}))
	{
		// only clear the overrun flag, the FIFO still holds three frames
		{{ reg }}->RF0R = CAN_RF0R_FOVR0;
	}

%% if options["buffer.rx"] > 0
	// the overrun interrupt may run without a frame
	if ({{ reg }}->RF0R & CAN_RF0R_FMP0)
	{
		if (rxQueue.isFull())
		{
			// Leave the frames in the hardware FIFO until getMessage() makes room
			// in the rxQueue and enables this interrupt again.
			{{ reg }}->IER &= ~CAN_IER_FMPIE0;
			// unless getMessage() made room meanwhile in a higher priority interrupt
			if (rxQueue.isNotFull()) {{ reg }}->IER |= CAN_IER_FMPIE0;
		}
		else
		{
			RxMessage rxMessage;
			readMailbox(rxMessage.message, 0, &(rxMessage.filter_id));

			// Release FIFO (access the next message)
			{{ reg }}->RF0R = CAN_RF0R_RFOM0;
			rxQueue.push(rxMessage);
		}
	}
%% endif
}

// ----------------------------------------------------------------------------
/* FIFO1 Interrupt
 *
 * See FIFO0 Interrupt
 */
%% if combined_isr
void MODM_ISR_NAME({{ irqs.rx1 }})()
%% else
MODM_ISR({{ irqs.rx1 }})
%% endif
{
	if (not modm_assert_continue_ignore(not ({{ reg }}->RF1R & CAN_RF1R_FOVR1),
			"can.rx.hw1", "CAN receive hardware buffer overflowed!", {{ 0 if id == '' else id }}))
	{
		// only clear the overrun flag, the FIFO still holds three frames
		{{ reg }}->RF1R = CAN_RF1R_FOVR1;
	}

%% if options["buffer.rx"] > 0
	// the overrun interrupt may run without a frame
	if ({{ reg }}->RF1R & CAN_RF1R_FMP1)
	{
		if (rxQueue.isFull())
		{
			// Leave the frames in the hardware FIFO until getMessage() makes room
			// in the rxQueue and enables this interrupt again.
			{{ reg }}->IER &= ~CAN_IER_FMPIE1;
			// unless getMessage() made room meanwhile in a higher priority interrupt
			if (rxQueue.isNotFull()) {{ reg }}->IER |= CAN_IER_FMPIE1;
		}
		else
		{
			RxMessage rxMessage;
			readMailbox(rxMessage.message, 1, &(rxMessage.filter_id));

			// Release FIFO (access the next message)
			{{ reg }}->RF1R = CAN_RF1R_RFOM1;
			rxQueue.push(rxMessage);
		}
	}
%% endif
}

%% if combined_isr
// On stm32f0, ST has decided to use only one interrupt vector for all
// CAN interrupts. In order to avoide duplicate code, we try to determine
// the interrupt source and call the correct interrupts function defined above.
// Sources for the different interrupts are specified in the Reference Manual
// in the "bxCAN interrupts" section.
// The status change interrupt shares the vector with the other interrupts,
// so this handler is called instead. It must clear the flags of the enabled
// status change interrupts, which this default handler does. Not MODM_ISR(),
// since CAN_SCE is not in the vector table.
MODM_ISR_DECL(CAN_SCE) modm_weak;
void
MODM_ISR_NAME(CAN_SCE)()
{
	{{ reg }}->MSR = CAN_MSR_ERRI | CAN_MSR_WKUI | CAN_MSR_SLAKI;
}

MODM_ISR(CEC_CAN)
{
	if({{ reg }}->TSR & (CAN_TSR_RQCP0 | CAN_TSR_RQCP1 | CAN_TSR_RQCP2)) {
		MODM_ISR_NAME({{ irqs.tx }})();
	}

	if({{ reg }}->RF0R & (CAN_RF0R_FMP0 | CAN_RF0R_FULL0 | CAN_RF0R_FOVR0)) {
		MODM_ISR_NAME({{ irqs.rx0 }})();
	}

	if({{ reg }}->RF1R & (CAN_RF1R_FMP1 | CAN_RF1R_FULL1 | CAN_RF1R_FOVR1)) {
		MODM_ISR_NAME({{ irqs.rx1 }})();
	}

	if({{ reg }}->MSR & (CAN_MSR_ERRI | CAN_MSR_WKUI | CAN_MSR_SLAKI)) {
		MODM_ISR_NAME(CAN_SCE)();
	}
}
%% endif

// ----------------------------------------------------------------------------
void
modm::platform::Can{{ id }}::setMode(Mode mode)
{
	// Request initialization
	{{ reg }}->MCR |= CAN_MCR_INRQ;
	int deadlockPreventer = 50'000; // max ~50ms, two frames at 10 kbit/s
	while ((({{ reg }}->MSR & CAN_MSR_INAK) == 0) and (deadlockPreventer-- > 0)) {
		modm::delay_us(1);
		// Wait until the initialization mode is entered.
		// The CAN hardware waits until the current CAN activity (transmission
		// or reception) is completed before entering the initialization mode.
	}

	// BTR is write-protected outside of the initialization mode
	if (deadlockPreventer >= 0) {
		{{ reg }}->BTR = ({{ reg }}->BTR & ~(CAN_BTR_SILM | CAN_BTR_LBKM))
							| static_cast<uint32_t>(mode);
	}

	// Leave initialization mode, which needs 11 recessive bits on the bus
	{{ reg }}->MCR &= ~CAN_MCR_INRQ;
	deadlockPreventer = 50'000; // max ~50ms, two frames at 10 kbit/s
	while ((({{ reg }}->MSR & CAN_MSR_INAK) == CAN_MSR_INAK) and (deadlockPreventer-- > 0)) {
		modm::delay_us(1);
	}
}

// ----------------------------------------------------------------------------
void
modm::platform::Can{{ id }}::setAutomaticRetransmission(bool retransmission)
{
	if (retransmission) {
		// Enable retransmission
		{{ reg }}->MCR = ({{ reg }}->MCR & ~CAN_MCR_NART);
	} else {
		// Disable retransmission
		{{ reg }}->MCR = ({{ reg }}->MCR | CAN_MCR_NART);
	}
}

// ----------------------------------------------------------------------------
bool
modm::platform::Can{{ id }}::isMessageAvailable()
{
%% if options["buffer.rx"] > 0
	return rxQueue.isNotEmpty();
%% else
	// Check if there are any messages pending in the receive registers
	return (({{ reg }}->RF0R & CAN_RF0R_FMP0) > 0 || ({{ reg }}->RF1R & CAN_RF1R_FMP1) > 0);
%% endif
}

// ----------------------------------------------------------------------------
bool
modm::platform::Can{{ id }}::getMessage(can::Message& message, uint8_t *filter_id)
{
%% if options["buffer.rx"] > 0
	if (rxQueue.isEmpty())
	{
		// no message in the receive buffer
		return false;
	}
	else {
        auto& rxMessage = rxQueue.get();
		message = rxMessage.message;

        if(filter_id != nullptr) (*filter_id) = rxMessage.filter_id;
		rxQueue.pop();
		// The RX interrupts are disabled while the rxQueue is full. They are
		// level-triggered, so enabling them reads the waiting frames.
		constexpr uint32_t fmpie = CAN_IER_FMPIE0 | CAN_IER_FMPIE1;
		if (({{ reg }}->IER & fmpie) != fmpie) {
			modm::atomic::Lock lock;
			{{ reg }}->IER |= fmpie;
		}
		return true;
	}
%% else
	if (({{ reg }}->RF0R & CAN_RF0R_FMP0) > 0)
	{
		readMailbox(message, 0, filter_id);

		// Release FIFO (access the next message)
		{{ reg }}->RF0R = CAN_RF0R_RFOM0;
		return true;
	}
	else if (({{ reg }}->RF1R & CAN_RF1R_FMP1) > 0)
	{
		readMailbox(message, 1, filter_id);

		// Release FIFO (access the next message)
		{{ reg }}->RF1R = CAN_RF1R_RFOM1;
		return true;
	}
	return false;
%% endif
}

// ----------------------------------------------------------------------------
bool
modm::platform::Can{{ id }}::isReadyToSend()
{
%% if options["buffer.tx"] > 0
	if (txQueue.isFull()) {
		// A reinitialization empties the mailboxes without TX interrupt
		modm::atomic::Lock lock;
		sendQueuedMessages();
	}
	return txQueue.isNotFull();
%% else
	return hasEmptyMailbox();
%% endif
}

// ----------------------------------------------------------------------------
bool
modm::platform::Can{{ id }}::sendMessage(const can::Message& message)
{
	// bxCAN only supports Classic CAN with up to 8 data bytes
	if (message.isFlexibleData() or message.getDataLengthCode() > 8) return false;
%% if options["buffer.tx"] > 0
	bool success{true};
	{
		// Keep the TX interrupt from changing the mailboxes and the queue.
		// Disabling the interrupt in the peripheral is not enough, since the
		// NVIC may already have latched it as pending.
		modm::atomic::Lock lock;
		// A mailbox may be empty if the TX interrupt is still pending, or
		// after a reinitialization emptied them without TX interrupt
		sendQueuedMessages();
		// Only bypass the software queue when it is empty, so that frames stay in order
		if (txQueue.isEmpty() and hasEmptyMailbox()) {
			sendMailbox(message, ({{ reg }}->TSR & CAN_TSR_CODE) >> CAN_TSR_CODE_Pos);
		}
		else success = txQueue.push(message);
	}
	return success;
%% else
	if (not hasEmptyMailbox()) return false;
	sendMailbox(message, ({{ reg }}->TSR & CAN_TSR_CODE) >> CAN_TSR_CODE_Pos);
	return true;
%% endif
}

// ----------------------------------------------------------------------------
modm::platform::Can{{ id }}::BusState
modm::platform::Can{{ id }}::getBusState()
{
	if ({{ reg }}->ESR & CAN_ESR_BOFF) {
		return BusState::Off;
	}
	else if ({{ reg }}->ESR & CAN_ESR_EPVF) {
		return BusState::ErrorPassive;
	}
	else if ({{ reg }}->ESR & CAN_ESR_EWGF) {
		return BusState::ErrorWarning;
	}
	else {
		return BusState::Connected;
	}
}

// ----------------------------------------------------------------------------
void
modm::platform::Can{{ id }}::enableStatusChangeInterrupt(
		uint32_t interruptEnable,
%% if target["family"] == "f0"
		uint32_t
%% else
		uint32_t interruptPriority
%% endif
)
{
%% if target["family"] != "f0"
	NVIC_SetPriority({{ reg }}_SCE_IRQn, interruptPriority);
	NVIC_EnableIRQ({{ reg }}_SCE_IRQn);
%% endif

	{{ reg }}->IER = interruptEnable | ({{ reg }}->IER & 0x000000ff);
}

// ----------------------------------------------------------------------------
%% set filter_reg = "CAN1" if type == "Slave" else reg
%% if type == "Single"
static constexpr uint8_t firstFilterBank() { return 0; }
static constexpr uint8_t endFilterBank() { return 14; }
%% else
static uint8_t
startFilterBankCan2()
{
	return (CAN1->FMR & CAN_FMR_CAN2SB_Msk) >> CAN_FMR_CAN2SB_Pos;
}
	%% if type == "Master"
static uint8_t firstFilterBank() { return 0; }
static uint8_t endFilterBank() { return startFilterBankCan2(); }
	%% else
static uint8_t firstFilterBank() { return startFilterBankCan2(); }
static uint8_t endFilterBank() { return 28; }
	%% endif
%% endif

// The filter registers of CAN2 are the ones of CAN1, CAN3 has its own.
// Changing a filter stops the reception of all instances sharing the filter
// registers for a moment.
static bool
setFilterBank(uint8_t index, uint8_t fifo, uint32_t fr1, uint32_t fr2)
{
	const uint8_t bank = firstFilterBank() + index;
	if (index >= 14 or bank >= endFilterBank()) return false;
	const uint32_t bit = 1ul << bank;

	modm::atomic::Lock lock;
	{{ filter_reg }}->FMR |= CAN_FMR_FINIT;
	{{ filter_reg }}->FA1R &= ~bit;
	{{ filter_reg }}->FM1R &= ~bit;	// mask mode
	{{ filter_reg }}->FS1R |= bit;	// single 32-bit scale
	if (fifo) {{ filter_reg }}->FFA1R |= bit;
	else {{ filter_reg }}->FFA1R &= ~bit;
	{{ filter_reg }}->sFilterRegister[bank].FR1 = fr1;
	{{ filter_reg }}->sFilterRegister[bank].FR2 = fr2;
	{{ filter_reg }}->FA1R |= bit;
	{{ filter_reg }}->FMR &= ~CAN_FMR_FINIT;
	return true;
}

bool
modm::platform::Can{{ id }}::setStandardFilter(uint8_t standardIndex, FilterConfig config,
		modm::can::StandardIdentifier id, modm::can::StandardMask mask)
{
	// standard data and remote frames, like the FDCAN filters
	return setFilterBank(standardIndex, uint8_t(config),
			uint32_t(uint16_t(id) & 0x7ff) << 21,
			(uint32_t(uint16_t(mask) & 0x7ff) << 21) | CAN_TI0R_IDE);
}

bool
modm::platform::Can{{ id }}::setExtendedFilter(uint8_t extendedIndex, FilterConfig config,
		modm::can::ExtendedIdentifier id, modm::can::ExtendedMask mask)
{
	// extended data and remote frames, like the FDCAN filters
	return setFilterBank(extendedIndex, uint8_t(config),
			((uint32_t(id) & 0x1fff'ffff) << 3) | CAN_TI0R_IDE,
			((uint32_t(mask) & 0x1fff'ffff) << 3) | CAN_TI0R_IDE);
}

void
modm::platform::Can{{ id }}::clearStandardFilters()
{
	uint32_t bits{};
	for (uint8_t bank = firstFilterBank(); bank < endFilterBank(); bank++) bits |= 1ul << bank;
	modm::atomic::Lock lock;
	{{ filter_reg }}->FMR |= CAN_FMR_FINIT;
	{{ filter_reg }}->FA1R &= ~bits;
	{{ filter_reg }}->FMR &= ~CAN_FMR_FINIT;
}

void
modm::platform::Can{{ id }}::clearExtendedFilters()
{
	clearStandardFilters();
}
