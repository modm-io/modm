def init(module):
    module.name = ":platform:eth.common"
    module.description = "Common Ethernet DMA descriptor and ring support"


def prepare(module, options):
    module.depends(":architecture:ethernet")
    return True


def build(env):
    env.outbasepath = "modm/src/modm/platform/eth"
    env.copy("eth_descriptor.hpp")
    env.copy("eth_storage.hpp")
    env.copy("eth_ring.hpp")
