def init(module):
    module.name = ":platform:iwdg"
    module.description = """
# Independent Watchdog (IWDG)

`Iwdg::initialize()` configures and starts the watchdog. Call it once after
reset, when the application is ready to call `Iwdg::trigger()` periodically:

```cpp
Iwdg::initialize<SystemClock, 4s>();
while (true)
{
    do_work();
    Iwdg::trigger();
}
```

Once started, the watchdog can only be stopped by a reset. The prescaler and
reload value remain writable, so calling `initialize()` again while it is
running changes the timeout.

On the STM32F429, both a software reset and a pin reset stop the watchdog. If
the hardware watchdog option byte is set, it starts again after every reset.
"""


def prepare(module, options):
    device = options[":target"]

    module.depends(":ext:cmsis:device", ":math:algorithm")
    return device.has_driver("iwdg:stm32")


def build(env):
    env.outbasepath = "modm/src/modm/platform/iwdg"
    target = env[":target"].identifier
    # H7R/S has a single IWDG, the dual-core devices have one per core
    instance = ""
    if target.family == "h7" and target.name[0] not in ["p", "r", "s"]:
        instance = 2 if target.get("core") == "m4" else 1
    env.substitutions = {"core": instance}
    env.template("iwdg.hpp.in")
