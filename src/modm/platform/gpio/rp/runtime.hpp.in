#pragma once

#include "../device.hpp"
#include "base.hpp"
#include "unused.hpp"
#include <bit>
#include <concepts>

namespace modm::platform
{

/**
 * Runtime GPIO pin: the bank and the pin mask as a value.
 *
 * A value type that can be copied, stored in constexpr tables and selected at
 * runtime. Construct it from a static GPIO class, also an inverted one, or from
 * a port and a pin number.
 *
 * Only pins of this device, for `GpioUnused` see `modm::AnyGpio`.
 *
 * @ingroup modm_platform_gpio
 */
class GpioPin : public Gpio
{
protected:
	static constexpr uint8_t SioFunc = 5;

	uintptr_t addr;		///< (port << 2) | (inverted << 1), bit 0 is always clear
	uint32_t setBits;	///< The physical pin mask

	constexpr GpioPin(uintptr_t addr, uint32_t setBits) : addr(addr), setBits(setBits) {}

	constexpr bool inverted() const { return addr & 2u; }
	uint8_t index() const { return std::countr_zero(setBits); }

	/// Calls the function with the register accessors of this pin's bank
	template< class Function >
	decltype(auto)
	regs(Function &&function) const
	{
		switch(Port(addr >> 2))
		{
%% for port in ports
			case Port::{{port}}: return function(PortRegs<Port::{{port}}>{});
%% endfor
		}
		__builtin_unreachable();
	}

public:
	constexpr GpioPin(Port port, uint8_t pin, bool inverted = false)
	:	addr((uintptr_t(port) << 2) | (inverted ? 2u : 0u)), setBits(1ul << (pin & 31)) {}

	template< class Pin >
	requires requires { Pin::port; Pin::pin; Pin::isInverted; }
		and (not std::derived_from<Pin, GpioUnused>)
	constexpr GpioPin(Pin)
	:	GpioPin(Pin::port, Pin::pin, Pin::isInverted) {}

	void
	setOutput() const
	{
		disconnect();
		regs([&](auto r) { r.sio_oe_set(setBits); });
	}

	/// The level is written first, so that the pin never glitches.
	void
	setOutput(bool value) const
	{
		set(value);
		setOutput();
	}

	void
	setOutput(OutputType type, SlewRate speed = SlewRate::Slow) const
	{
		setOutput();
		configure(type, speed);
	}

	void
	configure(OutputType, SlewRate speed = SlewRate::Slow) const
	{ regs([&](auto r) { r.set_slewrate(index(), uint8_t(speed)); }); }

	void setInput() const { setInput(InputType::Floating); }

	void
	setInput(InputType type) const
	{
		regs([&](auto r) { r.sio_oe_clr(setBits); });
		configure(type);
	}

	void
	configure(InputType type) const
	{
		regs([&](auto r)
		{ r.set_pue_pde(index(), type == InputType::PullUp, type == InputType::PullDown); });
	}

	::modm::Gpio::Direction
	getDirection() const
	{
		using Direction = ::modm::Gpio::Direction;
		return regs([&](auto r)
		{
			if (r.funcsel(index()) != SioFunc) return Direction::Special;
			return (r.sio_oe() & setBits) ? Direction::Out : Direction::In;
		});
	}

	/// Back to the SIO function, detached from any peripheral signal
	void
	disconnect() const
	{ regs([&](auto r) { r.set_funcsel(index(), SioFunc); }); }

	void set() const { set(true); }
	void reset() const { set(false); }

	void
	set(bool value) const
	{
		regs([&](auto r)
		{
			if (value != inverted()) r.sio_set(setBits);
			else r.sio_clr(setBits);
		});
	}

	void toggle() const { regs([&](auto r) { r.sio_togl(setBits); }); }

	bool
	isSet() const
	{ return regs([&](auto r) { return bool(r.sio_out() & setBits) != inverted(); }); }

	bool
	read() const
	{ return regs([&](auto r) { return bool(r.sio_in() & setBits) != inverted(); }); }
};

} // namespace modm::platform
