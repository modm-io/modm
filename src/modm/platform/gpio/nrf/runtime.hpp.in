#pragma once

#include "../device.hpp"
#include "base.hpp"
#include "unused.hpp"
#include <bit>
#include <concepts>

namespace modm::platform
{

/**
 * Runtime GPIO pin: the port and the pin mask as a value.
 *
 * A value type that can be copied, stored in constexpr tables and selected at
 * runtime. Construct it from a static GPIO class, also an inverted one, or from
 * a port and a pin number.
 *
 * Only pins of this device, for `GpioUnused` see `modm::AnyGpio`.
 *
 * @ingroup modm_platform_gpio
 */
class GpioPin : public Gpio
{
protected:
	uintptr_t addr;		///< (port << 2) | (inverted << 1), bit 0 is always clear
	uint32_t setBits;	///< The physical pin mask

	constexpr GpioPin(uintptr_t addr, uint32_t setBits) : addr(addr), setBits(setBits) {}

	constexpr bool inverted() const { return addr & 2u; }

	NRF_GPIO_Type*
	reg() const
	{
		switch(Port(addr >> 2))
		{
%% for port in ports
			case Port::{{port}}: return NRF_{{port}};
%% endfor
		}
		__builtin_unreachable();
	}

	volatile uint32_t&
	cnf() const { return reg()->PIN_CNF[std::countr_zero(setBits)]; }

public:
	constexpr GpioPin(Port port, uint8_t pin, bool inverted = false)
	:	addr((uintptr_t(port) << 2) | (inverted ? 2u : 0u)), setBits(1ul << (pin & 31)) {}

	template< class Pin >
	requires requires { Pin::port; Pin::pin; Pin::isInverted; }
		and (not std::derived_from<Pin, GpioUnused>)
	constexpr GpioPin(Pin)
	:	GpioPin(Pin::port, Pin::pin, Pin::isInverted) {}

	void setOutput() const { reg()->DIRSET = setBits; }

	/// The level is written first, so that the pin never glitches.
	void
	setOutput(bool value) const
	{
		set(value);
		setOutput();
	}

	void
	setOutput(OutputType type) const
	{
		configure(type);
		setOutput();
	}

	void
	configure(OutputType type) const
	{
		cnf() = (cnf() & ~(GPIO_PIN_CNF_INPUT_Msk | GPIO_PIN_CNF_DRIVE_Msk))
			| (i(Input::Connect) << GPIO_PIN_CNF_INPUT_Pos)
			| (i(type) << GPIO_PIN_CNF_DRIVE_Pos);
	}

	void setInput() const { reg()->DIRCLR = setBits; }

	void
	setInput(InputType type) const
	{
		configure(type);
		setInput();
	}

	void
	configure(InputType type) const
	{
		const Pull pull = (type == InputType::PullUp) ? Pull::Pullup :
						  (type == InputType::PullDown) ? Pull::Pulldown : Pull::Disabled;
		cnf() = (cnf() & ~(GPIO_PIN_CNF_INPUT_Msk | GPIO_PIN_CNF_PULL_Msk))
			| (i(Input::Connect) << GPIO_PIN_CNF_INPUT_Pos)
			| (i(pull) << GPIO_PIN_CNF_PULL_Pos);
	}

	::modm::Gpio::Direction
	getDirection() const
	{
		using Direction = ::modm::Gpio::Direction;
		return (reg()->DIR & setBits) ? Direction::Out : Direction::In;
	}

	/// Back to an input with a disconnected input buffer
	void
	disconnect() const
	{
		cnf() = (i(Dir::Input) << GPIO_PIN_CNF_DIR_Pos)
			| (i(Input::Disconnect) << GPIO_PIN_CNF_INPUT_Pos)
			| (i(Pull::Disabled) << GPIO_PIN_CNF_PULL_Pos)
			| (i(OutputType::PushPull) << GPIO_PIN_CNF_DRIVE_Pos)
			| (i(Sense::Disabled) << GPIO_PIN_CNF_SENSE_Pos);
	}

	void set() const { set(true); }
	void reset() const { set(false); }

	void
	set(bool value) const
	{
		if (value != inverted()) reg()->OUTSET = setBits;
		else reg()->OUTCLR = setBits;
	}

	void
	toggle() const
	{
		NRF_GPIO_Type *const port = reg();
		if (port->OUT & setBits) port->OUTCLR = setBits;
		else port->OUTSET = setBits;
	}

	bool isSet() const { return bool(reg()->OUT & setBits) != inverted(); }
	bool read() const { return bool(reg()->IN & setBits) != inverted(); }
};

} // namespace modm::platform
