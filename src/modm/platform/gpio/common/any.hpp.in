#pragma once

#include "runtime.hpp"
#include "unused.hpp"
#include <modm/architecture/interface/gpio.hpp>
#include <concepts>

namespace modm
{

/**
 * Runtime GPIO pin of this device, or unused.
 *
 * A value type that can be copied and stored in arrays and constexpr tables.
 * Pins of this device take the inlined fast path of `modm::platform::GpioPin`
 * plus one test and branch. A default constructed pin is unused like
 * `GpioUnused`: all functions do nothing and `read()` returns false.
 *
 * @code
 * std::array<modm::AnyGpio, 3> leds{GpioA5{}, GpioUnused{}, GpioInverted<GpioB3>{}};
 * for (auto led : leds) led.toggle();
 * @endcode
 *
 * The interface and its configuration types are the same on all platforms, and
 * their values are aliases of the platform values. The configuration functions
 * return false and leave the pin unchanged if the platform does not have that
 * configuration, for example `InputType::PullDown` on AVR. `OutputSpeed` is a
 * hint, which platforms without a matching setting ignore or round down.
 *
 * The configuration types of the platform are accepted as well, for settings
 * that only exist there.
 *
 * Copy the pin into a local variable in hot loops: the compiler can then hoist
 * the test out of the loop and the pin is as fast as `platform::GpioPin`.
 *
 * @ingroup modm_platform_gpio
 */
class AnyGpio : protected platform::GpioPin
{
	// Bit 0 of the address marks a pin without a GPIO port: every platform
	// keeps it clear for its own pins.
	static constexpr uintptr_t Unused{1};
	/// Value of a configuration that this platform does not have
	static constexpr uint8_t NotAvailable{0xff};

	constexpr bool internal() const { return not (addr & 1u); }

public:
	enum class
	InputType : uint8_t
	{
		Floating = uint8_t(platform::GpioPin::InputType::Floating),
		PullUp = uint8_t(platform::GpioPin::InputType::PullUp),
%% if target.platform == "avr"
		PullDown = NotAvailable,
%% else
		PullDown = uint8_t(platform::GpioPin::InputType::PullDown),
%% endif
	};

	enum class
	OutputType : uint8_t
	{
%% if target.platform == "sam"
		PushPull = 0,
%% else
		PushPull = uint8_t(platform::GpioPin::OutputType::PushPull),
%% endif
%% if target.platform in ["stm32", "nrf", "hosted"]
		OpenDrain = uint8_t(platform::GpioPin::OutputType::OpenDrain),
%% else
		OpenDrain = NotAvailable,
%% endif
	};

	enum class
	OutputSpeed : uint8_t
	{
%% if target.platform == "stm32"
		Low = uint8_t(platform::GpioPin::OutputSpeed::Low),
		Medium = uint8_t(platform::GpioPin::OutputSpeed::Medium),
		High = uint8_t(platform::GpioPin::OutputSpeed::High),
	%% if target.family in ["f0", "f1", "f3"]
		VeryHigh = High,
	%% else
		VeryHigh = uint8_t(platform::GpioPin::OutputSpeed::VeryHigh),
	%% endif
%% else
		Low,
		Medium,
		High,
		VeryHigh,
%% endif
	};

	using platform::GpioPin::GpioPin;

	constexpr AnyGpio() : platform::GpioPin(Unused, 0) {}

	// A template, so that classes derived from AnyGpio are not ambiguous
	template< std::same_as<platform::GpioPin> Pin >
	constexpr AnyGpio(Pin pin) : platform::GpioPin(pin) {}

	template< std::derived_from<platform::GpioUnused> Pin >
	constexpr AnyGpio(Pin) : AnyGpio() {}

	/// @return true if the pin does nothing, like `GpioUnused`.
	constexpr bool isUnused() const { return addr == Unused; }

	void
	setOutput() const { if (internal()) [[likely]] GpioPin::setOutput(); }

	void
	setOutput(bool value) const { set(value); setOutput(); }

	/// @return false if this platform does not have the configuration.
	bool
	setOutput(OutputType type, OutputSpeed speed = OutputSpeed::High) const
	{
		if (not internal()) return true;
		if (uint8_t(type) == NotAvailable) return false;
%% if target.platform == "stm32"
		GpioPin::setOutput(GpioPin::OutputType(type), GpioPin::OutputSpeed(speed));
%% elif target.platform == "nrf"
		(void) speed;
		GpioPin::setOutput(GpioPin::OutputType(type));
%% elif target.platform == "rp"
		GpioPin::setOutput(GpioPin::OutputType(type), slewRate(speed));
%% else
		(void) speed;
		GpioPin::setOutput();
%% endif
		return true;
	}

	/// @return false if this platform does not have the configuration.
	bool
	configure(OutputType type, OutputSpeed speed = OutputSpeed::High) const
	{
		if (not internal()) return true;
		if (uint8_t(type) == NotAvailable) return false;
%% if target.platform == "stm32"
		GpioPin::configure(GpioPin::OutputType(type), GpioPin::OutputSpeed(speed));
%% elif target.platform == "nrf"
		(void) speed;
		GpioPin::configure(GpioPin::OutputType(type));
%% elif target.platform == "rp"
		GpioPin::configure(GpioPin::OutputType(type), slewRate(speed));
%% else
		(void) speed;
%% endif
		return true;
	}

	void
	setInput() const { if (internal()) [[likely]] GpioPin::setInput(); }

	/// @return false if this platform does not have the configuration.
	bool
	setInput(InputType type) const
	{
		if (not internal()) return true;
		if (uint8_t(type) == NotAvailable) return false;
		GpioPin::setInput(GpioPin::InputType(type));
		return true;
	}

	/// @return false if this platform does not have the configuration.
	bool
	configure(InputType type) const
	{
		if (not internal()) return true;
		if (uint8_t(type) == NotAvailable) return false;
		GpioPin::configure(GpioPin::InputType(type));
		return true;
	}

	/// Takes a configuration type of the platform, like `Gpio::OutputType`.
	template< class Type, class... Args >
	requires (not std::same_as<Type, bool>) and (not std::same_as<Type, OutputType>) and
		requires(const platform::GpioPin pin, Type type, Args... args) { pin.setOutput(type, args...); }
	bool
	setOutput(Type type, Args... args) const
	{
		if (internal()) [[likely]] GpioPin::setOutput(type, args...);
		return true;
	}

	/// Takes a configuration type of the platform, like `Gpio::InputType`.
	template< class Type, class... Args >
	requires (not std::same_as<Type, InputType>) and (not std::same_as<Type, OutputType>) and
		requires(const platform::GpioPin pin, Type type, Args... args) { pin.configure(type, args...); }
	bool
	configure(Type type, Args... args) const
	{
		if (internal()) [[likely]] GpioPin::configure(type, args...);
		return true;
	}

	/// Takes a configuration type of the platform, like `Gpio::InputType`.
	template< class Type >
	requires (not std::same_as<Type, InputType>) and
		requires(const platform::GpioPin pin, Type type) { pin.setInput(type); }
	bool
	setInput(Type type) const
	{
		if (internal()) [[likely]] GpioPin::setInput(type);
		return true;
	}

	::modm::Gpio::Direction
	getDirection() const
	{
		if (internal()) [[likely]] return GpioPin::getDirection();
		return ::modm::Gpio::Direction::In;
	}

	/// Back to a floating input, detached from any peripheral signal
	void
	disconnect() const { if (internal()) [[likely]] GpioPin::disconnect(); }

	modm_always_inline void
	set() const { if (internal()) [[likely]] GpioPin::set(); }

	modm_always_inline void
	reset() const { if (internal()) [[likely]] GpioPin::reset(); }

	modm_always_inline void
	set(bool value) const { if (internal()) [[likely]] GpioPin::set(value); }

	modm_always_inline void
	toggle() const { if (internal()) [[likely]] GpioPin::toggle(); }

	modm_always_inline bool
	isSet() const { if (internal()) [[likely]] return GpioPin::isSet(); return false; }

	modm_always_inline bool
	read() const { if (internal()) [[likely]] return GpioPin::read(); return false; }
%% if target.platform == "rp"

private:
	static constexpr GpioPin::SlewRate
	slewRate(OutputSpeed speed)
	{ return (speed == OutputSpeed::Low) ? GpioPin::SlewRate::Slow : GpioPin::SlewRate::Fast; }
%% endif
};

/**
 * Static GPIO class that forwards to the `modm::AnyGpio` of `Source::get()`.
 *
 * A bridge for classes that take their pins as template arguments, like
 * `BitBangI2cMaster`, when the pin is only known at runtime. `Source::get()`
 * can return a pin attached at runtime or an entry of a lookup table.
 *
 * @code
 * struct SclSource
 * {
 *     static inline modm::AnyGpio pin{};
 *     static modm::AnyGpio get() { return pin; }
 * };
 * using Scl = modm::AnyGpioAdapter<SclSource>;
 * @endcode
 *
 * There is no compile-time pin behind it, so it has no peripheral signals and
 * cannot be used with `connect()` or `SoftwareGpioPort`.
 *
 * @ingroup modm_platform_gpio
 */
template< class Source >
struct AnyGpioAdapter : public GpioIO
{
	using InputType = AnyGpio::InputType;
	using OutputType = AnyGpio::OutputType;
	using OutputSpeed = AnyGpio::OutputSpeed;

	/// The runtime pin behind this class
	static AnyGpio get() { return Source::get(); }

	template< class... Args >
	static decltype(auto) setOutput(Args... args) { return Source::get().setOutput(args...); }
	template< class... Args >
	static decltype(auto) configure(Args... args) { return Source::get().configure(args...); }
	template< class... Args >
	static decltype(auto) setInput(Args... args) { return Source::get().setInput(args...); }
	static void set() { Source::get().set(); }
	static void set(bool value) { Source::get().set(value); }
	static void reset() { Source::get().reset(); }
	static void toggle() { Source::get().toggle(); }
	static bool isSet() { return Source::get().isSet(); }
	static bool read() { return Source::get().read(); }
	static Direction getDirection() { return Source::get().getDirection(); }
	static void disconnect() { Source::get().disconnect(); }
};

static_assert(sizeof(AnyGpio) == sizeof(platform::GpioPin));

} // namespace modm
