#pragma once

#include "base.hpp"
#include "unused.hpp"
#include <avr/interrupt.h>
#include <avr/io.h>
#include <concepts>

namespace modm::platform
{

/**
 * Runtime GPIO pin: the port and the pin mask as a value.
 *
 * A value type that can be copied, stored in constexpr tables and selected at
 * runtime. Construct it from a static GPIO class, also an inverted one, or from
 * a port and a pin number. Writes to the port are interrupt safe.
 *
 * Only pins of this device, for `GpioUnused` see `modm::AnyGpio`.
 *
 * @ingroup modm_platform_gpio
 */
class GpioPin : public Gpio
{
protected:
	uintptr_t addr;		///< (port << 2) | (inverted << 1), bit 0 is always clear
	uint32_t setBits;	///< The physical pin mask

	constexpr GpioPin(uintptr_t addr, uint32_t setBits) : addr(addr), setBits(setBits) {}

	constexpr bool inverted() const { return addr & 2u; }
	constexpr uint8_t mask() const { return setBits; }

	volatile uint8_t&
	regPort() const
	{
		switch(Port(addr >> 2))
		{
%% for port in ports
			case Port::{{port}}: return PORT{{port}};
%% endfor
		}
		__builtin_unreachable();
	}

	volatile uint8_t&
	regDdr() const
	{
		switch(Port(addr >> 2))
		{
%% for port in ports
			case Port::{{port}}: return DDR{{port}};
%% endfor
		}
		__builtin_unreachable();
	}

	volatile uint8_t&
	regPin() const
	{
		switch(Port(addr >> 2))
		{
%% for port in ports
			case Port::{{port}}: return PIN{{port}};
%% endfor
		}
		__builtin_unreachable();
	}
%% if pue

	volatile uint8_t&
	regPull() const
	{
		switch(Port(addr >> 2))
		{
%% for port in ports
			case Port::{{port}}: return PUE{{port}};
%% endfor
		}
		__builtin_unreachable();
	}
%% else

	volatile uint8_t& regPull() const { return regPort(); }
%% endif

	/// The mask is not known at compile time, so this cannot be a single `sbi`
	static void
	update(volatile uint8_t &reg, uint8_t clear, uint8_t bits)
	{
		const uint8_t sreg = SREG;
		cli();
		reg = (reg & ~clear) | bits;
		SREG = sreg;
	}

public:
	constexpr GpioPin(Port port, uint8_t pin, bool inverted = false)
	:	addr((uintptr_t(port) << 2) | (inverted ? 2u : 0u)), setBits(1ul << (pin & 7)) {}

	template< class Pin >
	requires requires { Pin::port; Pin::pin; Pin::isInverted; }
		and (not std::derived_from<Pin, GpioUnused>)
	constexpr GpioPin(Pin)
	:	GpioPin(Pin::port, Pin::pin, Pin::isInverted) {}

	void
	setOutput() const
	{
%% if pue
		update(regPull(), mask(), 0);
%% endif
		update(regDdr(), 0, mask());
	}

	/// The level is written first, so that the pin never glitches.
	void
	setOutput(bool value) const
	{
		set(value);
		setOutput();
	}

	void setOutput(OutputType) const { setOutput(); }
	void configure(OutputType) const { setOutput(); }

	void setInput() const { update(regDdr(), mask(), 0); }

	void
	setInput(InputType type) const
	{
		setInput();
		configure(type);
	}

	void
	configure(InputType type) const
	{ update(regPull(), mask(), (type == InputType::PullUp) ? mask() : 0); }

	::modm::Gpio::Direction
	getDirection() const
	{
		using Direction = ::modm::Gpio::Direction;
		return (regDdr() & mask()) ? Direction::Out : Direction::In;
	}

	/// Back to a floating input
	void
	disconnect() const
	{
		update(regDdr(), mask(), 0);
		update(regPull(), mask(), 0);
	}

	void set() const { set(true); }
	void reset() const { set(false); }

	void
	set(bool value) const
	{ update(regPort(), mask(), (value != inverted()) ? mask() : 0); }

	void
	toggle() const
	{
%% if notoggle
		const uint8_t sreg = SREG;
		cli();
		regPort() ^= mask();
		SREG = sreg;
%% else
		regPin() = mask();
%% endif
	}

	bool isSet() const { return bool(regPort() & mask()) != inverted(); }
	bool read() const { return bool(regPin() & mask()) != inverted(); }
};

} // namespace modm::platform
