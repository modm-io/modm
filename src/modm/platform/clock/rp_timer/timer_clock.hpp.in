#pragma once

#include <modm/architecture/interface/clock.hpp>
#include <modm/platform/device.hpp>
%% if family == "20"
#include <hardware/structs/watchdog.h>
%% else
#include <hardware/structs/ticks.h>
%% endif

namespace modm::platform
{

/**
 * Provides `modm::Clock` and `modm::PreciseClock` from the 64-bit 1MHz TIMER,
 * which is shared by both cores.
 *
 * @ingroup modm_platform_clock
 */
class TimerClock
{
public:
%% if family == "20"
	/// Starts the 1MHz watchdog tick from clk_ref, which the TIMER counts.
%% else
	/// Starts the 1MHz TIMER0 and WATCHDOG ticks from clk_ref.
%% endif
	template< class SystemClock >
	static void
	initialize()
	{
		static_assert(SystemClock::RefFrequency % 1'000'000 == 0,
					  "clk_ref must be an integer multiple of 1MHz for the TIMER tick!");
%% if family == "20"
		watchdog_hw->tick = WATCHDOG_TICK_ENABLE_BITS | (SystemClock::RefFrequency / 1'000'000);
%% else
		for (const auto tick : {TICK_TIMER0, TICK_WATCHDOG})
		{
			ticks_hw->ticks[tick].ctrl = 0;
			ticks_hw->ticks[tick].cycles = SystemClock::RefFrequency / 1'000'000;
			ticks_hw->ticks[tick].ctrl = TICKS_WATCHDOG_CTRL_ENABLE_BITS;
		}
%% endif
	}
};

}	// namespace modm::platform
