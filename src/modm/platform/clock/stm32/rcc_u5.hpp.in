	}
%#
%% endif
%% if target.name == "99" or target.name >= "a9"
	enum class
	LtdcClockSource : uint8_t
	{
		Pll3R = 0,
		Pll2R = 1,
	};
	static inline void
	setLtdcClockSource(LtdcClockSource src)
	{
		RCC->CCIPR2 = (RCC->CCIPR2 & ~RCC_CCIPR2_LTDCSEL) | (uint32_t(src) << RCC_CCIPR2_LTDCSEL_Pos);
	}
%#
%% endif
%% if target.name in ["99", "a9", "f9", "g9"]
	enum class
	DsiClockSource : uint8_t
	{
		Pll3P = 0,
		Phy   = 1,
	};
	static inline void
	setDsiClockSource(DsiClockSource src)
	{
		RCC->CCIPR2 = (RCC->CCIPR2 & ~RCC_CCIPR2_DSIHOSTSEL) | (uint32_t(src) << RCC_CCIPR2_DSIHOSTSEL_Pos);
	}
%#
%% endif
%% if target.name >= "95"
	enum class
	UsbPhyClockSource : uint8_t
	{
		Hse       = 0b00,
		Pll1P     = 0b01,
		HseDiv2   = 0b10,
		Pll1PDiv2 = 0b11,
	};
	static inline void
	setUsbPhyClockSource(UsbPhyClockSource src)
	{
		RCC->CCIPR2 = (RCC->CCIPR2 & ~RCC_CCIPR2_USBPHYCSEL) | (uint32_t(src) << RCC_CCIPR2_USBPHYCSEL_Pos);
	}
%#
%% endif
	enum class
	SystickClockSource : uint8_t
	{
		HclkDiv8 = 0b00,
		Lsi      = 0b01,
		Lse      = 0b10,
	};
	static inline void
	setSystickClockSource(SystickClockSource src)
	{
		RCC->CCIPR1 = (RCC->CCIPR1 & ~RCC_CCIPR1_SYSTICKSEL) | (uint32_t(src) << RCC_CCIPR1_SYSTICKSEL_Pos);
	}

public:
	// outputs
	enum class
	McoPrescaler : uint8_t
	{
		Div1  = 0b000,
		Div2  = 0b001,
		Div4  = 0b010,
		Div8  = 0b011,
		Div16 = 0b100,
	};
	enum class
	McoClockSource : uint8_t
	{
		Disabled = 0b0000,
		SysClk   = 0b0001,
		MsiS     = 0b0010,
		Hsi      = 0b0011,
		Hse      = 0b0100,
		Pll1R    = 0b0101,
		Lsi      = 0b0110,
		Lse      = 0b0111,
		Hsi48    = 0b1000,
		MsiK     = 0b1001,
	};
	static inline void
	setMco1ClockSource(McoClockSource src, McoPrescaler div)
	{
		RCC->CFGR1 = (RCC->CFGR1 & ~(RCC_CFGR1_MCOSEL | RCC_CFGR1_MCOPRE)) |
					 (uint32_t(src) << RCC_CFGR1_MCOSEL_Pos) | (uint32_t(div) << RCC_CFGR1_MCOPRE_Pos);
	}

public:
	// TODO: move to Pwr module
	enum class
	VoltageScaling : uint32_t
	{
		Range4 = 0b00 << PWR_VOSR_VOS_Pos,
		Range3 = 0b01 << PWR_VOSR_VOS_Pos,
		Range2 = (0b10 << PWR_VOSR_VOS_Pos) | PWR_VOSR_BOOSTEN,
		Range1 = (0b11 << PWR_VOSR_VOS_Pos) | PWR_VOSR_BOOSTEN,
	};
	static inline bool
	setVoltageScaling(VoltageScaling voltage, uint32_t waitLoops = 0x10000)
	{
		const uint32_t current = PWR->VOSR & (PWR_VOSR_VOS | PWR_VOSR_BOOSTEN);
		if (current == uint32_t(voltage)) return true;

		PWR->VOSR = (PWR->VOSR & ~(PWR_VOSR_VOS | PWR_VOSR_BOOSTEN)) | uint32_t(voltage);

		while (not (PWR->VOSR & PWR_VOSR_VOSRDY) and --waitLoops) ;

		if (uint32_t(voltage) & PWR_VOSR_BOOSTEN)
			while (not (PWR->VOSR & PWR_VOSR_BOOSTRDY) and --waitLoops) ;

		return waitLoops;
	}

private:
	struct flash_latency
	{
		uint32_t latency;
		uint32_t max_frequency;
	};
	static constexpr flash_latency
	computeFlashLatency(uint32_t Core_Hz, uint16_t Core_mV);
};

} // namespace modm::platform

#include "rcc_impl.hpp"
