	enum class
	I2sApbClockSource : uint32_t
	{
		PllR = 0u,
		External = RCC_DCKCFGR_I2SSRC_0,
		MainPll = RCC_DCKCFGR_I2SSRC_1,
	};
	static inline void
	setI2sApbClockSource(I2sApbClockSource src)
	{
		RCC->DCKCFGR = (RCC->DCKCFGR & ~RCC_DCKCFGR_I2SSRC) | uint32_t(src);
	}
%#
%% endif
%% if target.name in ["12", "13", "23", "46"]
	enum class
	I2sClockSource : uint8_t
	{
		PllI2s = 0,
		External = 1,
		PllR = 2,
%% if target.name in ["12", "13", "23", "46"]
		MainPll = 3,
%% endif
	};
	static inline void
	setI2s1ClockSource(I2sClockSource src)
	{
		RCC->DCKCFGR = (RCC->DCKCFGR & ~RCC_DCKCFGR_I2S1SRC) | (uint32_t(src) << RCC_DCKCFGR_I2S1SRC_Pos);
	}
	static inline void
	setI2s2ClockSource(I2sClockSource src)
	{
		RCC->DCKCFGR = (RCC->DCKCFGR & ~RCC_DCKCFGR_I2S2SRC) | (uint32_t(src) << RCC_DCKCFGR_I2S2SRC_Pos);
	}
%#
%% endif
%% if target.name[1] not in "57"
