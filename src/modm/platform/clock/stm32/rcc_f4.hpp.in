%% set has_clk48_dckcfgr = target.name >= "69"
%% set has_clk48_dckcfgr2_pllsai = target.name == "46"
%% set has_clk48_dckcfgr2_plli2s = target.name in ["12", "13", "23"]
%% set has_clk48 = has_clk48_dckcfgr or has_clk48_dckcfgr2_pllsai or has_clk48_dckcfgr2_plli2s
%% if has_clk48
	enum class
	Clk48Source : uint32_t
	{
		PllQ = 0u,
%% if has_clk48_dckcfgr
		PllSaiP = RCC_DCKCFGR_CK48MSEL,
%% elif has_clk48_dckcfgr2_pllsai
		PllSaiP = RCC_DCKCFGR2_CK48MSEL,
%% elif has_clk48_dckcfgr2_plli2s
		PllI2sQ = RCC_DCKCFGR2_CK48MSEL,
%% endif
	};
	static inline void
	setClk48Source(Clk48Source src)
	{
%% if has_clk48_dckcfgr
		RCC->DCKCFGR = (RCC->DCKCFGR & ~RCC_DCKCFGR_CK48MSEL) | uint32_t(src);
%% else
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_CK48MSEL) | uint32_t(src);
%% endif
	}

	enum class
	SdioClockSource : uint32_t
	{
		Clk48 = 0u,
%% if has_clk48_dckcfgr
		System = RCC_DCKCFGR_SDIOSEL,
%% else
		System = RCC_DCKCFGR2_SDIOSEL,
%% endif
	};
	static inline void
	setSdioClockSource(SdioClockSource src)
	{
%% if has_clk48_dckcfgr
		RCC->DCKCFGR = (RCC->DCKCFGR & ~RCC_DCKCFGR_SDIOSEL) | uint32_t(src);
%% else
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_SDIOSEL) | uint32_t(src);
%% endif
	}
%#
%% endif
%% if target.name >= "69"
	enum class
	DsiClockSource : uint32_t
	{
		DsiPhy = 0u,
		MainPllR = RCC_DCKCFGR_DSISEL,
	};

	static inline void
	setDsiClockSource(DsiClockSource src)
	{
		RCC->DCKCFGR = (RCC->DCKCFGR & ~RCC_DCKCFGR_DSISEL) | uint32_t(src);
	}
%#
%% endif
%% if target.name in ["10", "12", "13", "23", "46"]
	enum class
	FmpI2c1ClockSource : uint32_t
	{
		Apb1 = 0u,
		System = RCC_DCKCFGR2_FMPI2C1SEL_0,
		Hsi = RCC_DCKCFGR2_FMPI2C1SEL_1,
	};
	static inline void
	setFmpI2c1ClockSource(FmpI2c1ClockSource src)
	{
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_FMPI2C1SEL) | uint32_t(src);
	}
%#
%% endif
%% if 1 in lptim_ids
	enum class
	Lptim1ClockSource : uint32_t
	{
		Apb1 = 0u,
		Hsi = RCC_DCKCFGR2_LPTIM1SEL_0,
		Lsi = RCC_DCKCFGR2_LPTIM1SEL_1,
		Lse = RCC_DCKCFGR2_LPTIM1SEL,
	};
	static inline void
	setLptim1ClockSource(Lptim1ClockSource src)
	{
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_LPTIM1SEL) | uint32_t(src);
	}
%#
%% endif
%% if target.name == "46"
	enum class
	CecClockSource : uint32_t
	{
		Hsi = 0u,
		Lse = RCC_DCKCFGR2_CECSEL,
	};
	static inline void
	setCecClockSource(CecClockSource src)
	{
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_CECSEL) | uint32_t(src);
	}
%#
%% endif
%% if target.name == "46"
	enum class
	SpdifClockSource : uint32_t
	{
		PllR = 0u,
		PllI2sP = RCC_DCKCFGR2_SPDIFRXSEL,
	};
	static inline void
	setSpdifClockSource(SpdifClockSource src)
	{
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_SPDIFRXSEL) | uint32_t(src);
	}
%#
%% endif
	enum class
	McoPrescaler : uint32_t
	{
		Div1 = 0b000,
		Div2 = 0b100,
		Div3 = 0b101,
		Div4 = 0b110,
		Div5 = 0b111,
	};

	enum class
	Mco1ClockSource : uint32_t
	{
		Hsi = 0b00,
		Lse = 0b01,
		Hse = 0b10,
		Pll = 0b11,
	};
	static inline void
	setMco1ClockSource(Mco1ClockSource src, McoPrescaler prescaler = McoPrescaler::Div1)
	{
		RCC->CFGR = (RCC->CFGR & ~(RCC_CFGR_MCO1 | RCC_CFGR_MCO1PRE)) |
					(uint32_t(src) << RCC_CFGR_MCO1_Pos) | (uint32_t(prescaler) << RCC_CFGR_MCO1PRE_Pos);
	}

	enum class
	Mco2ClockSource : uint32_t
	{
		SysClk = 0b00,
		PllI2s = 0b01,
		Hse = 0b10,
		Pll = 0b11,
	};
	static inline void
	setMco2ClockSource(Mco2ClockSource src, McoPrescaler prescaler = McoPrescaler::Div1)
	{
		RCC->CFGR = (RCC->CFGR & ~(RCC_CFGR_MCO2 | RCC_CFGR_MCO2PRE)) |
					(uint32_t(src) << RCC_CFGR_MCO2_Pos) | (uint32_t(prescaler) << RCC_CFGR_MCO2PRE_Pos);
	}

%% if target.name >= "27"
	// TODO: move to Pwr module
	static inline bool
	enableOverdriveMode(uint32_t waitLoops = 2048)
	{
		PWR->CR |= PWR_CR_ODEN;
		auto waitCounter = waitLoops;
		while (!(PWR->CSR & PWR_CSR_ODRDY))
			if (--waitCounter == 0) return false;

		PWR->CR |= PWR_CR_ODSWEN;
		while (!(PWR->CSR & PWR_CSR_ODSWRDY))
			if (--waitLoops == 0) return false;

		return true;
	}
%% endif

private:
	struct flash_latency
	{
		uint32_t latency;
		uint32_t max_frequency;
	};

	static constexpr flash_latency
	computeFlashLatency(uint32_t Core_Hz, uint16_t Core_mV);
};

} // namespace modm::platform

#include "rcc_impl.hpp"