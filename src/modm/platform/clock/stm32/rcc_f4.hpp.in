	TimerClockPrescaler : uint32_t
	{
		TwicePclk = 0u,
		HighSpeed = RCC_DCKCFGR_TIMPRE,
	};
	static inline void
	setTimerClockPrescaler(TimerClockPrescaler prescaler)
	{
		RCC->DCKCFGR = (RCC->DCKCFGR & ~RCC_DCKCFGR_TIMPRE) | uint32_t(prescaler);
	}
%#
%% endif
%% if target.name in ["27", "29", "37", "39", "46", "69", "79"]
