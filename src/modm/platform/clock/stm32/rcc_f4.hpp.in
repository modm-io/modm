	static inline void
	setPllI2sDivQ(uint8_t divider)
	{
		RCC->DCKCFGR = (RCC->DCKCFGR & ~RCC_DCKCFGR_PLLI2SDIVQ) |
			((uint32_t(divider - 1u) << RCC_DCKCFGR_PLLI2SDIVQ_Pos) & RCC_DCKCFGR_PLLI2SDIVQ);
	}

	/// Allowed values are 1-32.
	static inline void
	setPllSaiDivQ(uint8_t divider)
	{
		RCC->DCKCFGR = (RCC->DCKCFGR & ~RCC_DCKCFGR_PLLSAIDIVQ) |
			((uint32_t(divider - 1u) << RCC_DCKCFGR_PLLSAIDIVQ_Pos) & RCC_DCKCFGR_PLLSAIDIVQ);
	}
