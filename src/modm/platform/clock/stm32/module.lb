def init(module):
    module.name = ":platform:rcc"
    module.description = "Reset and Clock Control (RCC)"

def prepare(module, options):
    if not options[":target"].has_driver("rcc:stm32*"):
        return False

    module.depends(":cmsis:device", ":utils", ":platform:clock", ":architecture:delay")
    return True

def build(env):
    device = env[":target"]

    p = {}
    p["target"] = t = device.identifier
    p["partname"] = device.partname
    p["core"] = device.get_driver("core")["type"]
    p["max_frequency"] = int(device.get_driver("rcc")["max-frequency"][0])

    if t.family in ["c0"]:
        p["hsi_frequency"] = 48_000_000
        p["lsi_frequency"] = 32_000
        p["boot_frequency"] = 12_000_000
    elif t.family in ["f0", "f1", "f3"]:
        p["hsi_frequency"] = 8_000_000
        p["lsi_frequency"] = 40_000
    elif t.family in ["h5", "h7"]:
        p["hsi_frequency"] = 64_000_000
        p["lsi_frequency"] = 32_000
    elif t.family in ["l0", "l1"]:
        p["hsi_frequency"] = 16_000_000
        p["lsi_frequency"] = 37_000
        p["msi_frequency"] = p["boot_frequency"] = 2_097_000
    elif t.family in ["l5"]:
        p["hsi_frequency"] = 16_000_000
        p["lsi_frequency"] = 32_000
        p["msi_frequency"] = p["boot_frequency"] = 4_000_000
    else:
        p["hsi_frequency"] = 16_000_000
        p["lsi_frequency"] = 32_000
    if "boot_frequency" not in p:
        p["boot_frequency"] = p["hsi_frequency"]

    # TODO: Move this data into the device files
    p["usbprescaler"] = device.has_driver("usb") and t.family in ["f0", "f1", "f3"]
    p["pllprediv"] = \
        (t.family in ["f0", "f3"] or (t.family == "f1" and t.name in ["00", "05", "07"]))
    p["pllprediv2"] = False    # FIXME: not sure what value this should have
    p["pll_hse_prediv2"] = t.family == "f1" and t.name in ["01", "02", "03"]
    p["hsi48"] = \
        (t.family in ["g4", "h5", "h7", "l5", "u0", "u5"]) or \
        (t.family == "f0" and t.name in ["42", "48", "71", "72", "78", "91", "98"]) or \
        (t.family == "g0" and t.name in ["b1", "c1"]) or \
        (t.family == "l0" and t.name[1] == "2") or \
        (t.family == "l4" and t.name[0] not in ["7", "8"])
    if t.family in ["g4", "l0", "l4", "l5", "u0"]:
        p["hsi48_cr"] = "CRRCR"
    elif t.family in ["g0", "h5", "h7", "u5"]:
        p["hsi48_cr"] = "CR"
    elif t.family in ["f0"]:
        p["hsi48_cr"] = "CR2"
    p["pll_p"] = ((t.family == "l4" and t.name not in ["12", "22"]) or t.family in ["g0", "g4", "l5", "f2", "f4", "f7", "u0"])
    p["pll_q"] = (t.family == "g0" and (t.name[1] == "1" or t.name == "b0")) or t.family in ["g4", "l4", "l5"]
    p["overdrive"] = (t.family == "f7") or \
        ((t.family == "f4") and t.name in ["27", "29", "37", "39", "46", "69", "79"])
    p["vos0_overdrive"] = (t.family == "h7") and \
        t.name in ["42", "43", "45", "47", "50", "53", "55", "57"]
    p["has_r1mode"] = (t.family == "g4") or \
        (t.family == "l4" and t.name[0] in ["p", "q", "r", "s"])
    p["pllsai_p_usb"] = (t.family == "f7") or \
        ((t.family == "f4") and t.name in ["46", "69", "79"])
    p["rtcpre"] = t.family in ["f2", "f4", "f7", "h7", "l0", "l1"]
    p["cfgr_rtc"] = "CR" if t.family in ["l0", "l1"] else \
        ("CFGR1" if t.family in ["h5"]  else "CFGR")


    if t.family in ["h7"]:
        if t.name in ["a3", "b0", "b3"]:
            p["cfgr_prescaler"] = "CDCFGR1"
        else:
            p["cfgr_prescaler"] = "D1CFGR"
    elif t.family in ["u5"]:
        p["cfgr_prescaler"] = "CFGR2"
    else:
        p["cfgr_prescaler"] = "CFGR"

    if t.family in ["h7"]:
        if t.name in ["a3", "b0", "b3"]:
            p["cfgr2"] = "CDCFGR2"
        else:
            p["cfgr2"] = "D2CFGR"
    elif t.family in ["u5"]:
        p["cfgr2"] = "CFGR2"
    else:
        p["cfgr2"] = "CFGR"

    if t.family in ["h7"]:
        if t.name in ["a3", "b0", "b3"]:
            p["ccipr1"] = "CDCCIP1R"
        else:
            p["ccipr1"] = "D2CCIP1R"
    elif t.family in ["l5", "u5"]:
        p["ccipr1"] = "CCIPR1"
    else:
        p["ccipr1"] = "CCIPR"

    p["d1"] = ("CD" if t.name in ["a3", "b0", "b3"] else "D1") \
                        if t.family == "h7" else ""
    p["d2"] = ("CD" if t.name in ["a3", "b0", "b3"] else "D2") \
                        if t.family == "h7" else ""
    p["cfgr3"] = ("SRDCFGR" if t.name in ["a0", "a3", "b0", "b3"] else "D3CFGR")
    p["d3"] = ("SRD" if t.name in ["a0", "a3", "b0", "b3"] else "D3")
    p["bdcr"] = "CSR1" if t.family in ["c0"] else "CSR" if t.family in ["l0", "l1"] else "BDCR"
    p["pll_ids"] = ["1", "2", "3"] if t.family in ["h7", "u5"] else [] if t.family in ["c0"] else [""]
    p["has_smps"] = t.family == "h7" and (t.name in ["25", "35", "45", "47", "55", "57"] or \
        (t.name in ["30", "a3", "b0", "b3"] and t.variant == "q"))

    flash_latencies = {}
    for vcore in device.get_driver("flash")["latency"]:
        flash_latencies[int(vcore["vcore-min"])] = sorted([int(f["hclk-max"]) for f in vcore["wait-state"]])

    p["table"] = flash_latencies
    env.substitutions = p
    env.outbasepath = "modm/src/modm/platform/clock"

    def instances(*drivers):
        ids = []
        for driver in drivers:
            if device.has_driver(driver):
                ids += device.get_driver(driver)["instance"]
        return list(map(int, ids))

    if t.family in ["h5", "u0", "g0", "u3", "c0"]:
        p["uart_ids"] = instances("usart", "uart")
        p["lpuart_ids"] = instances("lpuart")
        p["spi_ids"] = instances("spi")
        p["i2c_ids"] = instances("i2c")
        p["tim_ids"] = instances("tim")
        p["lptim_ids"] = instances("lptim")
        env.template(f"rcc_{t.family}.hpp.in", "rcc.hpp")
    else:
        env.template("rcc.hpp.in")
        env.template("rcc.cpp.in")
    env.copy("rcc_defs.cpp")

    all_peripherals = env.query(":cmsis:device:peripherals")
    rcc_map = env.query(":cmsis:device:rcc-map")
    rcc_enable = {}
    rcc_reset = {}

    for per, mode in rcc_map.items():
        nper = per
        # Fix CAN vs CAN1
        if "Can" in all_peripherals and per == "CAN1":
            per = "CAN"
            nper = "CAN1"
        # FDCAN
        if "Fdcan1" in all_peripherals and per == "FDCAN":
            per = "FDCAN1"
            nper = "FDCAN"
        # COMP12
        if "Comp1" in all_peripherals and per == "COMP12":
            per = "COMP1"
            nper = "COMP12"
        if "Comp2" in all_peripherals and per == "COMP12":
            per = "COMP2"
            nper = "COMP12"
        # DAC
        if "Dac1" in all_peripherals and per == "DAC":
            per = "DAC1"
            nper = "DAC"
        # DAC12
        if "Dac1" in all_peripherals and per == "DAC12":
            per = "DAC1"
            nper = "DAC12"
        if "Dac2" in all_peripherals and per == "DAC12":
            per = "DAC2"
            nper = "DAC12"
        if "Dac" in all_peripherals and per == "DAC1":
            per = "DAC"
            nper = "DAC1"
        # Fix ADC vs ADC1
        if "Adc1" in all_peripherals and per == "ADC":
            per = "ADC1"
            nper = "ADC"
        # Fix DSIHOST vs DSI
        if "Dsihost" in all_peripherals and per == "DSI":
            per = "Dsihost"
            nper = "DSI"
        if "Eth" in all_peripherals and per == "ETHMAC":
            per = "Eth"
        if "Rtc" in all_peripherals and per == "RTCAPB":
            per = "RTC"
            nper = "RTCAPB"
        # Fix USBOTG OTG
        if t.family == "u5" and per == "OTG":
            per = "Usbotgfs"
        if ("Usbotgfs" in all_peripherals or "Usbotghs" in all_peripherals) and per.startswith("OTG"):
            if per == "OTGH": per = "OTGHS"
            per = "USB"+per
        if ("Usbotgfs" in all_peripherals or "Usbotghs" in all_peripherals) and per.startswith("USB"):
            per = per.replace("USB1", "USB").replace("USB2", "USB")
        if t.family == "l5" and per == "USBFS":
            per = "Usb"
        if t.family == "u3" and per == "USB1":
            per = "Usb"
        if per.capitalize() not in all_peripherals:
            continue
        if "EN" in mode:
            kw = per.capitalize()
            if kw not in rcc_enable:
                rcc_enable[kw] = (nper, mode["EN"])
        if "RST" in mode:
            rcc_reset[per.capitalize()] = (nper, mode["RST"])

    env.substitutions.update({
        "rcc_enable": rcc_enable,
        "rcc_reset": rcc_reset,
    })
    env.template("rcc_impl.hpp.in")
