#pragma once

#include <cstdint>
#include <optional>
#include "../device.hpp"
#include <modm/platform/core/peripherals.hpp>
#include <modm/platform/gpio/connector.hpp>
#include <modm/architecture/interface/delay.hpp>

namespace modm::platform
{

/**
 * Reset and Clock Control for STM32F7 devices.
 *
 * This class abstracts access to clock settings on the STM32F7 family.
 * You need to use this class to enable internal and external clock
 * sources & outputs, set PLL parameters and AHB & APB prescalers.
 * Don't forget to set the flash latencies.
 *
 * @author	Niklas Hauser
 * @ingroup	modm_platform_rcc
 */
class Rcc
{
public:
	static constexpr uint32_t LsiFrequency = 32'000;
	static constexpr uint32_t HsiFrequency = 16'000'000;
	static constexpr uint32_t BootFrequency = HsiFrequency;
	static constexpr uint32_t MaxFrequency = {{ max_frequency | modm.digsep }};

	/// Connect GPIO signals like MCO to the clock tree
	template< class... Signals >
	static void
	connect()
	{
		using Connector = GpioConnector<Peripheral::Rcc, Signals...>;
		Connector::connect();
	}

	/// Enable the clock for a peripheral
	template< Peripheral peripheral >
	static void
	enable();

	/// Check if a peripheral clock is enabled
	template< Peripheral peripheral >
	static bool
	isEnabled();

	/// Disable the clock for a peripheral
	template< Peripheral peripheral >
	static void
	disable();


public:
	/** Set flash latency for CPU frequency and voltage.
	 * Does nothing if CPU frequency is too high for the available
	 * voltage.
	 *
	 * @returns maximum CPU frequency for voltage.
	 * @retval	<=CPU_Frequency flash latency has been set correctly.
	 * @retval	>CPU_Frequency requested frequency too high for voltage.
	 */
	template< uint32_t Core_Hz, uint16_t Core_mV = 3300>
	static uint32_t
	setFlashLatency();

	/// Update the SystemCoreClock and delay variables.
	template< uint32_t Core_Hz >
	static void
	updateCoreFrequency();


public:
	// clock sources
	static inline bool
	enableHsiClock(uint32_t waitLoops = 0x10000)
	{
		RCC->CR |= RCC_CR_HSION;
		while (not (RCC->CR & RCC_CR_HSIRDY) and --waitLoops) ;
		return waitLoops;
	}

	static inline bool
	enableHseClock(uint32_t waitLoops = 0x10000)
	{
		RCC->CR |= RCC_CR_HSEBYP | RCC_CR_HSEON;
		while (not (RCC->CR & RCC_CR_HSERDY) and --waitLoops) ;
		return waitLoops;
	}

	static inline bool
	enableHseCrystal(uint32_t waitLoops = 0x10000)
	{
		RCC->CR = (RCC->CR & ~RCC_CR_HSEBYP) | RCC_CR_HSEON;
		while (not (RCC->CR & RCC_CR_HSERDY) and --waitLoops) ;
		return waitLoops;
	}

	static inline bool
	enableLsiClock(uint32_t waitLoops = 0x10000)
	{
		RCC->CSR |= RCC_CSR_LSION;
		while (not (RCC->CSR & RCC_CSR_LSIRDY) and --waitLoops) ;
		return waitLoops;
	}

	static inline bool
	enableLseClock(uint32_t waitLoops = 0x10000)
	{
		RCC->BDCR |= RCC_BDCR_LSEBYP | RCC_BDCR_LSEON;
		while (not (RCC->BDCR & RCC_BDCR_LSERDY) and --waitLoops) ;
		return waitLoops;
	}

	static inline bool
	enableLseCrystal(uint32_t waitLoops = 0x10000)
	{
		RCC->BDCR = (RCC->BDCR & ~RCC_BDCR_LSEBYP) | RCC_BDCR_LSEON;
		while (not (RCC->BDCR & RCC_BDCR_LSERDY) and --waitLoops) ;
		return waitLoops;
	}

	// PLL configuration
	enum class
	PllSource : uint32_t
	{
		Hsi = 0,
		Hse = 1,
	};
	struct PllConfig
	{
		uint8_t M; ///< Allowed values are 2-63.
		uint16_t N; ///< Allowed values are 50-432.
		uint8_t P; ///< Allowed values are 2, 4, 6, 8.
		uint8_t Q; ///< Allowed values are 2-15.
%% set has_pllr = target.name >= "65"
%% if has_pllr
		uint8_t R = 7; ///< Allowed values are 2-7.
%% endif
	};
	/// VCO output must be in the range 100 MHz to 432 MHz,
	static inline bool
	enablePll(PllSource src, const PllConfig& cfg, uint32_t waitLoops = 0x10000)
	{
		RCC->PLLCFGR =
			(uint32_t(src) << RCC_PLLCFGR_PLLSRC_Pos) |
			((uint32_t(cfg.M) << RCC_PLLCFGR_PLLM_Pos) & RCC_PLLCFGR_PLLM) |
			((uint32_t(cfg.N) << RCC_PLLCFGR_PLLN_Pos) & RCC_PLLCFGR_PLLN) |
			((uint32_t(cfg.P / 2u - 1u) << RCC_PLLCFGR_PLLP_Pos) & RCC_PLLCFGR_PLLP) |
%% if has_pllr
			((uint32_t(cfg.R) << RCC_PLLCFGR_PLLR_Pos) & RCC_PLLCFGR_PLLR) |
%% endif
			((uint32_t(cfg.Q) << RCC_PLLCFGR_PLLQ_Pos) & RCC_PLLCFGR_PLLQ);

		RCC->CR |= RCC_CR_PLLON;
		while (not (RCC->CR & RCC_CR_PLLRDY) and --waitLoops) ;
		return waitLoops;
	}

	static inline bool
	disablePll(uint32_t waitLoops = 0x10000)
	{
		RCC->CR &= ~RCC_CR_PLLON;
		while ((RCC->CR & RCC_CR_PLLRDY) and --waitLoops) ;
		return waitLoops;
	}
%#
%% set has_pllxp = target.name >= "45"
	/// The PLLI2S uses the same input clock and M divider as the main PLL.
	struct PllI2sConfig
	{
		uint16_t N; ///< Allowed values are 50-432.
%% if has_pllxp
		uint8_t P = 8; ///< Allowed values are 2, 4, 6, 8.
%% endif
		uint8_t Q = 15; ///< Allowed values are 2-15.
		uint8_t R = 7; ///< Allowed values are 2-7.
	};
	static inline bool
	enablePllI2s(const PllI2sConfig& cfg, uint32_t waitLoops = 0x10000)
	{
		RCC->PLLI2SCFGR =
%% if has_pllxp
			((uint32_t(cfg.P / 2u - 1u) << RCC_PLLI2SCFGR_PLLI2SP_Pos) & RCC_PLLI2SCFGR_PLLI2SP) |
%% endif
			((uint32_t(cfg.N) << RCC_PLLI2SCFGR_PLLI2SN_Pos) & RCC_PLLI2SCFGR_PLLI2SN) |
			((uint32_t(cfg.Q) << RCC_PLLI2SCFGR_PLLI2SQ_Pos) & RCC_PLLI2SCFGR_PLLI2SQ) |
			((uint32_t(cfg.R) << RCC_PLLI2SCFGR_PLLI2SR_Pos) & RCC_PLLI2SCFGR_PLLI2SR);

		RCC->CR |= RCC_CR_PLLI2SON;
		while (not (RCC->CR & RCC_CR_PLLI2SRDY) and --waitLoops) ;
		return waitLoops;
	}
	static inline bool
	disablePllI2s(uint32_t waitLoops = 0x10000)
	{
		RCC->CR &= ~RCC_CR_PLLI2SON;
		while ((RCC->CR & RCC_CR_PLLI2SRDY) and --waitLoops) ;
		return waitLoops;
	}

	/// The PLLSAI uses the same input clock and M divider as the main PLL.
	struct PllSaiConfig
	{
		uint16_t N; ///< Allowed values are 50-432.
		uint8_t P = 8; ///< Allowed values are 2, 4, 6, 8.
		uint8_t Q = 15; ///< Allowed values are 2-15.
%% if has_pllxp
		uint8_t R = 7; ///< Allowed values are 2-7.
%% endif
	};
	static inline bool
	enablePllSai(const PllSaiConfig& cfg, uint32_t waitLoops = 0x10000)
	{
		RCC->PLLSAICFGR =
%% if has_pllxp
			((uint32_t(cfg.R) << RCC_PLLSAICFGR_PLLSAIR_Pos) & RCC_PLLSAICFGR_PLLSAIR) |
%% endif
			((uint32_t(cfg.N) << RCC_PLLSAICFGR_PLLSAIN_Pos) & RCC_PLLSAICFGR_PLLSAIN) |
			((uint32_t(cfg.P / 2u - 1u) << RCC_PLLSAICFGR_PLLSAIP_Pos) & RCC_PLLSAICFGR_PLLSAIP) |
			((uint32_t(cfg.Q) << RCC_PLLSAICFGR_PLLSAIQ_Pos) & RCC_PLLSAICFGR_PLLSAIQ);

		RCC->CR |= RCC_CR_PLLSAION;
		while (not (RCC->CR & RCC_CR_PLLSAIRDY) and --waitLoops) ;
		return waitLoops;
	}
	static inline bool
	disablePllSai(uint32_t waitLoops = 0x10000)
	{
		RCC->CR &= ~RCC_CR_PLLSAION;
		while ((RCC->CR & RCC_CR_PLLSAIRDY) and --waitLoops) ;
		return waitLoops;
	}

	enum class
	AhbPrescaler : uint8_t
	{
		Div1   = 0b0000,
		Div2   = 0b1000,
		Div4   = 0b1001,
		Div8   = 0b1010,
		Div16  = 0b1011,
		Div64  = 0b1100,
		Div128 = 0b1101,
		Div256 = 0b1110,
		Div512 = 0b1111,
	};
	static inline void
	setAhbPrescaler(AhbPrescaler prescaler)
	{
		RCC->CFGR = (RCC->CFGR & ~RCC_CFGR_HPRE) | (uint32_t(prescaler) << RCC_CFGR_HPRE_Pos);
	}

	enum class
	ApbPrescaler : uint8_t
	{
		Div1   = 0b000,
		Div2   = 0b100,
		Div4   = 0b101,
		Div8   = 0b110,
		Div16  = 0b111
	};
	static inline void
	setApb1Prescaler(ApbPrescaler prescaler)
	{
		RCC->CFGR = (RCC->CFGR & ~RCC_CFGR_PPRE1) | (uint32_t(prescaler) << RCC_CFGR_PPRE1_Pos);
	}
	static inline void
	setApb2Prescaler(ApbPrescaler prescaler)
	{
		RCC->CFGR = (RCC->CFGR & ~RCC_CFGR_PPRE2) | (uint32_t(prescaler) << RCC_CFGR_PPRE2_Pos);
	}

	// clock sinks
	enum class
	SystemClockSource : uint32_t
	{
		Hsi = 0b00,
		Hse = 0b01,
		PllP = 0b10,
	};
	static inline bool
	enableSystemClock(SystemClockSource src, uint32_t waitLoops = 0x10000)
	{
		RCC->CFGR = (RCC->CFGR & ~RCC_CFGR_SW) | uint32_t(src);
		while ((RCC->CFGR & RCC_CFGR_SWS) != (uint32_t(src) << RCC_CFGR_SWS_Pos) and --waitLoops) ;
		return waitLoops;
	}

	enum class
	RealTimeClockSource : uint32_t
	{
		Disabled = 0,
		Lse = 0b01 << RCC_BDCR_RTCSEL_Pos,
		Lsi = 0b10 << RCC_BDCR_RTCSEL_Pos,
		Hse = 0b11 << RCC_BDCR_RTCSEL_Pos,
	};
	static inline void
	setRealTimeClockSource(RealTimeClockSource src, uint8_t hseDivider = 2)
	{
		RCC->CFGR = (RCC->CFGR & ~RCC_CFGR_RTCPRE) | ((uint32_t(hseDivider) << RCC_CFGR_RTCPRE_Pos) & RCC_CFGR_RTCPRE);
		RCC->BDCR = (RCC->BDCR & ~RCC_BDCR_RTCSEL) | RCC_BDCR_RTCEN | uint32_t(src);
	}

	enum class
	AdcPrescaler : uint8_t
	{
		Div2 = 0b00,
		Div4 = 0b01,
		Div6 = 0b10,
		Div8 = 0b11,
	};
	static inline void
	setAdcPrescaler(AdcPrescaler prescaler)
	{
		ADC123_COMMON->CCR = (ADC123_COMMON->CCR & ~ADC_CCR_ADCPRE) | (uint32_t(prescaler) << ADC_CCR_ADCPRE_Pos);
	}

	enum class
	I2sClockSource
	{
		PllI2sR,
		External,
	};
	static inline void
	setI2sClockSource(I2sClockSource src)
	{
		if (src == I2sClockSource::External)
			RCC->CFGR |= RCC_CFGR_I2SSRC;
		else
			RCC->CFGR &= ~RCC_CFGR_I2SSRC;
	}

	// DCKCFGR1 peripheral muxes
	/// Allowed values are 1-32.
	static inline void
	setPllI2sDivQ(uint8_t divider)
	{
		RCC->DCKCFGR1 = (RCC->DCKCFGR1 & ~RCC_DCKCFGR1_PLLI2SDIVQ) |
			((uint32_t(divider - 1u) << RCC_DCKCFGR1_PLLI2SDIVQ_Pos) & RCC_DCKCFGR1_PLLI2SDIVQ);
	}

	/// Allowed values are 1-32.
	static inline void
	setPllSaiDivQ(uint8_t divider)
	{
		RCC->DCKCFGR1 = (RCC->DCKCFGR1 & ~RCC_DCKCFGR1_PLLSAIDIVQ) |
			((uint32_t(divider - 1u) << RCC_DCKCFGR1_PLLSAIDIVQ_Pos) & RCC_DCKCFGR1_PLLSAIDIVQ);
	}
%% if has_pllxp
%#
	enum class
	PllSaiRDivider : uint8_t
	{
		Div2  = 0b00,
		Div4  = 0b01,
		Div8  = 0b10,
		Div16 = 0b11,
	};
	static inline void
	setPllSaiDivR(PllSaiRDivider divider)
	{
		RCC->DCKCFGR1 = (RCC->DCKCFGR1 & ~RCC_DCKCFGR1_PLLSAIDIVR) | (uint32_t(divider) << RCC_DCKCFGR1_PLLSAIDIVR_Pos);
	}
%% endif
%#
	enum class
	SaiClockSource : uint8_t
	{
		PllSaiQ = 0b00,
		PllI2sQ = 0b01,
		External = 0b10,
%% if target.name >= "65"
		PllSource = 0b11,
%% endif
	};
	static inline void
	setSai1ClockSource(SaiClockSource src)
	{
		RCC->DCKCFGR1 = (RCC->DCKCFGR1 & ~RCC_DCKCFGR1_SAI1SEL) | (uint32_t(src) << RCC_DCKCFGR1_SAI1SEL_Pos);
	}
	static inline void
	setSai2ClockSource(SaiClockSource src)
	{
		RCC->DCKCFGR1 = (RCC->DCKCFGR1 & ~RCC_DCKCFGR1_SAI2SEL) | (uint32_t(src) << RCC_DCKCFGR1_SAI2SEL_Pos);
	}

	enum class
	TimerClockPrescaler : uint32_t
	{
		TwicePclk = 0u,
		HighSpeed = RCC_DCKCFGR1_TIMPRE,
	};
	static inline void
	setTimerClockPrescaler(TimerClockPrescaler prescaler)
	{
		RCC->DCKCFGR1 = (RCC->DCKCFGR1 & ~RCC_DCKCFGR1_TIMPRE) | uint32_t(prescaler);
	}
%% if target.name >= "65"
%#
	enum class
	Dfsdm1KernelClock : uint32_t
	{
		Apb2 = 0u,
		System = RCC_DCKCFGR1_DFSDM1SEL,
	};
	static inline void
	setDfsdm1KernelClock(Dfsdm1KernelClock src)
	{
		RCC->DCKCFGR1 = (RCC->DCKCFGR1 & ~RCC_DCKCFGR1_DFSDM1SEL) | uint32_t(src);
	}

	enum class
	Dfsdm1AudioClock : uint32_t
	{
		Sai1 = 0u,
		Sai2 = RCC_DCKCFGR1_ADFSDM1SEL,
	};
	static inline void
	setDfsdm1AudioClock(Dfsdm1AudioClock src)
	{
		RCC->DCKCFGR1 = (RCC->DCKCFGR1 & ~RCC_DCKCFGR1_ADFSDM1SEL) | uint32_t(src);
	}
%% endif
%#
	// DCKCFGR2 peripheral muxes
	enum class
	UartClockSource : uint8_t
	{
		Bus    = 0b00,
		SysClk = 0b01,
		Hsi    = 0b10,
		Lse    = 0b11,
	};
%% for id in uart_ids | sort
	%% set s = "s" if id in [1,2,3,6] else ""
	static inline void
	setU{{s}}art{{id}}ClockSource(UartClockSource src)
	{
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_U{{s|upper}}ART{{id}}SEL) |
						(uint32_t(src) << RCC_DCKCFGR2_U{{s|upper}}ART{{id}}SEL_Pos);
	}
%% endfor
%#
	enum class
	I2cClockSource : uint8_t
	{
		Bus    = 0b00,
		SysClk = 0b01,
		Hsi    = 0b10,
	};
%% for id in i2c_ids | sort
	static inline void
	setI2c{{id}}ClockSource(I2cClockSource src)
	{
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_I2C{{id}}SEL) | (uint32_t(src) << RCC_DCKCFGR2_I2C{{id}}SEL_Pos);
	}
%% endfor
%#
	enum class
	LptimClockSource : uint8_t
	{
		Bus = 0b00,
		Lsi = 0b01,
		Hsi = 0b10,
		Lse = 0b11,
	};
	static inline void
	setLptim1ClockSource(LptimClockSource src)
	{
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_LPTIM1SEL) | (uint32_t(src) << RCC_DCKCFGR2_LPTIM1SEL_Pos);
	}
%% if target.name >= "45"
%#
	enum class
	CecClockSource : uint32_t
	{
		Lse = 0u,
		HsiDiv488 = RCC_DCKCFGR2_CECSEL,
	};
	static inline void
	setCecClockSource(CecClockSource src)
	{
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_CECSEL) | uint32_t(src);
	}
%% endif
%#
	enum class
	Clk48Source : uint32_t
	{
		PllQ = 0u,
		PllSaiP = RCC_DCKCFGR2_CK48MSEL,
	};
	static inline void
	setClk48Source(Clk48Source src)
	{
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_CK48MSEL) | uint32_t(src);
	}

	enum class
	SdmmcClockSource : uint8_t
	{
		Clk48  = 0,
		SysClk = 1,
	};
	static inline void
	setSdmmc1ClockSource(SdmmcClockSource src)
	{
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_SDMMC1SEL) | (uint32_t(src) << RCC_DCKCFGR2_SDMMC1SEL_Pos);
	}
%% if target.name not in ["45", "46", "50", "56"]
	static inline void
	setSdmmc2ClockSource(SdmmcClockSource src)
	{
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_SDMMC2SEL) | (uint32_t(src) << RCC_DCKCFGR2_SDMMC2SEL_Pos);
	}
%% endif
%% if target.name in ["69", "79"]
%#
	enum class
	DsiClockSource : uint32_t
	{
		DsiPhy = 0u,
		PllR = RCC_DCKCFGR2_DSISEL,
	};
	static inline void
	setDsiClockSource(DsiClockSource src)
	{
		RCC->DCKCFGR2 = (RCC->DCKCFGR2 & ~RCC_DCKCFGR2_DSISEL) | uint32_t(src);
	}
%% endif
%#
	enum class
	McoPrescaler : uint32_t
	{
		Div1 = 0b000,
		Div2 = 0b100,
		Div3 = 0b101,
		Div4 = 0b110,
		Div5 = 0b111,
	};

	enum class
	Mco1ClockSource : uint32_t
	{
		Hsi = 0b00,
		Lse = 0b01,
		Hse = 0b10,
		Pll = 0b11,
	};
	static inline void
	setMco1ClockSource(Mco1ClockSource src, McoPrescaler prescaler = McoPrescaler::Div1)
	{
		RCC->CFGR = (RCC->CFGR & ~(RCC_CFGR_MCO1 | RCC_CFGR_MCO1PRE)) |
					(uint32_t(src) << RCC_CFGR_MCO1_Pos) | (uint32_t(prescaler) << RCC_CFGR_MCO1PRE_Pos);
	}

	enum class
	Mco2ClockSource : uint32_t
	{
		SysClk = 0b00,
		PllI2s = 0b01,
		Hse = 0b10,
		Pll = 0b11,
	};
	static inline void
	setMco2ClockSource(Mco2ClockSource src, McoPrescaler prescaler = McoPrescaler::Div1)
	{
		RCC->CFGR = (RCC->CFGR & ~(RCC_CFGR_MCO2 | RCC_CFGR_MCO2PRE)) |
					(uint32_t(src) << RCC_CFGR_MCO2_Pos) | (uint32_t(prescaler) << RCC_CFGR_MCO2PRE_Pos);
	}

	// TODO: move to Pwr module
	static inline bool
	enableOverdriveMode(uint32_t waitLoops = 2048)
	{
		PWR->CR1 |= PWR_CR1_ODEN;
		auto waitCounter = waitLoops;
		while (!(PWR->CSR1 & PWR_CSR1_ODRDY))
			if (--waitCounter == 0) return false;

		PWR->CR1 |= PWR_CR1_ODSWEN;
		while (!(PWR->CSR1 & PWR_CSR1_ODSWRDY))
			if (--waitLoops == 0) return false;

		return true;
	}

private:
	struct flash_latency
	{
		uint32_t latency;
		uint32_t max_frequency;
	};

	static constexpr flash_latency
	computeFlashLatency(uint32_t Core_Hz, uint16_t Core_mV);
};

} // namespace modm::platform

#include "rcc_impl.hpp"