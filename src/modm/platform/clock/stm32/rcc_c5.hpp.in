#pragma once

#include <cstdint>
#include "../device.hpp"
#include <modm/platform/core/peripherals.hpp>
#include <modm/platform/gpio/connector.hpp>
#include <modm/architecture/interface/delay.hpp>

namespace modm::platform
{

/**
 * Reset and Clock Control for STM32C5 devices.
 *
 * This class abstracts access to clock settings on the STM32.
 * You need to use this class to enable internal and external clock
 * sources & outputs, set PSI parameters and AHB & APB prescalers.
 * Don't forget to set the flash latencies.
 *
 * @author		Niklas Hauser
 * @ingroup		modm_platform_rcc
 */
class Rcc
{
public:
	static constexpr uint32_t LsiFrequency = 32'000;
	static constexpr uint32_t HsiFrequency = 144'000'000;
	static constexpr uint32_t BootFrequency = HsiFrequency / 3;
	static constexpr uint32_t MaxFrequency = {{ max_frequency | modm.digsep }};

	/// Connect GPIO signals like MCO to the clock tree
	template< class... Signals >
	static void
	connect()
	{
		using Connector = GpioConnector<Peripheral::Rcc, Signals...>;
		Connector::connect();
	}

	/// Enable the clock for a peripheral
	template< Peripheral peripheral >
	static void
	enable();

	/// Check if a peripheral clock is enabled
	template< Peripheral peripheral >
	static bool
	isEnabled();

	/// Disable the clock for a peripheral
	template< Peripheral peripheral >
	static void
	disable();


public:
	/** Set flash latency for CPU frequency and voltage.
	 * Does nothing if CPU frequency is too high for the available
	 * voltage.
	 *
	 * @returns maximum CPU frequency for voltage.
	 * @retval	<=CPU_Frequency flash latency has been set correctly.
	 * @retval	>CPU_Frequency requested frequency too high for voltage.
	 */
	template< uint32_t Core_Hz, uint16_t Core_mV = 3300>
	static uint32_t
	setFlashLatency();

	/// Update the SystemCoreClock and delay variables.
	template< uint32_t Core_Hz >
	static void
	updateCoreFrequency();


public:
	// clock sources
	/// HSIS: 144 MHz for the system clock
	static inline bool
	enableHsiClock(uint32_t waitLoops = 0x10000)
	{
		RCC->CR1 |= RCC_CR1_HSISON;
		while (not (RCC->CR1 & RCC_CR1_HSISRDY) and --waitLoops) ;
		return waitLoops;
	}

	/// HSIDIV3: 48 MHz, the reset system clock
	static inline bool
	enableHsiDiv3Clock(uint32_t waitLoops = 0x10000)
	{
		RCC->CR1 |= RCC_CR1_HSIDIV3ON;
		while (not (RCC->CR1 & RCC_CR1_HSIDIV3RDY) and --waitLoops) ;
		return waitLoops;
	}

	/// Divider for the HSIK and PSIK kernel clocks
	enum class
	KernelDivider : uint8_t
	{
		Div1   = 0b0001,
		Div1_5 = 0b0010,
		Div2   = 0b0011,
		Div2_5 = 0b0100,
		Div3   = 0b0101,
		Div3_5 = 0b0110,
		Div4   = 0b0111,
		Div4_5 = 0b1000,
		Div5   = 0b1001,
		Div5_5 = 0b1010,
		Div6   = 0b1011,
		Div6_5 = 0b1100,
		Div7   = 0b1101,
		Div7_5 = 0b1110,
		Div8   = 0b1111,
	};
	/// HSIK: HSI divided for peripheral kernel clocks
	static inline bool
	enableHsiKernelClock(KernelDivider divider, uint32_t waitLoops = 0x10000)
	{
		RCC->CR1 &= ~RCC_CR1_HSIKON;
		RCC->CR2 = (RCC->CR2 & ~RCC_CR2_HSIKDIV) | (uint32_t(divider) << RCC_CR2_HSIKDIV_Pos);
		RCC->CR1 |= RCC_CR1_HSIKON;
		while (not (RCC->CR1 & RCC_CR1_HSIKRDY) and --waitLoops) ;
		return waitLoops;
	}

	static inline bool
	enableHseClock(uint32_t waitLoops = 0x10000)
	{
		RCC->CR1 |= RCC_CR1_HSEBYP | RCC_CR1_HSEON;
		while (not (RCC->CR1 & RCC_CR1_HSERDY) and --waitLoops) ;
		return waitLoops;
	}

	static inline bool
	enableHseCrystal(uint32_t waitLoops = 0x10000)
	{
		RCC->CR1 = (RCC->CR1 & ~RCC_CR1_HSEBYP) | RCC_CR1_HSEON;
		while (not (RCC->CR1 & RCC_CR1_HSERDY) and --waitLoops) ;
		return waitLoops;
	}

	static inline bool
	enableLsiClock(uint32_t waitLoops = 0x10000)
	{
		RCC->RTCCR |= RCC_RTCCR_LSION;
		while (not (RCC->RTCCR & RCC_RTCCR_LSIRDY) and --waitLoops) ;
		return waitLoops;
	}

	static inline bool
	enableLseClock(uint32_t waitLoops = 0x10000)
	{
		RCC->RTCCR |= RCC_RTCCR_LSEBYP | RCC_RTCCR_LSEON;
		while (not (RCC->RTCCR & RCC_RTCCR_LSERDY) and --waitLoops) ;
		return waitLoops;
	}

	/// The low drive (LSEDRV = 00) is not offered: the LSE may not start or stop (ES0677 2.2.3),
	/// a PSI referenced to it never becomes ready.
	enum class
	LseDrive : uint8_t
	{
		MediumLow  = 0b01,
		MediumHigh = 0b10,
		High       = 0b11,
	};
	/// LSEDRV can only be written while the LSE is off
	static inline bool
	enableLseCrystal(LseDrive drive = LseDrive::MediumHigh, uint32_t waitLoops = 0x10000)
	{
		RCC->RTCCR = (RCC->RTCCR & ~(RCC_RTCCR_LSEDRV | RCC_RTCCR_LSEBYP)) |
					 (uint32_t(drive) << RCC_RTCCR_LSEDRV_Pos) | RCC_RTCCR_LSEON;
		while (not (RCC->RTCCR & RCC_RTCCR_LSERDY) and --waitLoops) ;
		return waitLoops;
	}

	// clock modifiers
	enum class
	PsiSource : uint8_t
	{
		Hse = 0b00,
		Lse = 0b01,
		HsiDiv18 = 0b10, ///< 8 MHz
	};
	/// Frequency of the PSI reference clock, RM0522 Table 66
	enum class
	PsiReference : uint8_t
	{
		Hz32768 = 0b000,
		MHz8    = 0b001,
		MHz16   = 0b010,
		MHz24   = 0b011,
		MHz25   = 0b100, ///< only for 100 MHz
		MHz32   = 0b101,
		MHz48   = 0b110,
		MHz50   = 0b111, ///< only for 100 MHz
	};
	enum class
	PsiFrequency : uint8_t
	{
		MHz100 = 0b00,
		MHz144 = 0b01,
		MHz160 = 0b10,
	};
	struct PsiConfig
	{
		PsiSource source;
		PsiReference reference;
		PsiFrequency frequency;
		/// PSIK kernel clock divider, disabled if not set
		KernelDivider kernelDivider = KernelDivider(0);
		/// Enable PSIDIV3 for USB
		bool div3 = false;
	};
	/// Configure and enable PSIS (and optionally PSIK and PSIDIV3)
	static inline bool
	enablePsi(const PsiConfig& cfg, uint32_t waitLoops = 0x10000)
	{
		RCC->CR2 = (RCC->CR2 & ~(RCC_CR2_PSIREFSRC | RCC_CR2_PSIREF | RCC_CR2_PSIFREQ | RCC_CR2_PSIKDIV)) |
				   (uint32_t(cfg.source) << RCC_CR2_PSIREFSRC_Pos) |
				   (uint32_t(cfg.reference) << RCC_CR2_PSIREF_Pos) |
				   (uint32_t(cfg.frequency) << RCC_CR2_PSIFREQ_Pos) |
				   (uint32_t(cfg.kernelDivider) << RCC_CR2_PSIKDIV_Pos);
		uint32_t on{RCC_CR1_PSISON}, rdy{RCC_CR1_PSISRDY};
		if (uint8_t(cfg.kernelDivider)) { on |= RCC_CR1_PSIKON; rdy |= RCC_CR1_PSIKRDY; }
		if (cfg.div3) { on |= RCC_CR1_PSIDIV3ON; rdy |= RCC_CR1_PSIDIV3RDY; }
		RCC->CR1 |= on;
		while ((RCC->CR1 & rdy) != rdy and --waitLoops) ;
		return waitLoops;
	}

	/// Disable all PSI outputs, fails if PSIS is the system clock.
	static inline bool
	disablePsi(uint32_t waitLoops = 0x10000)
	{
		constexpr uint32_t rdy{RCC_CR1_PSISRDY | RCC_CR1_PSIKRDY | RCC_CR1_PSIDIV3RDY};
		RCC->CR1 &= ~(RCC_CR1_PSISON | RCC_CR1_PSIKON | RCC_CR1_PSIDIV3ON);
		while ((RCC->CR1 & rdy) and --waitLoops) ;
		return waitLoops;
	}

	enum class
	AhbPrescaler : uint8_t
	{
		Div1   = 0b0000,
		Div2   = 0b1000,
		Div4   = 0b1001,
		Div8   = 0b1010,
		Div16  = 0b1011,
		Div64  = 0b1100,
		Div128 = 0b1101,
		Div256 = 0b1110,
		Div512 = 0b1111,
	};
	static inline void
	setAhbPrescaler(AhbPrescaler prescaler)
	{
		RCC->CFGR2 = (RCC->CFGR2 & ~RCC_CFGR2_HPRE) | (uint32_t(prescaler) << RCC_CFGR2_HPRE_Pos);
	}

	enum class
	ApbPrescaler : uint8_t
	{
		Div1   = 0b000,
		Div2   = 0b100,
		Div4   = 0b101,
		Div8   = 0b110,
		Div16  = 0b111
	};
%% for id in [1,2,3]
	static inline void
	setApb{{id}}Prescaler(ApbPrescaler prescaler)
	{
		RCC->CFGR2 = (RCC->CFGR2 & ~RCC_CFGR2_PPRE{{id}}) | (uint32_t(prescaler) << RCC_CFGR2_PPRE{{id}}_Pos);
	}
%% endfor
%#
	// clock sinks
	enum class
	SystemClockSource : uint32_t
	{
		HsiDiv3 = 0b00,
		Hsi = 0b01, ///< HSIS
		Hse = 0b10,
		Psi = 0b11, ///< PSIS
	};
	static inline bool
	enableSystemClock(SystemClockSource src, uint32_t waitLoops = 0x10000)
	{
		RCC->CFGR1 = (RCC->CFGR1 & ~RCC_CFGR1_SW) | uint32_t(src);
		while ((RCC->CFGR1 & RCC_CFGR1_SWS) != (uint32_t(src) << RCC_CFGR1_SWS_Pos) and --waitLoops) ;
		return waitLoops;
	}

	enum class
	RealTimeClockSource : uint32_t
	{
		Disabled = 0,
		Lse = 0b01 << RCC_RTCCR_RTCSEL_Pos,
		Lsi = 0b10 << RCC_RTCCR_RTCSEL_Pos,
		Hse = 0b11 << RCC_RTCCR_RTCSEL_Pos,
	};
	/// @param hseDiv Division factor for HSE to get ≤1MHz clock for RTC
	static inline void
	setRealTimeClockSource(RealTimeClockSource src, uint8_t hseDiv = 0xff)
	{
		RCC->CFGR1 = (RCC->CFGR1 & ~RCC_CFGR1_RTCPRE) | ((uint32_t(hseDiv) << RCC_CFGR1_RTCPRE_Pos) & RCC_CFGR1_RTCPRE);
		RCC->RTCCR = (RCC->RTCCR & ~RCC_RTCCR_RTCSEL) | RCC_RTCCR_RTCEN | uint32_t(src);
	}

	// CCIPR1
	enum class
	UartClockSource : uint8_t
	{
		Bus  = 0b00,
		Psik = 0b01,
		Hsik = 0b10,
		Lse  = 0b11,
	};
%% for id in uart_ids | sort
	%% set s = "s" if id in [1,2,3,6] else ""
	static inline void
	setU{{s}}art{{id}}ClockSource(UartClockSource src)
	{
		RCC->CCIPR1 = (RCC->CCIPR1 & ~RCC_CCIPR1_U{{s|upper}}ART{{id}}SEL) |
					  (uint32_t(src) << RCC_CCIPR1_U{{s|upper}}ART{{id}}SEL_Pos);
	}
%% endfor
%#
	enum class
	LpUartClockSource : uint8_t
	{
		Bus  = 0b00,
		Hsik = 0b01,
		Lse  = 0b10,
		Lsi  = 0b11,
	};
	static inline void
	setLpUart1ClockSource(LpUartClockSource src)
	{
		RCC->CCIPR1 = (RCC->CCIPR1 & ~RCC_CCIPR1_LPUART1SEL) | (uint32_t(src) << RCC_CCIPR1_LPUART1SEL_Pos);
	}

	enum class
	SpiClockSource : uint8_t
	{
		Bus      = 0b00,
		Psik     = 0b01,
		Hsik     = 0b10,
		AudioClk = 0b11,
	};
%% for id in spi_ids | sort
	static inline void
	setSpi{{id}}ClockSource(SpiClockSource src)
	{
		RCC->CCIPR1 = (RCC->CCIPR1 & ~RCC_CCIPR1_SPI{{id}}SEL) | (uint32_t(src) << RCC_CCIPR1_SPI{{id}}SEL_Pos);
	}
%% endfor
%#
%% if target.name not in ["31", "51", "91"]
	enum class
	CanClockSource : uint32_t
	{
		Bus  = 0b00,
		Psis = 0b01,
		Psik = 0b10,
		Hse  = 0b11,
	};
	static inline void
	setCanClockSource(CanClockSource src)
	{
		RCC->CCIPR1 = (RCC->CCIPR1 & ~RCC_CCIPR1_FDCANSEL) | (uint32_t(src) << RCC_CCIPR1_FDCANSEL_Pos);
	}
%% endif

	// CCIPR2
	enum class
	I2cClockSource : uint8_t
	{
		Bus  = 0b00,
		Psik = 0b01,
		Hsik = 0b10,
		Disabled = 0b11,
	};
%% for id in i2c_ids | sort
	static inline void
	setI2c{{id}}ClockSource(I2cClockSource src)
	{
		RCC->CCIPR2 = (RCC->CCIPR2 & ~RCC_CCIPR2_I2C{{id}}SEL) | (uint32_t(src) << RCC_CCIPR2_I2C{{id}}SEL_Pos);
	}
%% endfor
	using I3cClockSource = I2cClockSource;
	static inline void
	setI3c1ClockSource(I3cClockSource src)
	{
		RCC->CCIPR2 = (RCC->CCIPR2 & ~RCC_CCIPR2_I3C1SEL) | (uint32_t(src) << RCC_CCIPR2_I3C1SEL_Pos);
	}

	enum class
	AdcDacClockSource : uint32_t
	{
		Hclk = 0b00,
		Psis = 0b01,
		Psik = 0b10,
		Hsik = 0b11,
	};
	enum class
	AdcDacPrescaler : uint32_t
	{
		Div1   = 0b000,
		Div2   = 0b001,
		Div4   = 0b010,
		Div8   = 0b011,
		Div16  = 0b100,
		Div32  = 0b101,
		Div64  = 0b110,
		Div128 = 0b111,
	};
	static inline void
	setAdcDacClockSource(AdcDacClockSource src, AdcDacPrescaler prescaler = AdcDacPrescaler::Div1)
	{
		RCC->CCIPR2 = (RCC->CCIPR2 & ~(RCC_CCIPR2_ADCDACSEL | RCC_CCIPR2_ADCDACPRE)) |
					  (uint32_t(src) << RCC_CCIPR2_ADCDACSEL_Pos) | (uint32_t(prescaler) << RCC_CCIPR2_ADCDACPRE_Pos);
	}

	/// DAC sample and hold clock
	enum class
	DacClockSource : uint32_t
	{
		Lse = 0,
		Lsi = 1,
	};
	static inline void
	setDacClockSource(DacClockSource src)
	{
		RCC->CCIPR2 = (RCC->CCIPR2 & ~RCC_CCIPR2_DACSEL) | (uint32_t(src) << RCC_CCIPR2_DACSEL_Pos);
	}

	enum class
	LpTimerClockSource : uint8_t
	{
		Bus  = 0b00,
		Hsik = 0b01,
		Lse  = 0b10,
		Lsi  = 0b11,
	};
%% for id in lptim_ids | sort
	static inline void
	setLpTimer{{id}}ClockSource(LpTimerClockSource src)
	{
		RCC->CCIPR2 = (RCC->CCIPR2 & ~RCC_CCIPR2_LPTIM{{id}}SEL) | (uint32_t(src) << RCC_CCIPR2_LPTIM{{id}}SEL_Pos);
	}
%% endfor
%#
	/// 48 MHz clock for USB and RNG
	enum class
	Clock48Source : uint32_t
	{
		Disabled = 0b00, ///< default after reset
		PsiDiv3 = 0b01,
		HsiDiv3 = 0b10,
		Hse     = 0b11,
	};
	static inline void
	setClock48Source(Clock48Source src)
	{
		RCC->CCIPR2 = (RCC->CCIPR2 & ~RCC_CCIPR2_CK48SEL) | (uint32_t(src) << RCC_CCIPR2_CK48SEL_Pos);
	}

	enum class
	SysTickClockSource : uint32_t
	{
		HclkDiv8 = 0b00,
		Lsi      = 0b01,
		Lse      = 0b10,
		// 0b11 is documented as disabled, but counts HCLK/8 like HclkDiv8
	};
	/// HCLK must be at least four times faster than LSI/LSE
	static inline void
	setSysTickClockSource(SysTickClockSource src)
	{
		RCC->CCIPR2 = (RCC->CCIPR2 & ~RCC_CCIPR2_SYSTICKSEL) | (uint32_t(src) << RCC_CCIPR2_SYSTICKSEL_Pos);
	}

	// CCIPR3
%% if target.name >= "91"
	enum class
	OctospiClockSource : uint32_t
	{
		Hclk = 0b00,
		Psik = 0b01,
		Hsik = 0b10,
		Disabled = 0b11,
	};
	static inline void
	setXspi1ClockSource(OctospiClockSource src)
	{
		RCC->CCIPR3 = (RCC->CCIPR3 & ~RCC_CCIPR3_XSPI1SEL) | (uint32_t(src) << RCC_CCIPR3_XSPI1SEL_Pos);
	}
	/// Reference clock of the ETH1_CLK pad
	enum class
	EthClockSource : uint32_t
	{
		Disabled = 0b00,
		Psis = 0b01,
		Psik = 0b10,
		Hse  = 0b11,
	};
	enum class
	EthClockDivider : uint32_t
	{
		Div1 = 0b00,
		Div2 = 0b01,
		Div4 = 0b10,
	};
	static inline void
	setEthClockSource(EthClockSource src, EthClockDivider div = EthClockDivider::Div1)
	{
		RCC->CCIPR3 = (RCC->CCIPR3 & ~(RCC_CCIPR3_ETH1CLKSEL | RCC_CCIPR3_ETH1CLKDIV)) |
					  (uint32_t(src) << RCC_CCIPR3_ETH1CLKSEL_Pos) | (uint32_t(div) << RCC_CCIPR3_ETH1CLKDIV_Pos);
	}

	enum class
	EthPtpClockSource : uint32_t
	{
		Disabled = 0b00,
		Hclk = 0b01,
		Psis = 0b10,
		Psik = 0b11,
	};
	/// @param div 1-16
	static inline void
	setEthPtpClockSource(EthPtpClockSource src, uint8_t div = 1)
	{
		RCC->CCIPR3 = (RCC->CCIPR3 & ~(RCC_CCIPR3_ETH1PTPCLKSEL | RCC_CCIPR3_ETH1PTPDIV)) |
					  (uint32_t(src) << RCC_CCIPR3_ETH1PTPCLKSEL_Pos) |
					  ((uint32_t(div - 1u) << RCC_CCIPR3_ETH1PTPDIV_Pos) & RCC_CCIPR3_ETH1PTPDIV);
	}

	/// RMII reference clock, must be Pin in any other mode than RMII
	enum class
	EthRmiiReferenceClock : uint32_t
	{
		Pin = 0, ///< ETH1_RMII_REF_CLK
		Feedback = 1, ///< eth_clk_fb
	};
	static inline void
	setEthRmiiReferenceClock(EthRmiiReferenceClock src)
	{
		RCC->CCIPR3 = (RCC->CCIPR3 & ~RCC_CCIPR3_ETH1REFCLKSEL) | (uint32_t(src) << RCC_CCIPR3_ETH1REFCLKSEL_Pos);
	}
%% endif

	/// Low-speed clock output on the LSCO pin
	enum class
	LowSpeedClockOutput : uint32_t
	{
		Lsi = 0,
		Lse = 1,
	};
	static inline void
	enableLowSpeedClockOutput(LowSpeedClockOutput src)
	{
		RCC->RTCCR = (RCC->RTCCR & ~RCC_RTCCR_LSCOSEL) | (uint32_t(src) << RCC_RTCCR_LSCOSEL_Pos) | RCC_RTCCR_LSCOEN;
	}
	static inline void
	disableLowSpeedClockOutput()
	{
		RCC->RTCCR &= ~RCC_RTCCR_LSCOEN;
	}

public:
	// outputs
	enum class
	Mco1ClockSource : uint32_t
	{
		SystemClock = 0b000,
		Hse  = 0b001,
		Lse  = 0b010,
		Lsi  = 0b011,
		Psik = 0b100,
		Hsik = 0b101,
		Psis = 0b110,
		Hsis = 0b111,
	};
	enum class
	Mco2ClockSource : uint32_t
	{
		SystemClock = 0b000,
		Hse     = 0b001,
		Lse     = 0b010,
		Lsi     = 0b011,
		Psik    = 0b100,
		Hsik    = 0b101,
		PsiDiv3 = 0b110,
		HsiDiv3 = 0b111,
	};
%% for id in [1,2]
	static inline void
	setMco{{id}}ClockSource(Mco{{id}}ClockSource src, uint8_t div)
	{
		RCC->CFGR1 = (RCC->CFGR1 & ~(RCC_CFGR1_MCO{{id}}SEL | RCC_CFGR1_MCO{{id}}PRE)) |
					 (uint32_t(src) << RCC_CFGR1_MCO{{id}}SEL_Pos) |
					 ((uint32_t(div) << RCC_CFGR1_MCO{{id}}PRE_Pos) & RCC_CFGR1_MCO{{id}}PRE);
	}
%% endfor

private:
	struct flash_latency
	{
		uint32_t latency;
		uint32_t max_frequency;
	};
	static constexpr flash_latency
	computeFlashLatency(uint32_t Core_Hz, uint16_t Core_mV);
};

} // namespace modm::platform


#include "rcc_impl.hpp"
