def init(module):
	module.name = ":driver:iwr6843aop"
	module.description = """\
# TI IWR6843AOP mmWave Radar Driver

Control and data UART driver for TLV point cloud output.
"""

def prepare(module, options):
	module.depends(
		":architecture:gpio",
		":architecture:uart",
		":architecture:fiber",
		":processing:timer",
		":platform:gpio")
	return True

def build(env):
	env.outbasepath = "modm/src/modm/driver/radar"
	env.copy("iwr6843aop.hpp")
	env.copy("iwr6843aop_impl.hpp")
