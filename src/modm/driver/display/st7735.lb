def init(module):
    module.name = ":driver:st7735"
    module.description = "ST7735 full-color LCD controller"

def prepare(module, options):
    module.depends(
        ":architecture:fiber",
        ":ui:display")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/driver/display"
    env.copy("st7735.hpp")
    env.copy("st7735/st7735_driver.hpp")
    env.copy("st7735/st7735_driver_impl.hpp")
    env.copy("st7735/st7735_protocol.hpp")
    env.copy("st7735/st7735_spi_interface.hpp")
