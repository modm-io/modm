def init(module):
    module.name = ":driver:adxl345"
    module.description = """\
# ADXL345 3-Axis Digital Accelerometer

For further information on the special sensing functions, consult the
[datasheet](https://www.analog.com/media/en/technical-documentation/data-sheets/ADXL345.pdf).
"""

def prepare(module, options):
    module.depends(":architecture:i2c.device")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/driver/inertial"
    env.copy("adxl345.hpp")
    env.copy("adxl345_impl.hpp")
