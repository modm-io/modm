def init(module):
    module.name = ":driver:bmi270"
    module.description = """\
# BMI270 Inertial Measurement Unit

[Datasheet](https://www.bosch-sensortec.com/products/motion-sensors/imus/bmi270/)
"""


def prepare(module, options):
    module.depends(
        ":architecture:accessor",
        ":architecture:gpio",
        ":architecture:register",
        ":architecture:spi.device",
        ":architecture:i2c.device",
        ":architecture:fiber",
        ":driver:i2c.eeprom",
        ":math:geometry",
        ":processing:timer")
    return True


def build(env):
    env.outbasepath = "modm/src/modm/driver/inertial"
    env.copy("bmi270_transport.hpp")
    env.copy("bmi270_transport_impl.hpp")
    env.copy("bmi270.hpp")
    env.copy("bmi270_impl.hpp")
    env.copy("bmi270_calibration_impl.hpp")
    env.copy("bmi270.cpp")
