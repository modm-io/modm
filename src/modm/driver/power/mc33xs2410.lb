def init(module):
    module.name = ":driver:mc33xs2410"
    module.description = """\
# MC33XS2410 Power Switch

MC33XS2410 quad 100 mOhm / dual 50 mOhm, 3.0 V to 60 V high-side switch.

Four channel self-protected high-side switch with a 16-bit SPI interface for
output control and diagnostics, and an embedded 12-bit ADC for per-channel
current, voltage and temperature monitoring.

[Datasheet](https://www.nxp.com/docs/en/data-sheet/MC33XS2410.pdf)
"""


def prepare(module, options):
    module.depends(
        ":architecture:gpio",
        ":architecture:register",
        ":architecture:spi.device",
        ":architecture:fiber")
    return True


def build(env):
    env.outbasepath = "modm/src/modm/driver/power"
    env.copy("mc33xs2410.hpp")
    env.copy("mc33xs2410_impl.hpp")
