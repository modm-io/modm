def init(module):
    module.name = ":driver:pcal6524"
    module.description = """\
# PCAL6524 24-Bit I2C I/O Expander

Ultra low-voltage translating 24-bit Fm+ I2C-bus/SMBus I/O expander with
three 8-bit ports (P0, P1, P2), independently selectable pull-up or
pull-down resistors per pin, and a maskable interrupt output.
"""

def prepare(module, options):
    module.depends(
        ":architecture:gpio.expander",
        ":architecture:i2c.device",
        ":architecture:register")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/driver/gpio"
    env.copy("pcal6524.hpp")
