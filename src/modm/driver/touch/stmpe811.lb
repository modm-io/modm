def init(module):
    module.name = ":driver:stmpe811"
    module.description = """
# STMPE811 Resistive Touch Screen Controller

4-wire resistive touch screen controller with a 12-bit ADC and I2C interface.
The driver configures the touch screen controller and reads raw 12-bit X/Y
coordinates, which you need to calibrate to your screen.
"""

def prepare(module, options):
    module.depends(":architecture:fiber", ":architecture:i2c.device")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/driver/touch"
    env.copy("stmpe811.hpp")
