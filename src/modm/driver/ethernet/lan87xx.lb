def init(module):
    module.name = ":driver:lan87xx"
    module.description = "Common LAN87xx Ethernet PHY definitions and operations"

def prepare(module, options):
    module.depends(":architecture:ethernet", ":architecture:register", ":processing:fiber")
    return True

def build(env):
    env.outbasepath = "modm/src/modm/driver/ethernet"
    env.copy("lan87xx.hpp")
