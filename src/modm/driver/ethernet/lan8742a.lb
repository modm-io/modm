def init(module):
    module.name = ":driver:lan8742a"
    module.description = """\
# LAN8742A Ethernet Transceiver

Microchip's LAN8742A/LAN8742Ai are 10BASE-T/100BASE-TX transceivers connected
through RMII, with HP Auto-MDIX and cable diagnostics.
"""


def prepare(module, options):
    module.depends(":driver:ethernet.phy")
    return True


def build(env):
    env.outbasepath = "modm/src/modm/driver/ethernet"
    env.copy("lan8742a.hpp")
